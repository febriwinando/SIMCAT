---
import type { ExamPackage } from '../data/types';

interface Props {
  pkg: ExamPackage;
}

const { pkg } = Astro.props;

// Determine accent colors & neon glow based on category
let accentColor = '#00f2fe';
let gradientGlow = 'rgba(0, 242, 254, 0.28)';

if (pkg.category === 'PPPK') {
  accentColor = '#00f5a0';
  gradientGlow = 'rgba(0, 245, 160, 0.28)';
} else if (pkg.category === 'POLRI') {
  accentColor = '#ffb703';
  gradientGlow = 'rgba(255, 183, 3, 0.28)';
} else if (pkg.category === 'TNI') {
  accentColor = '#ff0055';
  gradientGlow = 'rgba(255, 0, 85, 0.28)';
}
---

<div class="package-card cyber-card glass-panel" style={`--category-accent: ${accentColor}; --accent-glow: ${gradientGlow};`}>
  <!-- Card Header -->
  <div class="card-header">
    <div class="header-badges">
      <span class={`badge ${pkg.badgeClass}`}>
        <span class="badge-dot"></span>
        {pkg.category}
      </span>
      <span class="edition-tag font-mono">[ {pkg.yearEdition} ]</span>
    </div>
    <div class="time-tag font-mono">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      {pkg.durationMinutes}m
    </div>
  </div>

  <div class="card-body">
    <h3 class="card-title">{pkg.title}</h3>
    <p class="card-desc">{pkg.description}</p>

    <div class="passing-grades-box">
      <div class="pg-header-row">
        <span class="pg-heading">Ketentuan Passing Grade:</span>
        <span class="pg-official-tag font-mono">RESMI BKN</span>
      </div>
      <div class="pg-list">
        {pkg.passingGrades.map((pg) => (
          <div class="pg-item">
            <span class="pg-code">{pg.code}</span>
            <span class="pg-score font-mono">Min. {pg.minScore}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="card-stats">
      <div class="stat-item">
        <span class="stat-num font-mono">{pkg.questions.length}</span>
        <span class="stat-lbl">Butir Soal</span>
      </div>
      <div class="stat-item">
        <span class="stat-num font-mono">{pkg.durationMinutes}m</span>
        <span class="stat-lbl">Durasi Waktu</span>
      </div>
      <div class="stat-item">
        <span class="stat-num font-mono">CAT</span>
        <span class="stat-lbl">Server Sync</span>
      </div>
    </div>
  </div>

  <div class="card-footer">
    <a href={`/simulasi/${pkg.slug}`} class="btn btn-primary btn-block btn-cyber-cta" id={`start-btn-${pkg.slug}`}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polygon points="5 3 19 12 5 21 5 3"></polygon>
      </svg>
      Mulai Simulasi CAT
    </a>
    <a href={`/pembahasan/${pkg.slug}`} class="btn btn-secondary btn-block" id={`study-btn-${pkg.slug}`}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
      </svg>
      Pelajari Kisi & Soal
    </a>
  </div>
</div>

<style>
  .package-card {
    display: flex;
    flex-direction: column;
    padding: 26px;
    position: relative;
    overflow: hidden;
    background: rgba(10, 15, 29, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.3s ease,
                box-shadow 0.3s ease;
  }

  .package-card::before {
    border-color: var(--category-accent);
  }
  .package-card::after {
    border-color: var(--category-accent);
  }

  .package-card:hover {
    transform: translateY(-8px);
    border-color: var(--category-accent);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.6), 0 0 30px var(--accent-glow);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .header-badges {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .edition-tag {
    font-size: 0.73rem;
    font-weight: 700;
    color: var(--text-dim);
    background: rgba(255, 255, 255, 0.04);
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .time-tag {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 700;
    color: #e2e8f0;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 4px 10px;
    border-radius: var(--radius-full);
  }

  .card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-title {
    font-size: 1.28rem;
    margin-bottom: 10px;
    color: #ffffff;
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .package-card:hover .card-title {
    color: var(--category-accent);
  }

  .card-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 20px;
    line-height: 1.55;
  }

  .passing-grades-box {
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    margin-bottom: 20px;
    transition: border-color 0.2s ease;
  }

  .package-card:hover .passing-grades-box {
    border-color: rgba(255, 255, 255, 0.15);
  }

  .pg-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .pg-heading {
    display: block;
    font-size: 0.72rem;
    text-transform: uppercase;
    font-weight: 700;
    color: #94a3b8;
    letter-spacing: 0.04em;
  }

  .pg-official-tag {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--category-accent);
    letter-spacing: 0.06em;
  }

  .pg-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pg-item {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 0.78rem;
    transition: all 0.2s ease;
  }

  .package-card:hover .pg-item {
    border-color: rgba(0, 242, 254, 0.2);
  }

  .pg-code {
    font-weight: 700;
    color: #ffffff;
  }

  .pg-score {
    color: #38bdf8;
    font-weight: 700;
  }

  .card-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-sm);
    padding: 12px;
    margin-bottom: 24px;
    text-align: center;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat-num {
    font-size: 1.15rem;
    font-weight: 800;
    color: #ffffff;
  }

  .stat-lbl {
    font-size: 0.68rem;
    color: var(--text-dim);
    text-transform: uppercase;
    font-weight: 600;
  }

  .card-footer {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .btn-block {
    width: 100%;
  }

  .btn-cyber-cta {
    position: relative;
    overflow: hidden;
  }
</style>
