---
---

<footer class="footer-wrapper">
  <!-- Glowing Laser Divider -->
  <div class="footer-laser-line" aria-hidden="true"></div>

  <div class="container footer-inner">
    <div class="footer-grid">
      <!-- Col 1: Brand & Disclaimer -->
      <div class="footer-col brand-col">
        <div class="brand-logo">
          <div class="logo-icon-wrap">
            <img src="/images/simcat-icon.png" alt="Logo SIMCAT" class="brand-logo-img" width="34" height="34" />
          </div>
          <span class="brand-title">SIM<span class="text-gradient">CAT</span></span>
        </div>
        <p class="footer-desc">
          SIMCAT — Platform simulasi Computer Assisted Test mandiri terstandarisasi untuk persiapan seleksi CPNS, PPPK, BUMN, dan Sekolah Kedinasan dengan algoritma penilaian resmi dan timer server-authoritative.
        </p>
        <div class="cpanel-badge">
          <span class="badge badge-cpns">Standar CAT BKN</span>
          <span class="badge badge-pppk">Passing Grade Resmi</span>
          <span class="badge badge-polri">Edisi 2026</span>
        </div>
        <div class="footer-disclaimer-text">
          <small>
            <em>Disclaimer:</em> SIMCAT adalah media pembelajaran independen non-pemerintah dan tidak terafiliasi dengan BKN, KemenPAN-RB, atau kementerian manapun.
          </small>
        </div>
      </div>

      <!-- Col 2: Simulasi & Paket -->
      <div class="footer-col">
        <h4 class="footer-heading"><span class="heading-bracket">[</span> Katalog Simulasi <span class="heading-bracket">]</span></h4>
        <ul class="footer-links">
          <li><a href="/simulasi/cpns-skd"><span class="link-arrow">›</span> Simulasi CPNS SKD (TWK, TIU, TKP)</a></li>
          <li><a href="/simulasi/pppk"><span class="link-arrow">›</span> Seleksi Kompetensi PPPK</a></li>
          <li><a href="/simulasi/bumn"><span class="link-arrow">›</span> Rekrutmen Bersama BUMN (TKD)</a></li>
          <li><a href="/simulasi/sekolah-kedinasan"><span class="link-arrow">›</span> SKD Kedinasan (IPDN/STAN)</a></li>
          <li><a href="/paket" class="highlight-link"><span class="link-arrow">›</span> Seluruh Paket Tryout &rarr;</a></li>
        </ul>
      </div>

      <!-- Col 3: Peserta & Panduan -->
      <div class="footer-col">
        <h4 class="footer-heading"><span class="heading-bracket">[</span> Peserta & Panduan <span class="heading-bracket">]</span></h4>
        <ul class="footer-links">
          <li><a href="/dashboard"><span class="link-arrow">›</span> Dashboard Peserta</a></li>
          <li><a href="/dashboard/riwayat"><span class="link-arrow">›</span> Riwayat Nilai & Scorecard</a></li>
          <li><a href="/dashboard/analisis"><span class="link-arrow">›</span> Analisis Peta Kelemahan</a></li>
          <li><a href="/panduan"><span class="link-arrow">›</span> Tata Tertib & Penilaian</a></li>
          <li><a href="/pusat-bantuan"><span class="link-arrow">›</span> Pusat Bantuan & FAQ</a></li>
        </ul>
      </div>

      <!-- Col 4: Lembaga & Legal -->
      <div class="footer-col">
        <h4 class="footer-heading"><span class="heading-bracket">[</span> Tentang & Legal <span class="heading-bracket">]</span></h4>
        <ul class="footer-links">
          <li><a href="/tentang"><span class="link-arrow">›</span> Tentang Platform SIMCAT</a></li>
          <li><a href="/dashboard/pembelian"><span class="link-arrow">›</span> Tryout Akbar & Paket Pro</a></li>
          <li><a href="/kebijakan-privasi"><span class="link-arrow">›</span> Kebijakan Privasi</a></li>
          <li><a href="/syarat-ketentuan"><span class="link-arrow">›</span> Syarat & Ketentuan Layanan</a></li>
          <li><a href="/login"><span class="link-arrow">›</span> Portal Masuk Akun</a></li>
        </ul>
      </div>
    </div>

    <!-- Telemetry System Specs Bar -->
    <div class="footer-specs-bar">
      <div class="spec-node">
        <span class="status-pulse-dot pulse-dot-green"></span>
        <span class="spec-label">CORE ENGINE:</span>
        <span class="spec-val">SIMCAT v3.2-CPANEL</span>
      </div>
      <div class="spec-node">
        <span class="spec-label">ENCRYPTION:</span>
        <span class="spec-val">AES-256-GCM</span>
      </div>
      <div class="spec-node">
        <span class="spec-label">TIME PROTOCOL:</span>
        <span class="spec-val">SERVER-AUTHORITATIVE</span>
      </div>
      <div class="spec-node">
        <span class="spec-label">CAT STANDARDS:</span>
        <span class="spec-val">BKN / MENPAN-RB 2026</span>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} SIMCAT Indonesia. Hak Cipta Dilindungi Undang-Undang.</p>
      <div class="footer-bottom-links">
        <a href="/kebijakan-privasi">Privasi</a>
        <span>•</span>
        <a href="/syarat-ketentuan">Ketentuan</a>
        <span>•</span>
        <a href="#top" class="back-top-text">Kembali ke Atas ↑</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-wrapper {
    margin-top: auto;
    background: #04060d;
    position: relative;
    padding: 70px 0 35px;
    color: var(--text-muted);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .footer-laser-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(0, 242, 254, 0.3) 25%,
      rgba(0, 242, 254, 0.8) 50%,
      rgba(168, 85, 247, 0.4) 75%,
      transparent
    );
    box-shadow: 0 0 12px rgba(0, 242, 254, 0.4);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1.1fr 1.1fr 1fr;
    gap: 36px;
    margin-bottom: 45px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .logo-icon-wrap {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(0, 242, 254, 0.08);
    border: 1px solid rgba(0, 242, 254, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 15px rgba(0, 194, 255, 0.25);
  }

  .brand-logo-img {
    width: 30px;
    height: 30px;
    object-fit: contain;
  }

  .brand-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    color: #ffffff;
  }

  .text-gradient {
    background: linear-gradient(135deg, #00f2fe 0%, #3b82f6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .footer-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: #94a3b8;
    margin-bottom: 18px;
  }

  .cpanel-badge {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .footer-disclaimer-text {
    font-size: 0.75rem;
    line-height: 1.5;
    color: #64748b;
  }

  .footer-heading {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 20px;
    letter-spacing: 0.02em;
  }

  .heading-bracket {
    font-family: var(--font-mono);
    color: #00f2fe;
    font-size: 0.9em;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .footer-links li a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.88rem;
    color: #94a3b8;
    transition: all 0.2s ease;
  }

  .link-arrow {
    color: #00f2fe;
    font-size: 1.1rem;
    line-height: 1;
    opacity: 0.6;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .footer-links li a:hover {
    color: #ffffff;
    transform: translateX(4px);
  }

  .footer-links li a:hover .link-arrow {
    opacity: 1;
    transform: translateX(2px);
    color: #00f2fe;
    filter: drop-shadow(0 0 6px #00f2fe);
  }

  .highlight-link {
    color: #38bdf8 !important;
    font-weight: 600;
  }

  /* Footer Specs Bar */
  .footer-specs-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 20px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-sm);
    margin-bottom: 25px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .spec-node {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .spec-label {
    color: #64748b;
  }

  .spec-val {
    color: #38bdf8;
    font-weight: 600;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 25px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.84rem;
    color: #64748b;
  }

  .footer-bottom-links {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer-bottom-links a {
    color: #94a3b8;
  }

  .footer-bottom-links a:hover {
    color: #00f2fe;
  }

  .back-top-text {
    color: #38bdf8 !important;
    font-weight: 600;
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .footer-specs-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 14px;
      text-align: center;
    }
  }
</style>
