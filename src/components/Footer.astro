<footer class="footer-wrapper">
  <div class="container footer-inner">
    <div class="footer-grid">
      <!-- Col 1: Brand & Disclaimer -->
      <div class="footer-col brand-col">
        <div class="brand-logo">
          <div class="logo-icon-wrap">
            <img src="/images/simcat-icon.png" alt="Logo SIMCAT" class="brand-logo-img" width="34" height="34" />
          </div>
          <span class="brand-title">SIM<span class="text-gradient">CAT</span></span>
        </div>
        <p class="footer-desc">
          SIMCAT — Platform simulasi Computer Assisted Test mandiri terstandarisasi untuk persiapan seleksi CPNS, PPPK, BUMN, dan Sekolah Kedinasan dengan algoritma penilaian resmi dan timer server.
        </p>
        <div class="cpanel-badge">
          <span class="badge badge-cpns">Standar CAT BKN</span>
          <span class="badge badge-pppk">Passing Grade Resmi</span>
          <span class="badge badge-polri">Edisi 2026</span>
        </div>
        <div class="footer-disclaimer-text">
          <small>
            <em>Disclaimer:</em> SIMCAT adalah media pembelajaran independen non-pemerintah dan tidak terafiliasi dengan BKN, KemenPAN-RB, atau kementerian manapun.
          </small>
        </div>
      </div>

      <!-- Col 2: Simulasi & Paket -->
      <div class="footer-col">
        <h4 class="footer-heading">Katalog Simulasi</h4>
        <ul class="footer-links">
          <li><a href="/simulasi/cpns-skd">Simulasi CPNS SKD (TWK, TIU, TKP)</a></li>
          <li><a href="/simulasi/pppk">Seleksi Kompetensi PPPK</a></li>
          <li><a href="/simulasi/bumn">Rekrutmen Bersama BUMN (TKD & AKHLAK)</a></li>
          <li><a href="/simulasi/sekolah-kedinasan">SKD Sekolah Kedinasan (IPDN/STAN)</a></li>
          <li><a href="/paket">Daftar Seluruh Paket Tryout &rarr;</a></li>
        </ul>
      </div>

      <!-- Col 3: Peserta & Panduan -->
      <div class="footer-col">
        <h4 class="footer-heading">Peserta & Panduan</h4>
        <ul class="footer-links">
          <li><a href="/dashboard">Dashboard Peserta</a></li>
          <li><a href="/dashboard/riwayat">Riwayat Nilai & Scorecard</a></li>
          <li><a href="/dashboard/analisis">Analisis Peta Kelemahan Subtes</a></li>
          <li><a href="/panduan">Tata Tertib & Sistem Penilaian</a></li>
          <li><a href="/pusat-bantuan">Pusat Bantuan & FAQ</a></li>
        </ul>
      </div>

      <!-- Col 4: Lembaga & Legal -->
      <div class="footer-col">
        <h4 class="footer-heading">Tentang & Legal</h4>
        <ul class="footer-links">
          <li><a href="/tentang">Tentang Platform SIMCAT</a></li>
          <li><a href="/dashboard/pembelian">Tryout Akbar & Paket Pro</a></li>
          <li><a href="/kebijakan-privasi">Kebijakan Privasi</a></li>
          <li><a href="/syarat-ketentuan">Syarat & Ketentuan Layanan</a></li>
          <li><a href="/login">Portal Masuk Peserta / Admin</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} SIMCAT Indonesia. Hak Cipta Dilindungi Undang-Undang.</p>
      <div class="footer-bottom-links">
        <a href="/kebijakan-privasi">Privasi</a>
        <span>•</span>
        <a href="/syarat-ketentuan">Ketentuan</a>
        <span>•</span>
        <a href="#top">Kembali ke Atas ↑</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-wrapper {
    margin-top: auto;
    background: #080c14;
    border-top: 1px solid var(--border-subtle);
    padding: 60px 0 30px;
    color: var(--text-muted);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1.1fr 1.1fr 1fr;
    gap: 32px;
    margin-bottom: 45px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .logo-icon-wrap {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(0, 194, 255, 0.2);
  }

  .brand-logo-img {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  .brand-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    color: #ffffff;
  }

  .text-gradient {
    background: linear-gradient(135deg, #00c2ff 0%, #2563eb 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .footer-desc {
    font-size: 0.88rem;
    line-height: 1.55;
    color: #94a3b8;
    margin-bottom: 16px;
  }

  .cpanel-badge {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 14px;
  }

  .footer-disclaimer-text {
    font-size: 0.75rem;
    color: #64748b;
    line-height: 1.45;
  }

  .footer-heading {
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 18px;
    letter-spacing: 0.03em;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links a {
    font-size: 0.85rem;
    color: #94a3b8;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .footer-links a:hover {
    color: #00c2ff;
    padding-left: 4px;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.82rem;
    color: #64748b;
  }

  .footer-bottom-links {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .footer-bottom-links a {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-bottom-links a:hover {
    color: #00c2ff;
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 12px;
      text-align: center;
    }
  }
</style>
