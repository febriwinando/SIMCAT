---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="navbar-wrapper">
  <div class="container navbar-inner">
    <a href="/" class="brand-logo" id="nav-brand-logo">
      <div class="logo-icon-wrap">
        <img src="/images/simcat-icon.png" alt="Logo SIMCAT" class="brand-logo-img" width="40" height="40" />
      </div>
      <div class="brand-text">
        <span class="brand-title">SIM<span class="text-gradient">CAT</span></span>
        <span class="brand-subtitle">CPNS • PPPK • BUMN • KEDINASAN</span>
      </div>
    </a>

    <nav class="nav-links">
      <a href="/" class={`nav-item ${currentPath === '/' ? 'active' : ''}`} id="nav-home">
        Beranda
      </a>
      <a href="/kategori" class={`nav-item ${currentPath.includes('/kategori') ? 'active' : ''}`} id="nav-kategori">
        Kategori
      </a>
      <a href="/paket" class={`nav-item ${currentPath.includes('/paket') ? 'active' : ''}`} id="nav-paket">
        Paket Ujian
      </a>
      <a href="/simulasi" class={`nav-item ${currentPath === '/simulasi' || currentPath.startsWith('/simulasi/') ? 'active' : ''}`} id="nav-simulasi">
        Simulasi CAT
      </a>
      <a href="/dashboard" class={`nav-item ${currentPath.includes('/dashboard') ? 'active' : ''}`} id="nav-dashboard">
        Dashboard
      </a>
      <a href="/panduan" class={`nav-item ${currentPath.includes('/panduan') ? 'active' : ''}`} id="nav-panduan">
        Panduan
      </a>
    </nav>

    <div class="nav-actions">
      <!-- Admin Backoffice Badge (Visible only to admin roles via JS) -->
      <a href="/admin" class="btn btn-warning nav-admin-btn" id="nav-btn-admin" style="display: none;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span>Backoffice</span>
      </a>

      <!-- Unauthenticated State -->
      <a href="/login" class="btn btn-secondary nav-login-btn" id="nav-btn-login">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
          <polyline points="10 17 15 12 10 7"></polyline>
          <line x1="15" y1="12" x2="3" y2="12"></line>
        </svg>
        <span>Masuk</span>
      </a>

      <!-- Authenticated State -->
      <div class="nav-user-profile" id="nav-user-profile" style="display: none;">
        <a href="/dashboard" class="nav-user-chip" id="nav-user-chip" title="Buka Dashboard Peserta">
          <span class="user-chip-avatar" id="nav-avatar">PS</span>
          <span class="user-chip-name" id="nav-user-name">Peserta</span>
        </a>
        <button class="nav-logout-btn" id="nav-btn-logout" title="Keluar / Ganti Akun">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
        </button>
      </div>

      <a href="/simulasi" class="btn btn-primary" id="btn-quick-tryout">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        Mulai CAT
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const AUTH_KEY = 'cat_user_session';
    const loginBtn = document.getElementById('nav-btn-login');
    const adminBtn = document.getElementById('nav-btn-admin');
    const userProfile = document.getElementById('nav-user-profile');
    const userNameEl = document.getElementById('nav-user-name');
    const userAvatarEl = document.getElementById('nav-avatar');
    const logoutBtn = document.getElementById('nav-btn-logout');

    function syncNavAuth() {
      try {
        const raw = localStorage.getItem(AUTH_KEY);
        if (raw) {
          const user = JSON.parse(raw);
          if (user && user.isLoggedIn) {
            if (loginBtn) loginBtn.style.display = 'none';
            if (userProfile) userProfile.style.display = 'flex';
            if (userNameEl) {
              const firstName = (user.name || 'Peserta').split(' ')[0];
              userNameEl.textContent = firstName;
            }
            if (userAvatarEl) {
              const initials = (user.name || 'PS').split(' ').map(w => w[0]).slice(0, 2).join('').toUpperCase();
              userAvatarEl.textContent = initials || 'PS';
            }

            // Check if user is staff/admin
            const staffRoles = ['superadmin', 'admin', 'reviewer', 'editor'];
            if (adminBtn && user.role && staffRoles.includes(user.role)) {
              adminBtn.style.display = 'inline-flex';
            } else if (adminBtn) {
              adminBtn.style.display = 'none';
            }
            return;
          }
        }
      } catch (e) {}

      // Default: logged out
      if (loginBtn) loginBtn.style.display = 'inline-flex';
      if (userProfile) userProfile.style.display = 'none';
      if (adminBtn) adminBtn.style.display = 'none';
    }

    if (logoutBtn) {
      logoutBtn.addEventListener('click', (e) => {
        e.preventDefault();
        if (confirm('Apakah Anda yakin ingin keluar dari sesi peserta ini?')) {
          localStorage.removeItem(AUTH_KEY);
          syncNavAuth();
          window.dispatchEvent(new Event('auth-state-changed'));
          window.location.reload();
        }
      });
    }

    window.addEventListener('auth-state-changed', syncNavAuth);
    document.addEventListener('DOMContentLoaded', syncNavAuth);
    syncNavAuth();
  })();
</script>

<style>
  .navbar-wrapper {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(11, 15, 25, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .logo-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(0, 194, 255, 0.2);
    transition: all 0.25s ease;
  }

  .brand-logo:hover .logo-icon-wrap {
    transform: translateY(-1px) scale(1.05);
    border-color: rgba(0, 194, 255, 0.4);
    box-shadow: 0 6px 20px rgba(0, 194, 255, 0.35);
  }

  .brand-logo-img {
    width: 38px;
    height: 38px;
    object-fit: contain;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    color: #ffffff;
    line-height: 1.05;
  }

  .text-gradient {
    background: linear-gradient(135deg, #00c2ff 0%, #2563eb 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .brand-subtitle {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #38bdf8;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-item {
    padding: 8px 13px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }

  .nav-item:hover {
    color: #ffffff;
    background: var(--bg-glass);
  }

  .nav-item.active {
    color: #ffffff;
    background: var(--bg-glass-active);
    border: 1px solid var(--border-subtle);
  }

  @media (max-width: 992px) {
    .nav-links {
      display: none;
    }
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav-admin-btn {
    font-size: 0.82rem;
    padding: 6px 12px;
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.4);
    color: #fbbf24;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    font-weight: 700;
  }

  .nav-admin-btn:hover {
    background: #f59e0b;
    color: #080c14;
  }

  .nav-login-btn {
    font-size: 0.88rem;
    padding: 8px 16px;
    border-radius: var(--radius-sm);
  }

  .nav-user-profile {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    padding: 3px 4px 3px 10px;
    transition: all 0.2s ease;
  }

  .nav-user-profile:hover {
    border-color: rgba(59, 130, 246, 0.4);
    background: rgba(59, 130, 246, 0.08);
  }

  .nav-user-chip {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #ffffff;
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .user-chip-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: linear-gradient(135deg, #00c2ff 0%, #0077ff 100%);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .user-chip-name {
    max-width: 90px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav-logout-btn {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.25);
    color: #f87171;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .nav-logout-btn:hover {
    background: rgba(239, 68, 68, 0.3);
    color: #ffffff;
    transform: scale(1.05);
  }
</style>
