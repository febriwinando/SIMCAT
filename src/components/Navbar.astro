---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="navbar-wrapper">
  <!-- Glowing Laser Edge Line at bottom of Navbar -->
  <div class="nav-laser-beam" aria-hidden="true"></div>

  <div class="container navbar-inner">
    <a href="/" class="brand-logo" id="nav-brand-logo" title="SIMCAT Portal 2026">
      <div class="logo-icon-wrap">
        <div class="logo-energy-ring"></div>
        <img src="/images/simcat-icon.png" alt="Logo SIMCAT" class="brand-logo-img" width="38" height="38" />
      </div>
      <div class="brand-text">
        <span class="brand-title">SIM<span class="text-gradient">CAT</span></span>
        <span class="brand-subtitle">CPNS • PPPK • BUMN • KEDINASAN</span>
      </div>
    </a>

    <!-- System Status HUD Badge -->
    <div class="nav-system-status">
      <span class="status-pulse-dot"></span>
      <span class="status-label">SYS: ONLINE</span>
    </div>

    <nav class="nav-links">
      <a href="/" class={`nav-item ${currentPath === '/' ? 'active' : ''}`} id="nav-home">
        <span class="nav-bracket">[</span>Beranda<span class="nav-bracket">]</span>
      </a>
      <a href="/kategori" class={`nav-item ${currentPath.includes('/kategori') ? 'active' : ''}`} id="nav-kategori">
        <span class="nav-bracket">[</span>Kategori<span class="nav-bracket">]</span>
      </a>
      <a href="/paket" class={`nav-item ${currentPath.includes('/paket') ? 'active' : ''}`} id="nav-paket">
        <span class="nav-bracket">[</span>Paket Ujian<span class="nav-bracket">]</span>
      </a>
      <a href="/simulasi" class={`nav-item ${currentPath === '/simulasi' || currentPath.startsWith('/simulasi/') ? 'active' : ''}`} id="nav-simulasi">
        <span class="nav-bracket">[</span>Simulasi CAT<span class="nav-bracket">]</span>
      </a>
      <a href="/dashboard" class={`nav-item ${currentPath.includes('/dashboard') ? 'active' : ''}`} id="nav-dashboard">
        <span class="nav-bracket">[</span>Dashboard<span class="nav-bracket">]</span>
      </a>
      <a href="/panduan" class={`nav-item ${currentPath.includes('/panduan') ? 'active' : ''}`} id="nav-panduan">
        <span class="nav-bracket">[</span>Panduan<span class="nav-bracket">]</span>
      </a>
    </nav>

    <div class="nav-actions">
      <!-- SFX Interactive Sound Toggle -->
      <button class="nav-sfx-toggle" id="nav-btn-sfx" title="Toggle Efek Suara Futuristik">
        <span class="sfx-icon" id="sfx-icon">🔊</span>
        <span class="sfx-text" id="sfx-text">SFX: ON</span>
      </button>

      <!-- Admin Backoffice Badge (Visible only to admin roles via JS) -->
      <a href="/admin" class="btn btn-warning nav-admin-btn" id="nav-btn-admin" style="display: none;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span>Backoffice</span>
      </a>

      <!-- Unauthenticated State -->
      <a href="/login" class="btn btn-secondary nav-login-btn" id="nav-btn-login">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
          <polyline points="10 17 15 12 10 7"></polyline>
          <line x1="15" y1="12" x2="3" y2="12"></line>
        </svg>
        <span>Masuk</span>
      </a>

      <!-- Authenticated State -->
      <div class="nav-user-profile" id="nav-user-profile" style="display: none;">
        <a href="/dashboard" class="nav-user-chip" id="nav-user-chip" title="Buka Dashboard Peserta">
          <span class="user-chip-avatar" id="nav-avatar">PS</span>
          <span class="user-chip-name" id="nav-user-name">Peserta</span>
        </a>
        <button class="nav-logout-btn" id="nav-btn-logout" title="Keluar / Ganti Akun">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
        </button>
      </div>

      <a href="/simulasi" class="btn btn-primary nav-cta-btn" id="btn-quick-tryout">
        <span class="cta-pulse-ring"></span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        Mulai CAT
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const AUTH_KEY = 'cat_user_session';
    const loginBtn = document.getElementById('nav-btn-login');
    const adminBtn = document.getElementById('nav-btn-admin');
    const userProfile = document.getElementById('nav-user-profile');
    const userNameEl = document.getElementById('nav-user-name');
    const userAvatarEl = document.getElementById('nav-avatar');
    const logoutBtn = document.getElementById('nav-btn-logout');
    const sfxBtn = document.getElementById('nav-btn-sfx');
    const sfxIcon = document.getElementById('sfx-icon');
    const sfxText = document.getElementById('sfx-text');

    // SFX Button sync
    function syncSFXBtn() {
      if (!sfxBtn) return;
      const enabled = typeof window.isSFXEnabled === 'function' ? window.isSFXEnabled() : true;
      if (sfxIcon) sfxIcon.textContent = enabled ? '🔊' : '🔇';
      if (sfxText) sfxText.textContent = enabled ? 'SFX: ON' : 'SFX: OFF';
      if (enabled) {
        sfxBtn.classList.remove('sfx-muted');
      } else {
        sfxBtn.classList.add('sfx-muted');
      }
    }

    if (sfxBtn) {
      sfxBtn.addEventListener('click', function () {
        if (typeof window.toggleCyberSFX === 'function') {
          window.toggleCyberSFX();
          syncSFXBtn();
        }
      });
      syncSFXBtn();
    }

    function syncNavAuth() {
      try {
        const raw = localStorage.getItem(AUTH_KEY);
        if (raw) {
          const user = JSON.parse(raw);
          if (user && user.isLoggedIn) {
            if (loginBtn) loginBtn.style.display = 'none';
            if (userProfile) userProfile.style.display = 'flex';
            if (userNameEl) {
              const firstName = (user.name || 'Peserta').split(' ')[0];
              userNameEl.textContent = firstName;
            }
            if (userAvatarEl) {
              const initials = (user.name || 'PS').split(' ').map(w => w[0]).slice(0, 2).join('').toUpperCase();
              userAvatarEl.textContent = initials || 'PS';
            }

            // Check if user is staff/admin
            const staffRoles = ['superadmin', 'admin', 'reviewer', 'editor'];
            if (adminBtn && user.role && staffRoles.includes(user.role)) {
              adminBtn.style.display = 'inline-flex';
            } else if (adminBtn) {
              adminBtn.style.display = 'none';
            }
            return;
          }
        }
      } catch (e) {}

      // Default: logged out
      if (loginBtn) loginBtn.style.display = 'inline-flex';
      if (userProfile) userProfile.style.display = 'none';
      if (adminBtn) adminBtn.style.display = 'none';
    }

    if (logoutBtn) {
      logoutBtn.addEventListener('click', (e) => {
        e.preventDefault();
        if (confirm('Apakah Anda yakin ingin keluar dari sesi peserta ini?')) {
          localStorage.removeItem(AUTH_KEY);
          syncNavAuth();
          window.dispatchEvent(new Event('auth-state-changed'));
          window.location.reload();
        }
      });
    }

    window.addEventListener('auth-state-changed', syncNavAuth);
    document.addEventListener('DOMContentLoaded', syncNavAuth);
    syncNavAuth();
  })();
</script>

<style>
  .navbar-wrapper {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(5, 8, 17, 0.82);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    transition: background 0.3s ease;
  }

  .nav-laser-beam {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 242, 254, 0.2) 20%,
      rgba(0, 242, 254, 0.8) 50%,
      rgba(168, 85, 247, 0.4) 80%,
      transparent 100%
    );
    box-shadow: 0 0 10px rgba(0, 242, 254, 0.4);
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 74px;
    gap: 16px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    position: relative;
  }

  .logo-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(0, 242, 254, 0.06);
    border: 1px solid rgba(0, 242, 254, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-shadow: 0 0 20px rgba(0, 194, 255, 0.2);
    transition: all 0.3s ease;
  }

  .logo-energy-ring {
    position: absolute;
    inset: -3px;
    border-radius: 14px;
    border: 1px dashed rgba(0, 242, 254, 0.4);
    pointer-events: none;
    animation: radarSweep 25s linear infinite;
  }

  .brand-logo:hover .logo-icon-wrap {
    transform: translateY(-2px) scale(1.05);
    border-color: rgba(0, 242, 254, 0.6);
    box-shadow: 0 0 25px rgba(0, 242, 254, 0.4);
  }

  .brand-logo-img {
    width: 34px;
    height: 34px;
    object-fit: contain;
    filter: drop-shadow(0 2px 8px rgba(0, 242, 254, 0.3));
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    color: #ffffff;
    line-height: 1.1;
  }

  .brand-subtitle {
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #38bdf8;
    font-family: var(--font-mono);
  }

  /* Telemetry Status in Navbar */
  .nav-system-status {
    display: flex;
    align-items: center;
    gap: 7px;
    background: rgba(0, 245, 160, 0.06);
    border: 1px solid rgba(0, 245, 160, 0.25);
    padding: 3px 10px;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: #00f5a0;
  }

  @media (max-width: 1100px) {
    .nav-system-status {
      display: none;
    }
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-item {
    padding: 7px 12px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    position: relative;
    transition: all 0.2s ease;
    font-family: var(--font-main);
  }

  .nav-bracket {
    font-family: var(--font-mono);
    color: transparent;
    transition: color 0.2s ease;
  }

  .nav-item:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.04);
  }

  .nav-item:hover .nav-bracket {
    color: #00f2fe;
  }

  .nav-item.active {
    color: #ffffff;
    background: rgba(0, 242, 254, 0.08);
    border: 1px solid rgba(0, 242, 254, 0.25);
    box-shadow: 0 0 15px rgba(0, 242, 254, 0.15);
  }

  .nav-item.active .nav-bracket {
    color: #00f2fe;
  }

  @media (max-width: 992px) {
    .nav-links {
      display: none;
    }
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* SFX Sound Toggle */
  .nav-sfx-toggle {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 10px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.72rem;
    font-family: var(--font-mono);
    font-weight: 700;
    color: #94a3b8;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .nav-sfx-toggle:hover {
    background: rgba(0, 242, 254, 0.1);
    border-color: rgba(0, 242, 254, 0.35);
    color: #00f2fe;
    box-shadow: 0 0 12px rgba(0, 242, 254, 0.2);
  }

  .nav-sfx-toggle.sfx-muted {
    opacity: 0.6;
    border-color: rgba(255, 255, 255, 0.06);
  }

  @media (max-width: 640px) {
    .nav-sfx-toggle .sfx-text {
      display: none;
    }
  }

  .nav-admin-btn {
    font-size: 0.8rem;
    padding: 6px 12px;
    background: rgba(255, 183, 3, 0.15);
    border: 1px solid rgba(255, 183, 3, 0.4);
    color: #ffb703;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .nav-admin-btn:hover {
    background: #ffb703;
    color: #060913;
    box-shadow: 0 0 15px rgba(255, 183, 3, 0.4);
  }

  .nav-login-btn {
    font-size: 0.85rem;
    padding: 7px 16px;
    border-radius: var(--radius-sm);
  }

  .nav-user-profile {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(0, 242, 254, 0.06);
    border: 1px solid rgba(0, 242, 254, 0.3);
    border-radius: var(--radius-full);
    padding: 3px 5px 3px 10px;
    box-shadow: 0 0 15px rgba(0, 242, 254, 0.15);
    transition: all 0.2s ease;
  }

  .nav-user-profile:hover {
    border-color: rgba(0, 242, 254, 0.6);
    box-shadow: 0 0 20px rgba(0, 242, 254, 0.3);
  }

  .nav-user-chip {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #ffffff;
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .user-chip-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: linear-gradient(135deg, #00f2fe 0%, #0072ff 100%);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 10px rgba(0, 242, 254, 0.4);
  }

  .user-chip-name {
    max-width: 90px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav-logout-btn {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255, 0, 85, 0.15);
    border: 1px solid rgba(255, 0, 85, 0.3);
    color: #ff4d79;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .nav-logout-btn:hover {
    background: rgba(255, 0, 85, 0.3);
    color: #ffffff;
    transform: scale(1.08);
    box-shadow: 0 0 12px rgba(255, 0, 85, 0.4);
  }

  .nav-cta-btn {
    font-size: 0.88rem;
    padding: 8px 18px;
    border-radius: var(--radius-sm);
    position: relative;
  }
</style>
