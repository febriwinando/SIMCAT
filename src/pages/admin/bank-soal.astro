---
import Layout from '../../layouts/Layout.astro';
import { queryAll } from '../../db';

const categories = queryAll(`SELECT id, name FROM exam_categories WHERE is_active = 1 ORDER BY sort_order ASC`);
const subjects = queryAll(`SELECT id, category_id, name, code FROM subjects ORDER BY category_id, name ASC`);

const questions = queryAll(`
  SELECT 
    q.id, q.uuid, q.category_id, q.subject_id,
    q.question_text, q.stimulus_text, q.difficulty,
    q.editorial_status, q.created_at,
    c.name as category_name, s.name as subject_name, s.code as subject_code,
    (SELECT COUNT(*) FROM question_options WHERE question_id = q.id) as option_count
  FROM questions q
  JOIN exam_categories c ON q.category_id = c.id
  JOIN subjects s ON q.subject_id = s.id
  ORDER BY q.id DESC
`);
---

<Layout title="Bank Soal Terstandarisasi - SIMCAT Admin">
  <div class="admin-page-wrapper">
    <div class="container">
      <!-- Breadcrumb -->
      <div class="admin-breadcrumb">
        <a href="/admin">Backoffice</a>
        <span>/</span>
        <span>Bank Soal</span>
      </div>

      <!-- Top Header -->
      <div class="admin-page-header">
        <div>
          <h1 class="page-title">Bank Butir Soal Ujian CAT</h1>
          <p class="page-subtitle">Pusat repositori butir soal dengan pembobotan adaptif dan metadata HOTS terverifikasi.</p>
        </div>
        <button class="btn btn-primary" onclick="openCreateModal()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Tambah Butir Soal
        </button>
      </div>

      <!-- Submenu Navigation -->
      <div class="admin-nav-bar">
        <a href="/admin" class="admin-nav-item">Ringkasan KPI</a>
        <a href="/admin/bank-soal" class="admin-nav-item active">Bank Soal ({questions.length})</a>
        <a href="/admin/review-soal" class="admin-nav-item">Review Editorial</a>
        <a href="/admin/paket-ujian" class="admin-nav-item">Paket Ujian & Rules</a>
        <a href="/admin/audit-log" class="admin-nav-item">Audit Log</a>
      </div>

      <!-- Filter Controls Bar -->
      <div class="filter-controls-bar glass-panel">
        <div class="filter-group">
          <label>Kategori Seleksi:</label>
          <select id="filter-category" class="filter-select" onchange="applyFilters()">
            <option value="all">Semua Rumpun Kategori</option>
            {categories.map((cat) => (
              <option value={cat.id}>{cat.name}</option>
            ))}
          </select>
        </div>

        <div class="filter-group">
          <label>Status Editorial:</label>
          <select id="filter-status" class="filter-select" onchange="applyFilters()">
            <option value="all">Semua Status</option>
            <option value="published">Terpublikasi (Published)</option>
            <option value="review_pending">Menunggu Review</option>
            <option value="revision_required">Perlu Revisi</option>
            <option value="draft">Draf (Draft)</option>
          </select>
        </div>

        <div class="filter-group search-group">
          <label>Cari Teks Soal / Stimulus:</label>
          <input
            type="text"
            id="filter-search"
            class="filter-input"
            placeholder="Ketik kata kunci..."
            oninput="applyFilters()"
          />
        </div>
      </div>

      <!-- Questions Table Container -->
      <div class="questions-table-card glass-panel">
        <div class="table-responsive">
          <table class="admin-table">
            <thead>
              <tr>
                <th style="width: 60px;">ID</th>
                <th style="width: 140px;">Rumpun & Subtes</th>
                <th>Stimulus & Teks Butir Soal</th>
                <th style="width: 90px; text-align: center;">Tingkat</th>
                <th style="width: 120px; text-align: center;">Opsi Jawaban</th>
                <th style="width: 140px;">Status</th>
                <th style="width: 110px; text-align: right;">Aksi</th>
              </tr>
            </thead>
            <tbody id="questions-tbody">
              {questions.map((q) => (
                <tr
                  class="q-row"
                  data-category={q.category_id}
                  data-subject={q.subject_id}
                  data-status={q.editorial_status}
                  data-search={`${q.question_text} ${q.stimulus_text || ''}`.toLowerCase()}
                >
                  <td class="font-mono text-dim">#{q.id}</td>
                  <td>
                    <div class="cell-subtest">
                      <span class="sub-badge">{q.subject_code}</span>
                      <span class="cat-label">{q.category_name}</span>
                    </div>
                  </td>
                  <td>
                    {q.stimulus_text && (
                      <div class="stimulus-preview">
                        <em>Stimulus:</em> {q.stimulus_text.length > 90 ? q.stimulus_text.substring(0, 90) + '...' : q.stimulus_text}
                      </div>
                    )}
                    <div class="question-text-preview">
                      {q.question_text.length > 130 ? q.question_text.substring(0, 130) + '...' : q.question_text}
                    </div>
                  </td>
                  <td style="text-align: center;">
                    <span class="diff-stars" title={`Tingkat Kesulitan: ${q.difficulty}/5`}>
                      {'★'.repeat(q.difficulty)}{'☆'.repeat(5 - q.difficulty)}
                    </span>
                  </td>
                  <td style="text-align: center;">
                    <span class="option-count-pill">{q.option_count} Opsi (A-E)</span>
                  </td>
                  <td>
                    <span class={`status-badge status-${q.editorial_status}`}>
                      {q.editorial_status === 'published' && '✓ Terpublikasi'}
                      {q.editorial_status === 'review_pending' && '⏳ Butuh Review'}
                      {q.editorial_status === 'revision_required' && '⚠️ Perlu Revisi'}
                      {q.editorial_status === 'draft' && '📝 Draf'}
                    </span>
                  </td>
                  <td style="text-align: right;">
                    <button
                      class="btn btn-secondary btn-xs"
                      data-qid={q.id}
                      onclick="viewQuestionDetail(this)"
                    >
                      Detail
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Create Question Modal -->
  <div class="modal-backdrop" id="create-modal" style="display: none;">
    <div class="modal-card-lg glass-panel">
      <div class="modal-header">
        <h3 class="modal-title">Tambah Butir Soal Baru ke Bank Soal</h3>
        <button class="modal-close-btn" onclick="closeCreateModal()">&times;</button>
      </div>

      <form id="create-question-form" onsubmit="handleCreateQuestion(event)">
        <div class="modal-body-scroll">
          <div class="form-row-2">
            <div class="form-group">
              <label class="form-label">Rumpun Kategori *</label>
              <select id="input-category" class="form-control" required onchange="updateSubjectOptions()">
                <option value="">Pilih Kategori...</option>
                {categories.map((c) => (
                  <option value={c.id}>{c.name}</option>
                ))}
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Subtes Materi *</label>
              <select id="input-subject" class="form-control" required>
                <option value="">Pilih Subtes...</option>
                {subjects.map((s) => (
                  <option value={s.id} data-category={s.category_id}>
                    [{s.code}] {s.name}
                  </option>
                ))}
              </select>
            </div>
          </div>

          <div class="form-row-2">
            <div class="form-group">
              <label class="form-label">Tingkat Kesulitan (1 Mudah - 5 Sangat Sulit/HOTS)</label>
              <select id="input-difficulty" class="form-control">
                <option value="1">1 - Sangat Mudah</option>
                <option value="2">2 - Mudah</option>
                <option value="3" selected>3 - Sedang</option>
                <option value="4">4 - Sulit (HOTS)</option>
                <option value="5">5 - Sangat Sulit (Kompleks)</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Status Editorial Awal</label>
              <select id="input-status" class="form-control">
                <option value="published" selected>Publikasikan Langsung (Published)</option>
                <option value="review_pending">Ajukan untuk Review (Review Pending)</option>
                <option value="draft">Simpan sebagai Draf</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Wacana / Stimulus Bacaan (Opsional)</label>
            <textarea
              id="input-stimulus"
              class="form-control"
              rows="3"
              placeholder="Ketik paragraf wacana, studi kasus, atau tabel rujukan jika ada..."
            ></textarea>
          </div>

          <div class="form-group">
            <label class="form-label">Teks Pertanyaan Butir Soal *</label>
            <textarea
              id="input-question-text"
              class="form-control"
              rows="3"
              placeholder="Ketik pertanyaan butir soal di sini..."
              required
            ></textarea>
          </div>

          <!-- Options Section -->
          <div class="options-creation-box">
            <div class="ocb-header">
              <label class="form-label" style="margin: 0;">Pilihan Opsi Jawaban (A - E)</label>
              <span class="ocb-hint">Untuk TKP, berikan bobot skala 1–5 pada tiap opsi. Untuk TWK/TIU, centang opsi benar (+5 poin).</span>
            </div>

            <div class="options-inputs-list">
              {['A', 'B', 'C', 'D', 'E'].map((optKey, idx) => (
                <div class="option-input-row">
                  <div class="opt-key-badge">{optKey}</div>
                  <input
                    type="text"
                    id={`opt-text-${optKey}`}
                    class="form-control"
                    placeholder={`Teks pilihan jawaban ${optKey}...`}
                    required={idx < 4}
                  />
                  <div class="opt-score-wrap">
                    <label class="opt-correct-check">
                      <input type="checkbox" id={`opt-correct-${optKey}`} onchange={`toggleCorrect('${optKey}')`} />
                      <span>Benar</span>
                    </label>
                    <input
                      type="number"
                      id={`opt-weight-${optKey}`}
                      class="form-control weight-input"
                      value={optKey === 'A' ? '5' : '0'}
                      min="0"
                      max="5"
                      step="1"
                      title="Bobot Nilai (0 - 5)"
                    />
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Explanation Section -->
          <div class="form-group" style="margin-top: 16px;">
            <label class="form-label">Kunci Pembahasan Lengkap *</label>
            <textarea
              id="input-explanation"
              class="form-control"
              rows="3"
              placeholder="Tuliskan analisis pembahasan konsep jawaban secara komprehensif..."
              required
            ></textarea>
          </div>

          <div class="form-row-2">
            <div class="form-group">
              <label class="form-label">Trik Cepat / Formula Khusus</label>
              <input
                type="text"
                id="input-quick-trick"
                class="form-control"
                placeholder="Contoh: Eliminasi nilai ekstrim terlebih dahulu..."
              />
            </div>
            <div class="form-group">
              <label class="form-label">Rujukan Sumber Resmi</label>
              <input
                type="text"
                id="input-reference"
                class="form-control"
                placeholder="Contoh: Pasal 27 ayat 3 UUD 1945 / Modul Resmi BKN"
              />
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="closeCreateModal()">Batal</button>
          <button type="submit" class="btn btn-primary" id="btn-submit-question">
            Simpan Butir Soal ke Database
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Detail Modal -->
  <div class="modal-backdrop" id="detail-modal" style="display: none;">
    <div class="modal-card-lg glass-panel">
      <div class="modal-header">
        <h3 class="modal-title" id="detail-modal-title">Rincian Butir Soal</h3>
        <button class="modal-close-btn" onclick="closeDetailModal()">&times;</button>
      </div>
      <div class="modal-body-scroll" id="detail-modal-body">
        <div class="loading-box">Memuat detail soal...</div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="closeDetailModal()">Tutup</button>
      </div>
    </div>
  </div>
</Layout>

