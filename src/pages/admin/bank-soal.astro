<script is:inline>
  function applyFilters() {
    const cat = document.getElementById('filter-category').value;
    const status = document.getElementById('filter-status').value;
    const search = document.getElementById('filter-search').value.toLowerCase().trim();

    const rows = document.querySelectorAll('.q-row');
    rows.forEach((row) => {
      const matchCat = cat === 'all' || row.getAttribute('data-category') === cat;
      const matchStatus = status === 'all' || row.getAttribute('data-status') === status;
      const matchSearch = !search || row.getAttribute('data-search').includes(search);

      if (matchCat && matchStatus && matchSearch) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

  function openCreateModal() {
    document.getElementById('create-modal').style.display = 'flex';
  }

  function closeCreateModal() {
    document.getElementById('create-modal').style.display = 'none';
  }

  function openDetailModal() {
    document.getElementById('detail-modal').style.display = 'flex';
  }

  function closeDetailModal() {
    document.getElementById('detail-modal').style.display = 'none';
  }

  function updateSubjectOptions() {
    const cat = document.getElementById('input-category').value;
    const subSelect = document.getElementById('input-subject');
    const options = subSelect.querySelectorAll('option');

    options.forEach((opt) => {
      if (!opt.value) return;
      if (!cat || opt.getAttribute('data-category') === cat) {
        opt.style.display = '';
      } else {
        opt.style.display = 'none';
      }
    });
  }

  function toggleCorrect(key) {
    const isChecked = document.getElementById(`opt-correct-${key}`).checked;
    const weightInput = document.getElementById(`opt-weight-${key}`);
    if (isChecked) {
      weightInput.value = '5';
    } else {
      weightInput.value = '0';
    }
  }

  async function handleCreateQuestion(e) {
    e.preventDefault();
    const btn = document.getElementById('btn-submit-question');
    btn.disabled = true;
    btn.textContent = 'Menyimpan ke Server...';

    const categoryId = document.getElementById('input-category').value;
    const subjectId = document.getElementById('input-subject').value;
    const difficulty = parseInt(document.getElementById('input-difficulty').value, 10);
    const editorialStatus = document.getElementById('input-status').value;
    const stimulusText = document.getElementById('input-stimulus').value.trim();
    const questionText = document.getElementById('input-question-text').value.trim();
    const explanationText = document.getElementById('input-explanation').value.trim();
    const quickTrick = document.getElementById('input-quick-trick').value.trim();
    const referenceSource = document.getElementById('input-reference').value.trim();

    const options = ['A', 'B', 'C', 'D', 'E'].map((k) => ({
      key: k,
      text: document.getElementById(`opt-text-${k}`).value.trim(),
      isCorrect: document.getElementById(`opt-correct-${k}`).checked,
      scoreWeight: parseFloat(document.getElementById(`opt-weight-${k}`).value || '0')
    })).filter((o) => o.text.length > 0);

    try {
      const res = await fetch('/api/admin/questions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          categoryId,
          subjectId,
          difficulty,
          editorialStatus,
          stimulusText,
          questionText,
          explanationText,
          quickTrick,
          referenceSource,
          options
        })
      });

      const data = await res.json();
      if (data.success) {
        alert('Butir soal berhasil ditambahkan ke bank soal!');
        window.location.reload();
      } else {
        alert('Gagal: ' + (data.error || 'Terjadi kesalahan sistem'));
        btn.disabled = false;
        btn.textContent = 'Simpan Butir Soal ke Database';
      }
    } catch (err) {
      alert('Terjadi kesalahan jaringan.');
      btn.disabled = false;
      btn.textContent = 'Simpan Butir Soal ke Database';
    }
  }

  async function viewQuestionDetail(btn) {
    const qid = btn.getAttribute('data-qid');
    openDetailModal();
    const body = document.getElementById('detail-modal-body');
    body.innerHTML = '<div style="padding: 20px; text-align: center; color: #94a3b8;">Memuat detail butir soal...</div>';

    try {
      const res = await fetch(`/api/admin/questions?id=${qid}`);
      const data = await res.json();
      if (data.success && data.question) {
        const q = data.question;
        body.innerHTML = `
          <div style="display: flex; gap: 8px; margin-bottom: 12px;">
            <span class="sub-badge">${q.subject_code}</span>
            <span class="cat-label">${q.category_name}</span>
            <span class="status-badge status-${q.editorial_status}">${q.editorial_status}</span>
          </div>

          ${q.stimulus_text ? `
            <div style="background: rgba(255,255,255,0.03); padding: 12px; border-radius: 8px; margin-bottom: 12px; font-size: 0.88rem; color: #cbd5e1; border-left: 3px solid #00c2ff;">
              <strong style="color: #00c2ff;">Stimulus:</strong><br/>
              ${q.stimulus_text}
            </div>
          ` : ''}

          <h3 style="color: #ffffff; font-size: 1.15rem; margin-bottom: 16px; line-height: 1.45;">
            ${q.question_text}
          </h3>

          <h4 style="color: #94a3b8; font-size: 0.85rem; text-transform: uppercase; margin-bottom: 10px;">
            Opsi Jawaban & Pembobotan:
          </h4>
          <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px;">
            ${(q.options || []).map(opt => `
              <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; border-radius: 8px; background: ${opt.is_correct ? 'rgba(16, 185, 129, 0.15)' : 'rgba(255, 255, 255, 0.03)'}; border: 1px solid ${opt.is_correct ? 'rgba(16, 185, 129, 0.4)' : 'rgba(255, 255, 255, 0.06)'};">
                <div style="display: flex; align-items: center; gap: 10px;">
                  <strong style="color: ${opt.is_correct ? '#34d399' : '#ffffff'};">${opt.option_key}.</strong>
                  <span style="color: #e2e8f0;">${opt.option_text}</span>
                </div>
                <div style="display: flex; align-items: center; gap: 10px;">
                  ${opt.is_correct ? '<span style="color: #34d399; font-size: 0.75rem; font-weight: 700;">✓ KUNCI</span>' : ''}
                  <span style="font-family: monospace; font-size: 0.85rem; color: #00c2ff; font-weight: 700;">Bobot: ${opt.score_weight}</span>
                </div>
              </div>
            `).join('')}
          </div>

          ${q.explanation ? `
            <div style="background: rgba(30, 41, 59, 0.5); padding: 16px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.06);">
              <h4 style="color: #00c2ff; margin: 0 0 8px; font-size: 0.95rem;">Pembahasan Terverifikasi:</h4>
              <p style="color: #cbd5e1; font-size: 0.9rem; line-height: 1.5; margin: 0 0 10px;">
                ${q.explanation.explanation_text}
              </p>
              ${q.explanation.quick_trick ? `<div style="font-size: 0.82rem; color: #fbbf24; margin-bottom: 6px;">⚡ Trik Cepat: ${q.explanation.quick_trick}</div>` : ''}
              ${q.explanation.reference_source ? `<div style="font-size: 0.78rem; color: #64748b;">📖 Rujukan: ${q.explanation.reference_source}</div>` : ''}
            </div>
          ` : ''}
        `;
      }
    } catch (e) {
      body.innerHTML = '<div style="color: #ef4444; padding: 20px;">Gagal memuat detail soal.</div>';
    }
  }
</script>
