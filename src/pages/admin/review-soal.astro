    flex-direction: column;
    gap: 12px;
  }

  .ric-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .ric-meta {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sub-badge {
    padding: 2px 6px;
    border-radius: 4px;
    background: #00c2ff;
    color: #080c14;
    font-size: 0.72rem;
    font-weight: 800;
    font-family: monospace;
  }

  .cat-label {
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .status-badge {
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .status-published { background: rgba(16, 185, 129, 0.2); color: #34d399; }
  .status-review_pending { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }
  .status-revision_required { background: rgba(239, 68, 68, 0.2); color: #f87171; }
