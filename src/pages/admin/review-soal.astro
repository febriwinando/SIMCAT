---
import Layout from '../../layouts/Layout.astro';
import { queryAll } from '../../db';

const pendingQuestions = queryAll(`
  SELECT 
    q.id, q.uuid, q.category_id, q.subject_id,
    q.question_text, q.stimulus_text, q.difficulty,
    q.editorial_status, q.created_at,
    c.name as category_name, s.name as subject_name, s.code as subject_code
  FROM questions q
  JOIN exam_categories c ON q.category_id = c.id
  JOIN subjects s ON q.subject_id = s.id
  WHERE q.editorial_status IN ('review_pending', 'draft', 'revision_required')
  ORDER BY q.id ASC
`);

const recentReviews = queryAll(`
  SELECT r.id, r.question_id, r.status, r.notes, r.created_at,
         u.email as reviewer_email, p.full_name as reviewer_name,
         q.question_text
  FROM question_reviews r
  JOIN questions q ON r.question_id = q.id
  JOIN users u ON r.reviewer_id = u.id
  LEFT JOIN user_profiles p ON u.id = p.user_id
  ORDER BY r.id DESC
  LIMIT 5
`);
---

<Layout title="Portal Review Editorial Soal - SIMCAT Admin">
  <div class="admin-page-wrapper">
    <div class="container">
      <!-- Breadcrumb -->
      <div class="admin-breadcrumb">
        <a href="/admin">Backoffice</a>
        <span>/</span>
        <span>Review Editorial Soal</span>
      </div>

      <div class="admin-page-header">
        <div>
          <h1 class="page-title">Portal Verifikasi & Review Editorial</h1>
          <p class="page-subtitle">Pemeriksaan kualitas mutu butir soal, akurasi kunci, pembobotan skor, dan keabsahan rujukan regulasi.</p>
        </div>
      </div>

      <!-- Submenu Navigation -->
      <div class="admin-nav-bar">
        <a href="/admin" class="admin-nav-item">Ringkasan KPI</a>
        <a href="/admin/bank-soal" class="admin-nav-item">Bank Soal</a>
        <a href="/admin/review-soal" class="admin-nav-item active">
          Review Editorial
          {pendingQuestions.length > 0 && <span class="badge-count">{pendingQuestions.length}</span>}
        </a>
        <a href="/admin/paket-ujian" class="admin-nav-item">Paket Ujian & Rules</a>
        <a href="/admin/audit-log" class="admin-nav-item">Audit Log</a>
      </div>

      <div class="review-layout-grid">
        <!-- Main: Review Queue -->
        <div class="review-queue-col">
          <div class="glass-panel content-box">
            <div class="box-header">
              <h2 class="box-title">Antrean Butir Soal Perlu Ditinjau ({pendingQuestions.length})</h2>
              <p class="box-desc">Soal yang diajukan oleh penyusun untuk divalidasi sebelum dipublikasikan ke peserta.</p>
            </div>

            {pendingQuestions.length > 0 ? (
              <div class="review-cards-list">
                {pendingQuestions.map((q) => (
                  <div class="review-item-card" id={`q-card-${q.id}`}>
                    <div class="ric-top">
                      <div class="ric-meta">
                        <span class="sub-badge">{q.subject_code}</span>
                        <span class="cat-label">{q.category_name}</span>
                        <span class={`status-badge status-${q.editorial_status}`}>{q.editorial_status}</span>
                      </div>
                      <span class="diff-stars">{'★'.repeat(q.difficulty)}{'☆'.repeat(5 - q.difficulty)}</span>
                    </div>

                    {q.stimulus_text && (
                      <div class="ric-stimulus">
                        <strong>Wacana / Kasus:</strong> {q.stimulus_text}
                      </div>
                    )}

                    <h3 class="ric-question-text">{q.question_text}</h3>

                    <!-- Review Actions Form -->
                    <div class="ric-review-form">
                      <input
                        type="text"
                        id={`notes-${q.id}`}
                        class="review-notes-input"
                        placeholder="Catatan review (alasan persetujuan / revisi)..."
                      />
                      <div class="review-btn-group">
                        <button
                          class="btn btn-secondary btn-sm"
                          data-qid={q.id}
                          onclick="viewQuestionDetail(this)"
                        >
                          Lihat Opsi & Kunci
                        </button>
                        <button
                          class="btn btn-danger btn-sm"
                          data-qid={q.id}
                          onclick="submitReviewAction(this, 'revision_required')"
                        >
                          Minta Revisi
                        </button>
                        <button
                          class="btn btn-primary btn-sm"
                          data-qid={q.id}
                          onclick="submitReviewAction(this, 'published')"
                        >
                          ✓ Setujui & Publish
                        </button>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div class="empty-state">
                <div class="empty-icon">🎉</div>
                <h3>Semua Soal Telah Selesai Ditinjau</h3>
                <p>Tidak ada butir soal dalam antrean review saat ini. Seluruh bank soal aktif telah terverifikasi.</p>
                <a href="/admin/bank-soal" class="btn btn-secondary" style="margin-top: 16px;">
                  Buka Bank Soal
                </a>
              </div>
            )}
          </div>
        </div>

        <!-- Side: Editorial Checklist & Recent Reviews -->
        <div class="review-side-col">
          <div class="glass-panel content-box">
            <h3 class="box-title">Pedoman Standardisasi Reviewer</h3>
            <ul class="checklist-list">
              <li>
                <span class="chk-box">✓</span>
                <div>
                  <strong>Objektivitas Opsi:</strong>
                  <p>Hindari opsi yang bermakna ganda atau tidak memiliki rujukan kunci yang sahih.</p>
                </div>
              </li>
              <li>
                <span class="chk-box">✓</span>
                <div>
                  <strong>Skala Pembobotan TKP:</strong>
                  <p>Pastikan setiap opsi A-E memiliki bobot berjenjang 1, 2, 3, 4, dan 5 tanpa angka kembar.</p>
                </div>
              </li>
              <li>
                <span class="chk-box">✓</span>
                <div>
                  <strong>Standar HOTS (Higher Order Thinking):</strong>
                  <p>Materi wacana harus menguji analisis dan sintesis situasi birokrasi nyata, bukan sekadar hafalan.</p>
                </div>
              </li>
              <li>
                <span class="chk-box">✓</span>
                <div>
                  <strong>Kualitas Trik Cepat & Pembahasan:</strong>
                  <p>Setiap butir wajib memuat rasionalisasi logis serta trik waktu untuk efisiensi pengerjaan ujian.</p>
                </div>
              </li>
            </ul>
          </div>

          <div class="glass-panel content-box" style="margin-top: 20px;">
            <h3 class="box-title">Riwayat Keputusan Reviewer</h3>
            <div class="recent-reviews-stream">
              {recentReviews.length > 0 ? (
                recentReviews.map((rev) => (
                  <div class="rr-item">
                    <div class="rr-top">
                      <span class={`status-badge status-${rev.status}`}>{rev.status}</span>
                      <span class="rr-date">
                        {new Date(rev.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short' })}
                      </span>
                    </div>
                    <p class="rr-soal">Soal #{rev.question_id}: {rev.question_text.substring(0, 60)}...</p>
                    <p class="rr-notes">"{rev.notes || 'Disetujui tanpa catatan khusus.'}"</p>
                    <span class="rr-reviewer">Oleh: {rev.reviewer_name || rev.reviewer_email}</span>
                  </div>
                ))
              ) : (
                <p class="text-dim">Belum ada keputusan review tercatat.</p>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Detail Modal -->
  <div class="modal-backdrop" id="detail-modal" style="display: none;">
    <div class="modal-card-lg glass-panel">
      <div class="modal-header">
        <h3 class="modal-title">Rincian Butir Soal untuk Review</h3>
        <button class="modal-close-btn" onclick="closeDetailModal()">&times;</button>
      </div>
      <div class="modal-body-scroll" id="detail-modal-body">
        <div class="loading-box">Memuat detail soal...</div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="closeDetailModal()">Tutup</button>
      </div>
    </div>
  </div>
</Layout>

<style>
