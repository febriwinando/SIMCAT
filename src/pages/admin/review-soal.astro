    border-radius: 99px;
  }

  .review-layout-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 24px;
  }

  .content-box {
    padding: 24px;
    border-radius: 16px;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .box-header {
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .box-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 4px;
  }

  .box-desc {
    font-size: 0.85rem;
    color: #94a3b8;
    margin: 0;
  }

  .review-cards-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .review-item-card {
    padding: 20px;
    border-radius: 14px;
    background: rgba(30, 41, 59, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.06);
