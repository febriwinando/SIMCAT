  }

  .ric-question-text {
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.45;
  }

  .ric-review-form {
    margin-top: 6px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .review-notes-input {
    width: 100%;
    padding: 9px 14px;
    border-radius: 8px;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #ffffff;
    font-size: 0.85rem;
    outline: none;
  }

  .review-notes-input:focus {
    border-color: #00c2ff;
  }

  .review-btn-group {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }

  .btn-sm {
    padding: 6px 12px;
    font-size: 0.82rem;
  }

  .btn-danger {
    background: rgba(239, 68, 68, 0.2);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #f87171;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
  }

  .btn-danger:hover {
    background: #ef4444;
    color: #ffffff;
  }

  /* Checklist */
  .checklist-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .checklist-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .chk-box {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: rgba(16, 185, 129, 0.2);
    color: #34d399;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    flex-shrink: 0;
  }

  .checklist-list strong {
    color: #ffffff;
    display: block;
    margin-bottom: 2px;
  }

  .checklist-list p {
    color: #94a3b8;
    margin: 0;
  }

  .recent-reviews-stream {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 14px;
  }

  .rr-item {
    padding: 10px 12px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .rr-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }

  .rr-date {
    font-size: 0.72rem;
    color: #64748b;
  }

  .rr-soal {
    color: #e2e8f0;
    font-size: 0.82rem;
    margin: 0 0 2px;
  }

  .rr-notes {
    color: #94a3b8;
    font-size: 0.78rem;
    font-style: italic;
    margin: 0 0 4px;
  }

  .rr-reviewer {
    font-size: 0.72rem;
    color: #00c2ff;
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
  }

  .empty-icon {
    font-size: 3.5rem;
    margin-bottom: 12px;
  }

  .empty-state h3 {
    color: #ffffff;
    margin-bottom: 6px;
  }

  .empty-state p {
    color: #94a3b8;
    font-size: 0.95rem;
  }

  /* Modals */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(8px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .modal-card-lg {
    width: 100%;
    max-width: 800px;
    max-height: 90vh;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
  }

  .modal-header {
    padding: 20px 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .modal-title {
    color: #ffffff;
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0;
  }

  .modal-close-btn {
    background: transparent;
    border: none;
    color: #94a3b8;
    font-size: 1.6rem;
    cursor: pointer;
  }

  .modal-body-scroll {
    padding: 24px;
    overflow-y: auto;
  }

  .modal-footer {
    padding: 16px 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 992px) {
    .review-layout-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  async function submitReviewAction(btn, status) {
    const qid = btn.getAttribute('data-qid');
    const notesInput = document.getElementById(`notes-${qid}`);
    const notes = notesInput ? notesInput.value.trim() : '';

    if (status === 'revision_required' && !notes) {
      alert('Wajib mengisi catatan perbaikan saat meminta revisi butir soal.');
      if (notesInput) notesInput.focus();
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Memproses...';

    try {
      const res = await fetch('/api/admin/review', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          questionId: parseInt(qid, 10),
          reviewerId: 3, // reviewer demo user ID
          status: status,
          notes: notes
        })
      });

      const data = await res.json();
      if (data.success) {
        alert(data.message || 'Status soal berhasil diperbarui.');
        const card = document.getElementById(`q-card-${qid}`);
        if (card) {
          card.style.opacity = '0.4';
          card.innerHTML = `<div style="padding: 16px; color: #34d399; font-weight: 700; text-align: center;">✓ Soal #${qid} telah berhasil ditinjau (${status})</div>`;
        }
      } else {
        alert('Gagal: ' + (data.error || 'Terjadi kesalahan'));
        btn.disabled = false;
      }
    } catch (err) {
      alert('Terjadi kesalahan koneksi.');
      btn.disabled = false;
    }
  }

  function openDetailModal() {
    document.getElementById('detail-modal').style.display = 'flex';
  }

  function closeDetailModal() {
    document.getElementById('detail-modal').style.display = 'none';
  }

  async function viewQuestionDetail(btn) {
    const qid = btn.getAttribute('data-qid');
    openDetailModal();
    const body = document.getElementById('detail-modal-body');
    body.innerHTML = '<div style="padding: 20px; text-align: center; color: #94a3b8;">Memuat detail butir soal...</div>';

    try {
      const res = await fetch(`/api/admin/questions?id=${qid}`);
      const data = await res.json();
      if (data.success && data.question) {
        const q = data.question;
        body.innerHTML = `
          <div style="display: flex; gap: 8px; margin-bottom: 12px;">
            <span class="sub-badge">${q.subject_code}</span>
            <span class="cat-label">${q.category_name}</span>
            <span class="status-badge status-${q.editorial_status}">${q.editorial_status}</span>
          </div>

          ${q.stimulus_text ? `
            <div style="background: rgba(255,255,255,0.03); padding: 12px; border-radius: 8px; margin-bottom: 12px; font-size: 0.88rem; color: #cbd5e1; border-left: 3px solid #00c2ff;">
              <strong style="color: #00c2ff;">Stimulus:</strong><br/>
              ${q.stimulus_text}
            </div>
          ` : ''}

          <h3 style="color: #ffffff; font-size: 1.15rem; margin-bottom: 16px; line-height: 1.45;">
            ${q.question_text}
          </h3>

          <h4 style="color: #94a3b8; font-size: 0.85rem; text-transform: uppercase; margin-bottom: 10px;">
            Opsi Jawaban & Pembobotan:
          </h4>
          <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px;">
            ${(q.options || []).map(opt => `
              <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; border-radius: 8px; background: ${opt.is_correct ? 'rgba(16, 185, 129, 0.15)' : 'rgba(255, 255, 255, 0.03)'}; border: 1px solid ${opt.is_correct ? 'rgba(16, 185, 129, 0.4)' : 'rgba(255, 255, 255, 0.06)'};">
                <div style="display: flex; align-items: center; gap: 10px;">
                  <strong style="color: ${opt.is_correct ? '#34d399' : '#ffffff'};">${opt.option_key}.</strong>
                  <span style="color: #e2e8f0;">${opt.option_text}</span>
                </div>
                <div style="display: flex; align-items: center; gap: 10px;">
                  ${opt.is_correct ? '<span style="color: #34d399; font-size: 0.75rem; font-weight: 700;">✓ KUNCI</span>' : ''}
                  <span style="font-family: monospace; font-size: 0.85rem; color: #00c2ff; font-weight: 700;">Bobot: ${opt.score_weight}</span>
                </div>
              </div>
            `).join('')}
          </div>

          ${q.explanation ? `
            <div style="background: rgba(30, 41, 59, 0.5); padding: 16px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.06);">
              <h4 style="color: #00c2ff; margin: 0 0 8px; font-size: 0.95rem;">Pembahasan Terverifikasi:</h4>
              <p style="color: #cbd5e1; font-size: 0.9rem; line-height: 1.5; margin: 0 0 10px;">
                ${q.explanation.explanation_text}
              </p>
              ${q.explanation.quick_trick ? `<div style="font-size: 0.82rem; color: #fbbf24; margin-bottom: 6px;">⚡ Trik Cepat: ${q.explanation.quick_trick}</div>` : ''}
              ${q.explanation.reference_source ? `<div style="font-size: 0.78rem; color: #64748b;">📖 Rujukan: ${q.explanation.reference_source}</div>` : ''}
            </div>
          ` : ''}
        `;
      }
    } catch (e) {
      body.innerHTML = '<div style="color: #ef4444; padding: 20px;">Gagal memuat detail soal.</div>';
    }
  }
</script>
