    border: 1px solid rgba(0, 242, 254, 0.35);
    color: #00f2fe;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .diag-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

