---
import Layout from '../../layouts/Layout.astro';
import { queryAll } from '../../db';

// Fetch all graded attempts
const attempts = queryAll(`
  SELECT r.category_scores, r.total_score, r.is_passed, r.accuracy_percent
  FROM exam_results r
  ORDER BY r.id DESC
`);

// Aggregate subtests performance
const subtestStats: Record<string, { name: string; totalScore: number; passingGrade: number; count: number; passCount: number; maxScore: number }> = {};

attempts.forEach((att) => {
  if (att.category_scores) {
    try {
      const breakdown = JSON.parse(att.category_scores);
      Object.keys(breakdown).forEach((code) => {
        const item = breakdown[code];
        if (!subtestStats[code]) {
          subtestStats[code] = {
            name: item.name || code,
            totalScore: 0,
            passingGrade: item.passingGrade || 0,
            count: 0,
            passCount: 0,
            maxScore: code === 'TKP' ? 225 : (code === 'TIU' ? 175 : 150)
          };
        }
        subtestStats[code].totalScore += item.score || 0;
        subtestStats[code].count += 1;
        if (item.isPassed) subtestStats[code].passCount += 1;
      });
    } catch (e) {}
  }
});

const subtestList = Object.keys(subtestStats).map((code) => {
  const s = subtestStats[code];
  const avg = s.count > 0 ? Math.round((s.totalScore / s.count) * 10) / 10 : 0;
  const passRate = s.count > 0 ? Math.round((s.passCount / s.count) * 100) : 0;
  const gapToPg = Math.round((avg - s.passingGrade) * 10) / 10;
  return {
    code,
    name: s.name,
    avgScore: avg,
    passingGrade: s.passingGrade,
    maxScore: s.maxScore,
    passRate,
    gapToPg,
    isSafe: gapToPg >= 0,
    progressPercent: Math.min(100, Math.round((avg / s.maxScore) * 100))
  };
});
---

<Layout title="Analisis Kelemahan & Evaluasi Subtes - SIMCAT 2026">
  <div class="dashboard-page-wrapper">
    <div class="container">
      <!-- Breadcrumb -->
      <div class="dash-breadcrumb">
        <a href="/dashboard">Dashboard</a>
        <span>/</span>
        <span>Analisis Kelemahan</span>
      </div>

      <div class="page-header-row">
        <div>
          <h1 class="page-title">Analisis Kelemahan & Peta Kesiapan</h1>
          <p class="page-subtitle">Evaluasi diagnostik kemampuan per materi ujian berdasarkan data riwayat simulasi Anda.</p>
        </div>
        <a href="/simulasi" class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          Drilling Soal
        </a>
      </div>

      <!-- Navigation Tabs -->
      <div class="dash-tabs-bar">
        <a href="/dashboard" class="dash-tab">Ringkasan Belajar</a>
        <a href="/dashboard/riwayat" class="dash-tab">Riwayat Ujian</a>
        <a href="/dashboard/analisis" class="dash-tab active">Analisis Kelemahan</a>
        <a href="/dashboard/pembelian" class="dash-tab">Paket Pro & Tryout Akbar</a>
      </div>

      <!-- Overview Cards -->
      <div class="analysis-grid">
        <!-- Subtests Diagnostics List -->
        <div class="main-analysis-col">
          <div class="glass-panel content-box">
            <div class="box-header">
              <h2 class="box-title">Diagnosa Pencapaian Passing Grade per Subtes</h2>
              <p class="box-desc">Perbandingan rata-rata nilai Anda terhadap ambang batas kelulusan resmi.</p>
            </div>

            {subtestList.length > 0 ? (
              <div class="subtests-diag-list">
                {subtestList.map((sub) => (
                  <div class="diag-card">
                    <div class="diag-header">
                      <div>
                        <div class="diag-title-row">
                          <span class="diag-code-pill">{sub.code}</span>
                          <h3 class="diag-name">{sub.name}</h3>
                        </div>
                        <span class="diag-target-text">
                          Passing Grade: <strong>{sub.passingGrade}</strong> (Maks. {sub.maxScore})
                        </span>
                      </div>

                      <div class="diag-score-badge">
                        <span class="diag-avg-label">Rata-rata Anda:</span>
                        <span class={`diag-avg-num ${sub.isSafe ? 'text-green' : 'text-amber'}`}>
                          {sub.avgScore}
                        </span>
                        <span class={`diag-status-pill ${sub.isSafe ? 'pill-safe' : 'pill-alert'}`}>
                          {sub.isSafe ? `+${sub.gapToPg} di atas PG` : `${sub.gapToPg} di bawah PG`}
                        </span>
                      </div>
                    </div>

                    <!-- Progress Bar -->
                    <div class="diag-bar-track">
                      <div
                        class={`diag-bar-fill ${sub.isSafe ? 'fill-green' : 'fill-amber'}`}
                        style={`width: ${sub.progressPercent}%;`}
                      ></div>
                      <div
                        class="pg-marker"
                        style={`left: ${Math.round((sub.passingGrade / sub.maxScore) * 100)}%;`}
                        title={`Ambang Batas PG: ${sub.passingGrade}`}
                      >
                        <span class="pg-marker-label">PG {sub.passingGrade}</span>
                      </div>
                    </div>

                    <!-- Recommendation Note -->
                    <div class="diag-recommendation">
                      <span class="recom-icon">💡</span>
                      <span class="recom-text">
                        {sub.code === 'TWK' && (
                          sub.isSafe 
                            ? 'TWK Anda sudah stabil. Pertahankan hafalan pasal UUD 1945 dan penalaran integrasi nasional.'
                            : 'Fokuskan drilling pada soal penalaran Bela Negara dan Implementasi Pancasila dalam situasi kerja nyata.'
                        )}
                        {sub.code === 'TIU' && (
                          sub.isSafe
                            ? 'Kemampuan logika dan numerik Anda sangat baik. Perbanyak latihan silogisme dan figural analitis.'
                            : 'Tingkatkan kecepatan berhitung cepat (deret angka & pecahan) serta eliminasi opsi silogisme bertingkat.'
                        )}
                        {sub.code === 'TKP' && (
                          sub.isSafe
                            ? 'Orientasi pelayanan dan jejaring kerja Anda prima. Pertahankan konsistensi jawaban skala 5.'
                            : 'Prioritaskan opsi yang menunjukkan inisiatif perbaikan pelayanan publik tanpa menyalahkan prosedur birokrasi.'
                        )}
                        {!['TWK', 'TIU', 'TKP'].includes(sub.code) && (
                          'Perbanyak simulasi soal HOTS pada materi ini untuk meningkatkan konsistensi skor di atas ambang batas.'
                        )}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div class="empty-state">
                <div class="empty-icon">📊</div>
                <h3>Belum Ada Data Simulasi</h3>
                <p>Kerjakan minimal 1 sesi simulasi CAT untuk mengaktifkan grafik peta diagnostik kelemahan Anda.</p>
                <a href="/simulasi" class="btn btn-primary" style="margin-top: 16px;">Mulai Ujian Sekarang</a>
              </div>
            )}
          </div>
        </div>

        <!-- Strategy & Priority Recommendations -->
        <div class="side-analysis-col">
          <div class="glass-panel content-box">
            <h3 class="box-title">Strategi Pembagian Waktu (100 Menit)</h3>
            <p class="box-desc">Alokasi waktu pengerjaan 110 butir soal SKD CPNS standar BKN:</p>

            <div class="time-strategy-list">
              <div class="ts-item">
                <div class="ts-header">
                  <span class="ts-title">1. TKP (45 Soal)</span>
                  <span class="ts-time">30 Menit</span>
                </div>
                <p class="ts-desc">Kerjakan pertama kali saat konsentrasi masih segar. Tidak ada minus, targetkan skala 5 pada tiap opsi.</p>
              </div>

              <div class="ts-item">
                <div class="ts-header">
                  <span class="ts-title">2. TWK (30 Soal)</span>
                  <span class="ts-time">25 Menit</span>
                </div>
                <p class="ts-desc">Soal berbasis wacana dan hafalan cepat. Lewati segera jika ragu dan tandai warna kuning.</p>
              </div>

              <div class="ts-item">
                <div class="ts-header">
                  <span class="ts-title">3. TIU (35 Soal)</span>
                  <span class="ts-time">35 Menit</span>
                </div>
                <p class="ts-desc">Dibutuhkan perhitungan akurat. Mulai dari analogi kata, silogisme, baru numerik bertingkat.</p>
              </div>

              <div class="ts-item">
                <div class="ts-header">
                  <span class="ts-title">4. Review Ragu-ragu</span>
                  <span class="ts-time">10 Menit</span>
                </div>
                <p class="ts-desc">Periksa kembali tombol kuning pada palet nomor soal sebelum menekan tombol Selesai Ujian.</p>
              </div>
            </div>
          </div>

          <div class="glass-panel content-box" style="margin-top: 20px;">
            <h3 class="box-title">Target Passing Grade Resmi 2026</h3>
            <div class="rule-badge-box">
              <span class="badge-source">KepmenPAN-RB No. 321 Tahun 2024</span>
              <ul class="rule-list">
                <li><strong>TWK:</strong> 65 Poin (Minimal 13 soal benar)</li>
                <li><strong>TIU:</strong> 80 Poin (Minimal 16 soal benar)</li>
                <li><strong>TKP:</strong> 166 Poin (Rata-rata 3.7 poin per soal)</li>
                <li><strong>Nilai Maksimal:</strong> 550 Poin</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
