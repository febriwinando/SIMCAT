    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #94a3b8;
    font-size: 0.82rem;
    font-weight: 700;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .dash-tab:hover {
    color: #ffffff;
    background: rgba(30, 41, 59, 0.85);
    border-color: rgba(0, 242, 254, 0.3);
  }

  .dash-tab.active {
