    padding: 40px 0 90px;
  }

  .dash-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: #64748b;
    margin-bottom: 16px;
  }

  .dash-breadcrumb a {
    color: #94a3b8;
  }

  .text-cyan { color: #00f2fe; }

  .page-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 28px;
    gap: 16px;
    flex-wrap: wrap;
  }

  .page-title {
    font-size: 2.3rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 6px;
  }

  .page-subtitle {
    font-size: 1rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* Dash Navigation Tabs */
  .dash-tabs-bar {
    display: flex;
    gap: 10px;
    margin-bottom: 30px;
