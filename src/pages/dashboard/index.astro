---
import Layout from '../../layouts/Layout.astro';
import { queryAll, queryOne } from '../../db';

// SSR: Fetch initial data from database
const recentAttempts = queryAll(`
  SELECT 
    a.uuid, a.started_at, a.finished_at, a.status,
    p.title as package_title, p.slug as package_slug, p.category_id,
    c.name as category_name,
    r.total_score, r.max_possible_score, r.is_passed,
    r.accuracy_percent, r.time_spent_seconds, r.graded_at
  FROM exam_attempts a
  JOIN exam_packages p ON a.package_id = p.id
  JOIN exam_categories c ON p.category_id = c.id
  LEFT JOIN exam_results r ON a.id = r.attempt_id
  WHERE a.status IN ('submitted', 'auto_submitted', 'graded')
  ORDER BY a.id DESC
  LIMIT 5
`);

const totalAttemptsCount = queryOne<{ count: number }>(`
  SELECT COUNT(*) as count FROM exam_attempts WHERE status IN ('submitted', 'auto_submitted', 'graded')
`)?.count || 0;

const passedAttemptsCount = queryOne<{ count: number }>(`
  SELECT COUNT(*) as count FROM exam_results WHERE is_passed = 1
`)?.count || 0;

const highestScore = queryOne<{ max_score: number }>(`
  SELECT MAX(total_score) as max_score FROM exam_results
`)?.max_score || 0;

const avgScore = queryOne<{ avg_score: number }>(`
  SELECT AVG(total_score) as avg_score FROM exam_results
`)?.avg_score || 0;

const passRate = totalAttemptsCount > 0 ? Math.round((passedAttemptsCount / totalAttemptsCount) * 100) : 0;
---

<Layout title="Dashboard Peserta - SIMCAT 2026">
  <div class="dashboard-page-wrapper">
    <div class="container">
      <!-- Dashboard Top Header / Profile Bar -->
      <div class="profile-header-card cyber-card glass-panel">
        <div class="profile-main">
          <div class="avatar-wrap">
            <div class="avatar-energy-ring"></div>
            <div class="avatar-box font-mono" id="user-avatar-badge">PS</div>
          </div>
          <div class="profile-info">
            <div class="profile-role-badge">
              <span class="status-pulse-dot pulse-dot-green"></span>
              <span id="user-role-label">Peserta Terdaftar</span>
              <span class="hud-verified font-mono">[ TERVERIFIKASI ]</span>
            </div>
            <h1 class="user-greeting" id="user-display-name">Peserta SIMCAT</h1>
            <div class="profile-meta font-mono">
              <span id="user-nik-label">NIK: 3201************0001</span>
              <span>•</span>
              <span id="user-target-label">Target: Seleksi Nasional CPNS 2026</span>
            </div>
          </div>
        </div>
        <div class="header-action-btns">
          <a href="/simulasi" class="btn btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            Mulai Ujian Baru
          </a>
        </div>
      </div>

      <!-- Dashboard Navigation Tabs -->
      <div class="dash-tabs-bar font-mono">
        <a href="/dashboard" class="dash-tab active">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          [ Ringkasan ]
        </a>
        <a href="/dashboard/riwayat" class="dash-tab">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="12 8 12 12 14 14"></polyline>
            <path d="M3.05 11a9 9 0 1 1 .5 4m-.5 5v-5h5"></path>
          </svg>
          [ Riwayat ({totalAttemptsCount}) ]
        </a>
        <a href="/dashboard/analisis" class="dash-tab">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="20" x2="18" y2="10"></line>
            <line x1="12" y1="20" x2="12" y2="4"></line>
            <line x1="6" y1="20" x2="6" y2="14"></line>
          </svg>
          [ Peta Kelemahan ]
        </a>
        <a href="/dashboard/pembelian" class="dash-tab">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          [ Tryout Akbar Pro ]
        </a>
      </div>

      <!-- KPI Stat Grid -->
      <div class="kpi-stats-grid">
        <div class="kpi-card cyber-card glass-panel" style="--kpi-neon: #00f2fe;">
          <div class="kpi-top">
            <span class="kpi-title font-mono">TOTAL SIMULASI</span>
            <span class="kpi-icon blue">📝</span>
          </div>
          <div class="kpi-value font-mono">{totalAttemptsCount}</div>
          <div class="kpi-sub">Sesi ujian terselesaikan</div>
        </div>

        <div class="kpi-card cyber-card glass-panel" style="--kpi-neon: #00f5a0;">
          <div class="kpi-top">
            <span class="kpi-title font-mono">KELULUSAN AMBANG BATAS</span>
            <span class="kpi-icon green">🎯</span>
          </div>
          <div class="kpi-value text-green font-mono">{passRate}%</div>
          <div class="kpi-sub">{passedAttemptsCount} dari {totalAttemptsCount} attempt lulus PG</div>
        </div>

        <div class="kpi-card cyber-card glass-panel" style="--kpi-neon: #ffb703;">
          <div class="kpi-top">
            <span class="kpi-title font-mono">SKOR TERTINGGI</span>
            <span class="kpi-icon amber">🏆</span>
          </div>
          <div class="kpi-value text-amber font-mono">{highestScore}</div>
          <div class="kpi-sub">Pencapaian simulasi terbaik</div>
        </div>

        <div class="kpi-card cyber-card glass-panel" style="--kpi-neon: #a855f7;">
          <div class="kpi-top">
            <span class="kpi-title font-mono">RATA-RATA NILAI</span>
            <span class="kpi-icon cyan">⚡</span>
          </div>
          <div class="kpi-value text-cyan font-mono">{Math.round(avgScore * 10) / 10}</div>
          <div class="kpi-sub">Dari seluruh modul tryout</div>
        </div>
      </div>

      <!-- Main Content Grid -->
      <div class="dashboard-grid">
        <!-- Left: Recent Attempts List -->
        <div class="dash-col main-col">
          <div class="content-box cyber-card glass-panel">
            <div class="box-header">
              <div>
                <h2 class="box-title">Riwayat Simulasi Terakhir</h2>
                <p class="box-desc">Daftar attempt simulasi CAT terstandarisasi yang telah Anda selesaikan.</p>
              </div>
              <a href="/dashboard/riwayat" class="btn btn-secondary btn-sm">Lihat Semua</a>
            </div>

            {recentAttempts.length > 0 ? (
              <div class="attempts-list">
                {recentAttempts.map((item) => (
                  <div class="attempt-card cyber-card">
                    <div class="attempt-info">
                      <div class="attempt-badges">
                        <span class={`badge font-mono ${item.is_passed === 1 ? 'badge-green' : 'badge-red'}`}>
                          {item.is_passed === 1 ? '✓ LULUS PG' : '✕ BELUM LULUS'}
                        </span>
                        <span class="badge-tag font-mono">[ {item.category_name} ]</span>
                      </div>
                      <h3 class="attempt-title">{item.package_title}</h3>
                      <div class="attempt-meta font-mono">
                        <span>📅 {new Date(item.graded_at || item.finished_at || item.started_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })}</span>
                        <span>•</span>
                        <span>⏱️ {Math.round((item.time_spent_seconds || 0) / 60)} menit</span>
                        <span>•</span>
                        <span>Akurasi: {Math.round(item.accuracy_percent || 0)}%</span>
                      </div>
                    </div>

                    <div class="attempt-right">
                      <div class="score-pill">
                        <span class="score-num font-mono">{item.total_score}</span>
                        <span class="score-max font-mono">/{item.max_possible_score || 550}</span>
                      </div>
                      <div class="action-buttons">
                        <a href={`/dashboard/hasil/${item.uuid}`} class="btn btn-secondary btn-sm">
                          Scorecard
                        </a>
                        <a href={`/pembahasan/${item.package_slug}`} class="btn btn-primary btn-sm">
                          Pembahasan
                        </a>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div class="empty-state">
                <div class="empty-icon">📝</div>
                <h3>Belum Ada Riwayat Ujian</h3>
                <p>Mulai tryout pertama Anda untuk melihat performa nilai dan peta evaluasi kelulusan.</p>
                <a href="/simulasi" class="btn btn-primary" style="margin-top: 16px;">
                  Mulai Ujian Sekarang
                </a>
              </div>
            )}
          </div>
        </div>

        <!-- Right: Target Passing Grade Card -->
        <div class="dash-col side-col">
          <div class="content-box cyber-card glass-panel">
            <h2 class="box-title font-mono">[ AMBANG BATAS SKD 2026 ]</h2>
            <p class="box-desc">Target minimal nilai kelulusan resmi KepmenPAN-RB 321/2024.</p>

            <div class="pg-target-list">
              <div class="pg-item">
                <div class="pg-item-header">
                  <span>TWK (Wawasan Kebangsaan)</span>
                  <span class="font-mono text-cyan">Min. 65 / 150</span>
                </div>
                <div class="progress-track"><div class="progress-bar blue" style="width: 43%;"></div></div>
                <span class="pg-status-note font-mono text-dim">Min. 13 jawaban benar dari 30 butir</span>
              </div>

              <div class="pg-item">
                <div class="pg-item-header">
                  <span>TIU (Inteligensi Umum)</span>
                  <span class="font-mono text-cyan">Min. 80 / 175</span>
                </div>
                <div class="progress-track"><div class="progress-bar green" style="width: 46%;"></div></div>
                <span class="pg-status-note font-mono text-dim">Min. 16 jawaban benar dari 35 butir</span>
              </div>

              <div class="pg-item">
                <div class="pg-item-header">
                  <span>TKP (Karakteristik Pribadi)</span>
                  <span class="font-mono text-cyan">Min. 166 / 225</span>
                </div>
                <div class="progress-track"><div class="progress-bar amber" style="width: 74%;"></div></div>
                <span class="pg-status-note font-mono text-dim">Rata-rata 3.7 poin per butir</span>
              </div>
            </div>

            <div class="total-pg-box cyber-card font-mono">
              <span class="tpg-label">TOTAL AMBANG BATAS:</span>
              <span class="tpg-val text-green">311 / 550</span>
            </div>

            <div class="banner-cta-box cyber-card glass-panel" style="margin-top: 24px; padding: 20px; text-align: center;">
              <span class="cta-pill font-mono">PROGRAM AKBAR</span>
              <h3>Tryout Akbar Nasional</h3>
              <p>Uji kompetensi Anda melawan ribuan calon peserta di seluruh Indonesia dengan live ranking.</p>
              <a href="/dashboard/pembelian" class="btn btn-primary btn-block" style="margin-top: 14px;">
                Daftar Tryout Akbar
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
