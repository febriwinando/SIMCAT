    font-weight: 700;
    color: #ffffff;
    margin: 0 0 6px;
  }

  .attempt-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: #64748b;
  }

  .attempt-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }

  .score-pill {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .score-num {
    font-size: 1.6rem;
    font-weight: 800;
    font-family: monospace;
    color: #ffffff;
  }

  .score-max {
    font-size: 0.85rem;
    color: #64748b;
  }

  .action-buttons {
    display: flex;
    gap: 8px;
  }

  .btn-sm {
    padding: 6px 12px;
    font-size: 0.82rem;
  }

  .empty-state {
    text-align: center;
    padding: 40px 20px;
  }

  .empty-icon {
    font-size: 3rem;
    margin-bottom: 12px;
  }

  .empty-state h3 {
    color: #ffffff;
    margin-bottom: 6px;
  }

  .empty-state p {
    color: #94a3b8;
    font-size: 0.9rem;
    max-width: 400px;
    margin: 0 auto;
  }

  /* Right column */
  .pg-target-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 18px 0;
  }

  .pg-item-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    font-weight: 600;
    color: #e2e8f0;
    margin-bottom: 6px;
  }

  .progress-track {
    width: 100%;
    height: 8px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 99px;
    overflow: hidden;
    margin-bottom: 4px;
  }

  .progress-bar {
    height: 100%;
    border-radius: 99px;
  }

  .progress-bar.blue { background: #00c2ff; }
  .progress-bar.green { background: #10b981; }
  .progress-bar.amber { background: #f59e0b; }

  .pg-status-note {
    font-size: 0.72rem;
  }

  .total-pg-box {
    margin-top: 20px;
    padding: 14px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px dashed rgba(255, 255, 255, 0.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .tpg-label {
    font-size: 0.8rem;
    color: #94a3b8;
  }

  .tpg-val {
    font-size: 1.1rem;
    font-weight: 800;
    color: #ffffff;
    font-family: monospace;
  }

  .banner-cta-box {
    margin-top: 20px;
    background: linear-gradient(135deg, rgba(0, 119, 255, 0.15) 0%, rgba(0, 194, 255, 0.05) 100%);
    border: 1px solid rgba(0, 194, 255, 0.25);
  }

  .cta-pill {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 20px;
    background: #00c2ff;
    color: #080c14;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
  }

  .banner-cta-box h3 {
    color: #ffffff;
    margin: 0 0 6px;
    font-size: 1.2rem;
  }

  .banner-cta-box p {
    color: #94a3b8;
    font-size: 0.85rem;
    line-height: 1.45;
    margin: 0;
  }

  @media (max-width: 992px) {
    .kpi-stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .dashboard-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .kpi-stats-grid {
      grid-template-columns: 1fr;
    }
    .profile-header-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .attempt-card {
      flex-direction: column;
      align-items: flex-start;
    }
    .attempt-right {
      width: 100%;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>

<script is:inline>
  (function () {
    const AUTH_KEY = 'cat_user_session';
    const nameEl = document.getElementById('user-display-name');
    const roleEl = document.getElementById('user-role-label');
    const avatarEl = document.getElementById('user-avatar-badge');
    const nikEl = document.getElementById('user-nik-label');
    const targetEl = document.getElementById('user-target-label');

    try {
      const raw = localStorage.getItem(AUTH_KEY);
      if (raw) {
        const user = JSON.parse(raw);
        if (user && user.isLoggedIn) {
          if (nameEl) nameEl.textContent = user.name || 'Peserta SIMCAT';
          if (roleEl) roleEl.textContent = user.roleName || 'Peserta Terdaftar';
          if (nikEl && user.nikMasked) nikEl.textContent = `NIK: ${user.nikMasked}`;
          if (targetEl && user.targetInstansi) targetEl.textContent = `Target: ${user.targetInstansi}`;
          if (avatarEl && user.name) {
            const initials = user.name.split(' ').map(w => w[0]).slice(0, 2).join('').toUpperCase();
            avatarEl.textContent = initials;
          }
        }
      }
    } catch (e) {}
  })();
</script>
