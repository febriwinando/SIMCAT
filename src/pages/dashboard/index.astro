---
import Layout from '../../layouts/Layout.astro';
import { queryAll, queryOne } from '../../db';

// SSR: Fetch initial data from database
const recentAttempts = queryAll(`
  SELECT 
    a.uuid, a.started_at, a.finished_at, a.status,
    p.title as package_title, p.slug as package_slug, p.category_id,
    c.name as category_name,
    r.total_score, r.max_possible_score, r.is_passed,
    r.accuracy_percent, r.time_spent_seconds, r.graded_at
  FROM exam_attempts a
  JOIN exam_packages p ON a.package_id = p.id
  JOIN exam_categories c ON p.category_id = c.id
  LEFT JOIN exam_results r ON a.id = r.attempt_id
  WHERE a.status IN ('submitted', 'auto_submitted', 'graded')
  ORDER BY a.id DESC
  LIMIT 5
`);

const totalAttemptsCount = queryOne<{ count: number }>(`
  SELECT COUNT(*) as count FROM exam_attempts WHERE status IN ('submitted', 'auto_submitted', 'graded')
`)?.count || 0;

const passedAttemptsCount = queryOne<{ count: number }>(`
  SELECT COUNT(*) as count FROM exam_results WHERE is_passed = 1
`)?.count || 0;

const highestScore = queryOne<{ max_score: number }>(`
  SELECT MAX(total_score) as max_score FROM exam_results
`)?.max_score || 0;

const avgScore = queryOne<{ avg_score: number }>(`
  SELECT AVG(total_score) as avg_score FROM exam_results
`)?.avg_score || 0;

const passRate = totalAttemptsCount > 0 ? Math.round((passedAttemptsCount / totalAttemptsCount) * 100) : 0;
---

<Layout title="Dashboard Peserta - SIMCAT 2026">
  <div class="dashboard-page-wrapper">
    <div class="container">
      <!-- Dashboard Top Header / Profile Bar -->
      <div class="profile-header-card glass-panel">
        <div class="profile-main">
          <div class="avatar-box" id="user-avatar-badge">PS</div>
          <div class="profile-info">
            <div class="profile-role-badge">
              <span class="pulse-dot"></span>
              <span id="user-role-label">Peserta Terdaftar</span>
            </div>
            <h1 class="user-greeting" id="user-display-name">Peserta SIMCAT</h1>
            <div class="profile-meta">
              <span id="user-nik-label">NIK: 3201************0001</span>
              <span>•</span>
              <span id="user-target-label">Target: Seleksi Nasional CPNS 2026</span>
            </div>
          </div>
        </div>
        <div class="header-action-btns">
          <a href="/simulasi" class="btn btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            Mulai Ujian Baru
          </a>
        </div>
      </div>

      <!-- Dashboard Navigation Tabs -->
      <div class="dash-tabs-bar">
        <a href="/dashboard" class="dash-tab active">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          Ringkasan Belajar
        </a>
        <a href="/dashboard/riwayat" class="dash-tab">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="12 8 12 12 14 14"></polyline>
            <path d="M3.05 11a9 9 0 1 1 .5 4m-.5 5v-5h5"></path>
          </svg>
          Riwayat Ujian ({totalAttemptsCount})
        </a>
        <a href="/dashboard/analisis" class="dash-tab">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="20" x2="18" y2="10"></line>
            <line x1="12" y1="20" x2="12" y2="4"></line>
            <line x1="6" y1="20" x2="6" y2="14"></line>
          </svg>
          Analisis Kelemahan
        </a>
        <a href="/dashboard/pembelian" class="dash-tab">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          Paket Pro & Tryout Akbar
        </a>
      </div>

      <!-- KPI Stat Grid -->
      <div class="kpi-stats-grid">
        <div class="kpi-card glass-panel">
          <div class="kpi-top">
            <span class="kpi-title">Total Simulasi</span>
            <span class="kpi-icon blue">📝</span>
          </div>
          <div class="kpi-value">{totalAttemptsCount}</div>
          <div class="kpi-sub">Sesi ujian terselesaikan</div>
        </div>

        <div class="kpi-card glass-panel">
          <div class="kpi-top">
            <span class="kpi-title">Kelulusan Passing Grade</span>
            <span class="kpi-icon green">🎯</span>
          </div>
          <div class="kpi-value text-green">{passRate}%</div>
          <div class="kpi-sub">{passedAttemptsCount} dari {totalAttemptsCount} attempt memenuhi PG</div>
        </div>

        <div class="kpi-card glass-panel">
          <div class="kpi-top">
            <span class="kpi-title">Skor Tertinggi</span>
            <span class="kpi-icon amber">🏆</span>
          </div>
          <div class="kpi-value text-amber">{highestScore}</div>
          <div class="kpi-sub">Pencapaian simulasi terbaik</div>
        </div>

        <div class="kpi-card glass-panel">
          <div class="kpi-top">
            <span class="kpi-title">Rata-Rata Nilai</span>
            <span class="kpi-icon cyan">⚡</span>
          </div>
          <div class="kpi-value text-cyan">{Math.round(avgScore * 10) / 10}</div>
          <div class="kpi-sub">Dari seluruh modul tryout</div>
        </div>
      </div>

      <!-- Main Content Grid -->
      <div class="dashboard-grid">
        <!-- Left: Recent Attempts List -->
        <div class="dash-col main-col">
          <div class="content-box glass-panel">
            <div class="box-header">
              <div>
                <h2 class="box-title">Riwayat Simulasi Terakhir</h2>
                <p class="box-desc">Daftar attempt simulasi CAT terstandarisasi yang telah Anda selesaikan.</p>
              </div>
              <a href="/dashboard/riwayat" class="btn btn-secondary btn-sm">Lihat Semua</a>
            </div>

            {recentAttempts.length > 0 ? (
              <div class="attempts-list">
                {recentAttempts.map((item) => (
                  <div class="attempt-card">
                    <div class="attempt-info">
                      <div class="attempt-badges">
                        <span class={`badge ${item.is_passed === 1 ? 'badge-green' : 'badge-red'}`}>
                          {item.is_passed === 1 ? '✓ LULUS PG' : '✕ TIDAK LULUS'}
                        </span>
                        <span class="badge-tag">{item.category_name}</span>
                      </div>
                      <h3 class="attempt-title">{item.package_title}</h3>
                      <div class="attempt-meta">
                        <span>📅 {new Date(item.graded_at || item.finished_at || item.started_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })}</span>
                        <span>•</span>
                        <span>⏱️ {Math.round((item.time_spent_seconds || 0) / 60)} menit</span>
                        <span>•</span>
                        <span>Akurasi: {Math.round(item.accuracy_percent || 0)}%</span>
                      </div>
                    </div>

                    <div class="attempt-right">
                      <div class="score-pill">
                        <span class="score-num">{item.total_score}</span>
                        <span class="score-max">/ {item.max_possible_score}</span>
                      </div>
                      <div class="action-buttons">
                        <a href={`/dashboard/hasil/${item.uuid}`} class="btn btn-secondary btn-sm">
                          Scorecard
                        </a>
                        <a href={`/pembahasan/${item.package_slug}`} class="btn btn-primary btn-sm">
                          Pembahasan
                        </a>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div class="empty-state">
                <div class="empty-icon">📋</div>
                <h3>Belum Ada Riwayat Ujian</h3>
                <p>Mulai simulasi pertama Anda untuk mengukur kesiapan menghadapi tes CPNS, PPPK, BUMN, atau Kedinasan.</p>
                <a href="/simulasi" class="btn btn-primary" style="margin-top: 16px;">
                  Pilih Simulasi Sekarang
                </a>
              </div>
            )}
          </div>
        </div>

        <!-- Right: Readiness & Recommendations -->
        <div class="dash-col side-col">
          <!-- Readiness Card -->
          <div class="content-box glass-panel readiness-card">
            <h3 class="box-title">Target & Ambang Batas SKD</h3>
            <p class="box-desc">Rujukan: KepmenPAN-RB No. 321/2024</p>

            <div class="pg-target-list">
              <div class="pg-target-item">
                <div class="pg-item-header">
                  <span class="pg-name">Tes Wawasan Kebangsaan (TWK)</span>
                  <span class="pg-val">Min. 65</span>
                </div>
                <div class="progress-track">
                  <div class="progress-bar blue" style="width: 78%;"></div>
                </div>
                <span class="pg-status-note text-cyan">Passing Grade: 65 / Maksimal 150</span>
              </div>

              <div class="pg-target-item">
                <div class="pg-item-header">
                  <span class="pg-name">Tes Inteligensi Umum (TIU)</span>
                  <span class="pg-val">Min. 80</span>
                </div>
                <div class="progress-track">
                  <div class="progress-bar green" style="width: 85%;"></div>
                </div>
                <span class="pg-status-note text-green">Passing Grade: 80 / Maksimal 175</span>
              </div>

              <div class="pg-target-item">
                <div class="pg-item-header">
                  <span class="pg-name">Tes Karakteristik Pribadi (TKP)</span>
                  <span class="pg-val">Min. 166</span>
                </div>
                <div class="progress-track">
                  <div class="progress-bar amber" style="width: 80%;"></div>
                </div>
                <span class="pg-status-note text-amber">Passing Grade: 166 / Maksimal 225</span>
              </div>
            </div>

            <div class="total-pg-box">
              <div class="tpg-label">Total Nilai Kumulatif Maksimal</div>
              <div class="tpg-val">550 Poin</div>
            </div>
          </div>

          <!-- Quick Action Card -->
          <div class="content-box glass-panel banner-cta-box">
            <div class="cta-pill">UPGRADE PERSIAPAN</div>
            <h3>Tryout Akbar Nasional 2026</h3>
            <p>Uji kemampuan Anda serentak bersama ribuan peserta se-Indonesia dengan sistem perangkingan nasional.</p>
            <a href="/dashboard/pembelian" class="btn btn-primary btn-block" style="margin-top: 16px;">
              Daftar Tryout Akbar
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
