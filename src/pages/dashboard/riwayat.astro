---
import Layout from '../../layouts/Layout.astro';
import { queryAll } from '../../db';

const attempts = queryAll(`
  SELECT 
    a.id, a.uuid, a.user_id, a.started_at, a.finished_at, a.status,
    p.id as package_id, p.title as package_title, p.slug as package_slug,
    p.category_id, c.name as category_name,
    r.total_score, r.max_possible_score, r.is_passed,
    r.correct_count, r.wrong_count, r.unanswered_count,
    r.accuracy_percent, r.time_spent_seconds, r.category_scores,
    r.graded_at
  FROM exam_attempts a
  JOIN exam_packages p ON a.package_id = p.id
  JOIN exam_categories c ON p.category_id = c.id
  LEFT JOIN exam_results r ON a.id = r.attempt_id
  WHERE a.status IN ('submitted', 'auto_submitted', 'graded')
  ORDER BY a.id DESC
`);

const parsedAttempts = attempts.map((row) => {
  let subtests: any[] = [];
  if (row.category_scores) {
    try {
      const breakdown = JSON.parse(row.category_scores);
      subtests = Object.keys(breakdown).map((k) => ({
        code: k,
        name: breakdown[k].name,
        score: breakdown[k].score,
        passingGrade: breakdown[k].passingGrade,
        isPassed: breakdown[k].isPassed
      }));
    } catch (e) {}
  }

  return {
    ...row,
    isPassed: row.is_passed === 1,
    subtests
  };
});
---

<Layout title="Riwayat Ujian Lengkap - SIMCAT 2026">
  <div class="dashboard-page-wrapper">
    <div class="container">
      <!-- Cyber Breadcrumb -->
      <div class="dash-breadcrumb">
        <a href="/dashboard">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          </svg>
          DASHBOARD
        </a>
        <span class="slash">/</span>
        <span class="active">RIWAYAT_SIMULASI.LOG</span>
      </div>

      <div class="page-header-row cyber-card" style="padding: 24px 28px; margin-bottom: 28px; background: rgba(10, 16, 32, 0.7); border: 1px solid rgba(0, 242, 254, 0.2);">
        <div>
          <div class="telemetry-pill mb-2" style="font-size: 0.75rem;">
            <span class="beacon"></span>
            SYS: VERIFIED_RECORD_VAULT // CPANEL-ASTRO
          </div>
          <h1 class="page-title cyber-glitch-title">Riwayat Simulasi CAT</h1>
          <p class="page-subtitle">Daftar seluruh sesi ujian yang tersimpan secara terverifikasi & server-authoritative pada engine SIMCAT.</p>
        </div>
        <a href="/simulasi" class="btn btn-primary" onclick="window.playCyberSound?.('confirm')">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          Mulai Ujian Baru
        </a>
      </div>

      <!-- Navigation Tabs -->
      <div class="dash-tabs-bar">
        <a href="/dashboard" class="dash-tab" onclick="window.playCyberSound?.('click')">Ringkasan Belajar</a>
        <a href="/dashboard/riwayat" class="dash-tab active" onclick="window.playCyberSound?.('click')">Riwayat Ujian</a>
        <a href="/dashboard/analisis" class="dash-tab" onclick="window.playCyberSound?.('click')">Analisis Kelemahan</a>
        <a href="/dashboard/pembelian" class="dash-tab" onclick="window.playCyberSound?.('click')">Paket Pro & Tryout Akbar</a>
      </div>

      <!-- Category Filter Pills -->
      <div class="filter-pills-row">
        <button class="filter-pill active" data-filter="all" onclick="window.playCyberSound?.('click')">
          <span class="filter-indicator"></span> Semua Kategori ({parsedAttempts.length})
        </button>
        <button class="filter-pill" data-filter="cpns" onclick="window.playCyberSound?.('click')">
          <span class="filter-indicator"></span> CPNS SKD
        </button>
        <button class="filter-pill" data-filter="pppk" onclick="window.playCyberSound?.('click')">
          <span class="filter-indicator"></span> PPPK
        </button>
        <button class="filter-pill" data-filter="bumn" onclick="window.playCyberSound?.('click')">
          <span class="filter-indicator"></span> BUMN
        </button>
        <button class="filter-pill" data-filter="sekolah-kedinasan" onclick="window.playCyberSound?.('click')">
          <span class="filter-indicator"></span> Sekolah Kedinasan
        </button>
      </div>

      <!-- History Table / Cards -->
      <div class="history-container cyber-card" style="background: rgba(8, 13, 26, 0.75); border: 1px solid rgba(0, 242, 254, 0.18);">
        {parsedAttempts.length > 0 ? (
          <div class="history-list" id="history-items-wrapper">
            {parsedAttempts.map((item) => (
              <div class="history-card cyber-card" data-category={item.category_id} style="transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);">
                <div class="h-main">
                  <div class="h-badge-row">
                    <span class={`badge ${item.isPassed ? 'badge-pass' : 'badge-fail'}`}>
                      {item.isPassed ? '✓ MEMENUHI PASSING GRADE' : '✕ TIDAK LULUS PG'}
                    </span>
                    <span class="badge-cat">{item.category_name}</span>
                    <span class="badge-date mono-font">
                      🕒 {new Date(item.graded_at || item.finished_at || item.started_at).toLocaleDateString('id-ID', {
                        day: 'numeric',
                        month: 'short',
                        year: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                      })} WIB
                    </span>
                  </div>

                  <h3 class="h-title">{item.package_title}</h3>

                  <div class="h-subtests-breakdown">
                    {item.subtests.length > 0 ? (
                      item.subtests.map((sub: any) => (
                        <div class="sub-chip">
                          <span class="sub-label">{sub.code}:</span>
                          <span class={`sub-score ${sub.isPassed ? 'text-green' : 'text-red'}`}>
                            {sub.score}
                          </span>
                          <span class="sub-pg">/ PG: {sub.passingGrade}</span>
                        </div>
                      ))
                    ) : (
                      <span class="text-dim">Rincian subtes tersimpan</span>
                    )}
                  </div>

                  <div class="h-meta-stats">
                    <span class="meta-chip">⏱️ {Math.round((item.time_spent_seconds || 0) / 60)} Menit</span>
                    <span class="meta-chip">🎯 Akurasi {Math.round(item.accuracy_percent || 0)}%</span>
                    <span class="meta-chip">Benar: <strong class="text-green">{item.correct_count}</strong></span>
                    <span class="meta-chip">Salah: <strong class="text-red">{item.wrong_count}</strong></span>
                    <span class="meta-chip">Kosong: {item.unanswered_count}</span>
                  </div>
                </div>

                <div class="h-side">
                  <div class="total-score-wrap">
                    <div class="score-label">SKOR TOTAL AKHIR</div>
                    <div class={`score-big ${item.isPassed ? 'score-pass-glow' : 'score-fail-glow'}`}>{item.total_score}</div>
                    <div class="score-max">Maksimal: {item.max_possible_score}</div>
                  </div>

                  <div class="h-action-btns">
                    <a href={`/dashboard/hasil/${item.uuid}`} class="btn btn-secondary btn-sm" onclick="window.playCyberSound?.('click')">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                      </svg>
                      Scorecard
                    </a>
                    <a href={`/pembahasan/${item.package_slug}`} class="btn btn-primary btn-sm" onclick="window.playCyberSound?.('confirm')">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                      </svg>
                      Pembahasan
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <div class="empty-icon">📁</div>
            <h3 style="color: #ffffff; margin-bottom: 8px;">Belum Ada Riwayat Ujian di Server</h3>
            <p style="color: #94a3b8; font-size: 0.95rem;">Selesaikan salah satu modul simulasi CAT kami untuk melihat hasil analisis lengkap Anda.</p>
            <a href="/simulasi" class="btn btn-primary" style="margin-top: 20px;" onclick="window.playCyberSound?.('confirm')">
              Mulai Simulasi CAT
            </a>
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>

<style>
  .dashboard-page-wrapper {
    padding: 32px 0 80px;
  }

  .dash-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--text-dim);
    margin-bottom: 20px;
  }

  .dash-breadcrumb a {
    color: var(--cyber-cyan);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .dash-breadcrumb .slash {
    color: rgba(255, 255, 255, 0.2);
  }

  .dash-breadcrumb .active {
    color: #e2e8f0;
  }

  .page-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    position: relative;
    overflow: hidden;
  }

  .page-header-row::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--cyber-cyan), var(--cyber-purple), transparent);
  }

  .page-title {
    font-size: 2rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 6px;
    letter-spacing: -0.02em;
  }

  .page-subtitle {
    font-size: 0.95rem;
    color: #94a3b8;
    margin: 0;
  }

  /* Navigation Tabs */
  .dash-tabs-bar {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 12px;
    overflow-x: auto;
  }

  .dash-tab {
    padding: 8px 18px;
    border-radius: 8px;
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    transition: all 0.25s ease;
    white-space: nowrap;
    border: 1px solid transparent;
  }

  .dash-tab:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.05);
  }

  .dash-tab.active {
    color: var(--cyber-cyan);
    background: rgba(0, 242, 254, 0.1);
    border-color: rgba(0, 242, 254, 0.3);
    box-shadow: 0 0 15px rgba(0, 242, 254, 0.15);
  }

  /* Filter Pills */
  .filter-pills-row {
    display: flex;
    gap: 10px;
    margin-bottom: 24px;
    overflow-x: auto;
    padding-bottom: 6px;
  }

  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    border-radius: 99px;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #94a3b8;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
  }

  .filter-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #64748b;
    transition: all 0.25s ease;
  }

  .filter-pill:hover {
    color: #ffffff;
    background: rgba(30, 41, 59, 0.9);
    border-color: rgba(0, 242, 254, 0.3);
    transform: translateY(-1px);
  }

  .filter-pill.active {
    background: rgba(0, 242, 254, 0.15);
    color: var(--cyber-cyan);
    border-color: var(--cyber-cyan);
    box-shadow: 0 0 16px rgba(0, 242, 254, 0.25);
  }

  .filter-pill.active .filter-indicator {
    background: var(--cyber-cyan);
    box-shadow: 0 0 8px var(--cyber-cyan);
  }

  .history-container {
    padding: 24px;
    border-radius: 16px;
  }

  .history-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .history-card {
    padding: 22px 26px;
    border-radius: 14px;
    background: rgba(18, 27, 49, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.07);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }

  .history-card:hover {
    background: rgba(23, 35, 64, 0.85);
    border-color: rgba(0, 242, 254, 0.35);
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4), 0 0 20px rgba(0, 242, 254, 0.1);
  }

  .h-badge-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }

  .badge-pass {
    background: rgba(0, 245, 160, 0.15);
    color: var(--cyber-emerald);
    border: 1px solid rgba(0, 245, 160, 0.4);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 6px;
    letter-spacing: 0.04em;
    box-shadow: 0 0 10px rgba(0, 245, 160, 0.15);
  }

  .badge-fail {
    background: rgba(255, 0, 85, 0.15);
    color: var(--cyber-crimson);
    border: 1px solid rgba(255, 0, 85, 0.4);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 6px;
    letter-spacing: 0.04em;
    box-shadow: 0 0 10px rgba(255, 0, 85, 0.15);
  }

  .badge-cat {
    font-size: 0.75rem;
    color: #cbd5e1;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 4px 10px;
    border-radius: 6px;
    font-family: var(--font-mono);
  }

  .badge-date {
    font-size: 0.75rem;
    color: #64748b;
  }

  .h-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 12px;
  }

  .h-subtests-breakdown {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }

  .sub-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.78rem;
    font-family: var(--font-mono);
  }

  .sub-label {
    color: #94a3b8;
  }

  .sub-score {
    font-weight: 800;
  }

  .sub-pg {
    color: #64748b;
    font-size: 0.72rem;
  }

  .h-meta-stats {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: #94a3b8;
    flex-wrap: wrap;
  }

  .meta-chip {
    padding: 2px 8px;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.04);
  }

  .text-green { color: var(--cyber-emerald) !important; text-shadow: 0 0 8px rgba(0, 245, 160, 0.3); }
  .text-red { color: var(--cyber-crimson) !important; text-shadow: 0 0 8px rgba(255, 0, 85, 0.3); }
  .text-dim { color: #64748b; }

  .h-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 14px;
    min-width: 190px;
  }

  .total-score-wrap {
    text-align: right;
  }

  .score-label {
    font-size: 0.68rem;
    font-weight: 700;
    color: #94a3b8;
    letter-spacing: 0.08em;
    font-family: var(--font-mono);
  }

  .score-big {
    font-size: 2.4rem;
    font-weight: 900;
    font-family: var(--font-mono);
    line-height: 1.1;
  }

  .score-pass-glow {
    color: var(--cyber-emerald);
    text-shadow: 0 0 15px rgba(0, 245, 160, 0.5);
  }

  .score-fail-glow {
    color: var(--cyber-crimson);
    text-shadow: 0 0 15px rgba(255, 0, 85, 0.4);
  }

  .score-max {
    font-size: 0.75rem;
    color: #64748b;
    font-family: var(--font-mono);
  }

  .h-action-btns {
    display: flex;
    gap: 8px;
  }

  .btn-sm {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    font-size: 0.82rem;
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
  }

  .empty-icon {
    font-size: 3.5rem;
    margin-bottom: 12px;
  }

  @media (max-width: 768px) {
    .page-header-row {
      flex-direction: column;
      align-items: flex-start;
    }
    .history-card {
      flex-direction: column;
      align-items: flex-start;
    }
    .h-side {
      width: 100%;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
    .total-score-wrap {
      text-align: left;
    }
  }
</style>

<script is:inline>
  (function () {
    const filterBtns = document.querySelectorAll('.filter-pill');
    const cards = document.querySelectorAll('.history-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');

        cards.forEach((card) => {
          if (filter === 'all' || card.getAttribute('data-category') === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  })();
</script>
