---
import Layout from '../../layouts/Layout.astro';
import { queryOne, queryAll } from '../../db';

const { category } = Astro.params;

const cat = queryOne(`
  SELECT * FROM exam_categories WHERE id = ?
`, [category]);

if (!cat) {
  return Astro.redirect('/kategori');
}

// Fetch subjects and topics
const subjects = queryAll(`
  SELECT s.*, COUNT(q.id) as question_count
  FROM subjects s
  LEFT JOIN questions q ON s.id = q.subject_id AND q.editorial_status = 'published'
  WHERE s.category_id = ?
  GROUP BY s.id
`, [cat.id]);

// Fetch packages
const packages = queryAll(`
  SELECT p.*, sr.rules_json, sr.reference_source
  FROM exam_packages p
  JOIN scoring_rules sr ON p.scoring_rule_id = sr.id
  WHERE p.category_id = ? AND p.status = 'published'
`, [cat.id]);

// Fetch scoring rule
const scoringRule = queryOne(`
  SELECT * FROM scoring_rules WHERE category_id = ? LIMIT 1
`, [cat.id]);

const ruleConfig = scoringRule ? JSON.parse(scoringRule.rules_json || '{}') : {};
const subtests = ruleConfig.subtests || {};
---

<Layout title={`Panduan & Simulasi ${cat.name} - SIMCAT 2026`}>
  <div class="category-detail-wrapper">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb-nav">
        <a href="/">Beranda</a>
        <span>/</span>
        <a href="/kategori">Kategori</a>
        <span>/</span>
        <span class="active">{cat.name}</span>
      </nav>

      <!-- Hero Header -->
      <div class="detail-header glass-panel">
        <div class="header-left">
          <span class="detail-icon">{cat.icon}</span>
          <div>
            <span class="badge badge-cpns">Seleksi Nasional 2026</span>
            <h1 class="detail-title">{cat.name}</h1>
            <p class="detail-desc">{cat.description}</p>
          </div>
        </div>
      </div>

      <div class="detail-layout">
        <!-- Main Column: Syllabus & Packages -->
        <div class="detail-main">
          <!-- Packages Section -->
          <section class="section-box">
            <h2 class="section-title">Paket Simulasi CAT Tersedia</h2>
            <div class="packages-list">
              {packages.map((pkg) => (
                <div class="pkg-card glass-panel">
                  <div class="pkg-top">
                    <div>
                      <h3 class="pkg-title">{pkg.title}</h3>
                      <p class="pkg-desc">{pkg.description}</p>
                    </div>
                    <span class="badge badge-pppk">{pkg.is_free ? 'GRATIS' : 'PREMIUM'}</span>
                  </div>

                  <div class="pkg-meta-grid">
                    <div class="meta-item">
                      <span class="meta-lbl">Waktu Ujian</span>
                      <strong class="meta-val">{pkg.duration_minutes} Menit</strong>
                    </div>
                    <div class="meta-item">
                      <span class="meta-lbl">Jumlah Soal</span>
                      <strong class="meta-val">{pkg.total_questions} Butir Soal</strong>
                    </div>
                    <div class="meta-item">
                      <span class="meta-lbl">Sistem Ujian</span>
                      <strong class="meta-val">CAT Timer + Autosave</strong>
                    </div>
                  </div>

                  <div class="pkg-actions">
                    <a href={`/simulasi/${pkg.slug}`} class="btn btn-primary" style="flex: 1;">
                      Mulai Kerjakan Simulasi →
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </section>

          <!-- Syllabus Section -->
          <section class="section-box" style="margin-top: 40px;">
            <h2 class="section-title">Cakupan Kisi-Kisi & Subtes Materi</h2>
            <div class="subjects-list">
              {subjects.map((sub) => (
                <div class="subject-card glass-panel">
                  <div class="subject-header">
                    <div>
                      <span class="badge badge-cpns">{sub.code}</span>
                      <h3 class="subject-title">{sub.name}</h3>
                    </div>
                    <span class="q-count-badge">{sub.question_count} Soal Aktif</span>
                  </div>
                  <p class="subject-desc">{sub.description}</p>
                </div>
              ))}
            </div>
          </section>
        </div>

        <!-- Sidebar: Scoring Rules & Transparency -->
        <aside class="detail-sidebar">
          <div class="sidebar-card glass-panel">
            <h3 class="sidebar-title">Ketentuan Ambang Batas</h3>
            <div class="ref-source-box">
              <span class="ref-label">Referensi Regulasi:</span>
              <p class="ref-text">{scoringRule?.reference_source || 'Regulasi Standar Seleksi Nasional'}</p>
            </div>

            <div class="passing-list">
              {Object.entries<any>(subtests).map(([key, st]) => (
                <div class="passing-item">
                  <div class="passing-header">
                    <strong>{st.name}</strong>
                    <span class="text-highlight">Ambang Batas: {st.passingGrade}</span>
                  </div>
                  <p class="passing-sub">
                    {st.isScaleOption ? 'Penilaian skala bobot 1 s/d 5' : `Benar: +${st.correctScore}, Salah: ${st.wrongScore}`}
                  </p>
                </div>
              ))}
            </div>

            <div class="disclaimer-mini">
              * SIMCAT merupakan media latihan mandiri terpisah dari panitia seleksi resmi BKN/KemenPAN-RB/FHCI.
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</Layout>

<style>
  .category-detail-wrapper {
    padding: 30px 0 80px;
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 24px;
  }

  .breadcrumb-nav a {
    color: var(--text-muted);
  }

  .breadcrumb-nav .active {
    color: #ffffff;
    font-weight: 600;
  }

  .detail-header {
    padding: 36px 32px;
    border-radius: var(--radius-md);
    margin-bottom: 40px;
  }

  .header-left {
    display: flex;
    align-items: flex-start;
    gap: 24px;
  }

  .detail-icon {
    font-size: 3.5rem;
  }

  .detail-title {
    font-size: 2.2rem;
    font-weight: 800;
    color: #ffffff;
    margin: 8px 0 12px;
  }

  .detail-desc {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 820px;
  }

  .detail-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 32px;
  }

  .section-title {
    font-size: 1.45rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 20px;
  }

  .packages-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pkg-card {
    padding: 24px 28px;
    border-radius: var(--radius-md);
  }

  .pkg-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 18px;
  }

  .pkg-title {
    font-size: 1.25rem;
    color: #ffffff;
    margin-bottom: 6px;
  }

  .pkg-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .pkg-meta-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    padding: 12px 18px;
    margin-bottom: 20px;
  }

  .meta-lbl {
    font-size: 0.72rem;
    text-transform: uppercase;
    color: var(--text-dim);
    display: block;
    margin-bottom: 4px;
  }

  .meta-val {
    color: #ffffff;
    font-size: 0.95rem;
  }

  .subjects-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .subject-card {
    padding: 20px 24px;
    border-radius: var(--radius-sm);
  }

  .subject-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
  }

  .subject-title {
    font-size: 1.05rem;
    color: #ffffff;
    margin-top: 6px;
  }

  .q-count-badge {
    font-size: 0.75rem;
    color: #60a5fa;
    background: rgba(59, 130, 246, 0.1);
    padding: 4px 10px;
    border-radius: 20px;
    font-weight: 600;
  }

  .subject-desc {
    font-size: 0.85rem;
    color: var(--text-dim);
    line-height: 1.5;
  }

  .sidebar-card {
    padding: 26px 24px;
    border-radius: var(--radius-md);
  }

  .sidebar-title {
    font-size: 1.15rem;
    color: #ffffff;
    margin-bottom: 16px;
  }

  .ref-source-box {
    background: rgba(255, 255, 255, 0.03);
    border-radius: 6px;
    padding: 10px 14px;
    margin-bottom: 18px;
  }

  .ref-label {
    font-size: 0.72rem;
    color: var(--text-dim);
    text-transform: uppercase;
    display: block;
  }

  .ref-text {
    font-size: 0.85rem;
    color: #60a5fa;
    font-weight: 600;
    margin-top: 2px;
  }

  .passing-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 20px;
  }

  .passing-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding-bottom: 12px;
  }

  .passing-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .text-highlight {
    color: #34d399;
  }

  .passing-sub {
    font-size: 0.78rem;
    color: var(--text-dim);
  }

  .disclaimer-mini {
    font-size: 0.72rem;
    color: var(--text-dim);
    line-height: 1.4;
    font-style: italic;
  }

  @media (max-width: 900px) {
    .detail-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
