---
import Layout from '../../layouts/Layout.astro';
import { queryOne, queryAll } from '../../db';

const { category } = Astro.params;

const cat = queryOne(`
  SELECT * FROM exam_categories WHERE id = ?
`, [category]);

if (!cat) {
  return Astro.redirect('/kategori');
}

// Fetch subjects and topics
const subjects = queryAll(`
  SELECT s.*, COUNT(q.id) as question_count
  FROM subjects s
  LEFT JOIN questions q ON s.id = q.subject_id AND q.editorial_status = 'published'
  WHERE s.category_id = ?
  GROUP BY s.id
`, [cat.id]);

// Fetch packages
const packages = queryAll(`
  SELECT p.*, sr.rules_json, sr.reference_source
  FROM exam_packages p
  JOIN scoring_rules sr ON p.scoring_rule_id = sr.id
  WHERE p.category_id = ? AND p.status = 'published'
`, [cat.id]);

// Fetch scoring rule
const scoringRule = queryOne(`
  SELECT * FROM scoring_rules WHERE category_id = ? LIMIT 1
`, [cat.id]);

const ruleConfig = scoringRule ? JSON.parse(scoringRule.rules_json || '{}') : {};
const subtests = ruleConfig.subtests || {};
---

<Layout title={`Panduan & Simulasi ${cat.name} - SIMCAT 2026`}>
  <div class="category-detail-wrapper">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb-nav">
        <a href="/" onclick="window.playCyberSound?.('click')">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          </svg>
          BERANDA
        </a>
        <span class="slash">/</span>
        <a href="/kategori" onclick="window.playCyberSound?.('click')">KATEGORI</a>
        <span class="slash">/</span>
        <span class="active mono-font">{cat.name.toUpperCase()}</span>
      </nav>

      <!-- Hero Header -->
      <div class="detail-header cyber-card" style="background: rgba(8, 13, 26, 0.85); border: 1px solid rgba(0, 242, 254, 0.25); box-shadow: 0 16px 45px rgba(0, 0, 0, 0.4), 0 0 30px rgba(0, 242, 254, 0.1);">
        <div class="header-left">
          <span class="detail-icon">{cat.icon}</span>
          <div>
            <div class="telemetry-pill mb-2" style="font-size: 0.72rem; display: inline-flex;">
              <span class="beacon"></span>
              CATEGORY_INDEX // STANDAR NASIONAL 2026
            </div>
            <h1 class="detail-title cyber-glitch-title">{cat.name}</h1>
            <p class="detail-desc">{cat.description}</p>
          </div>
        </div>
      </div>

      <div class="detail-layout">
        <!-- Main Column: Syllabus & Packages -->
        <div class="detail-main">
          <!-- Packages Section -->
          <section class="section-box">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
              <h2 class="section-title" style="margin: 0;">Paket Simulasi CAT Tersedia</h2>
              <span class="telemetry-pill" style="font-size: 0.72rem;">{packages.length} MODUL AKTIF</span>
            </div>
            <div class="packages-list">
              {packages.map((pkg) => (
                <div class="pkg-card cyber-card" style="background: rgba(12, 19, 38, 0.7); border: 1px solid rgba(255, 255, 255, 0.08); transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);">
                  <div class="pkg-top">
                    <div>
                      <h3 class="pkg-title">{pkg.title}</h3>
                      <p class="pkg-desc">{pkg.description}</p>
                    </div>
                    <span class={`badge ${pkg.is_free ? 'badge-pass' : 'badge-pppk'}`}>
                      {pkg.is_free ? 'GRATIS' : 'PREMIUM'}
                    </span>
                  </div>

                  <div class="pkg-meta-grid mono-font">
                    <div class="meta-item">
                      <span class="meta-lbl">Waktu Ujian</span>
                      <strong class="meta-val">{pkg.duration_minutes} Menit</strong>
                    </div>
                    <div class="meta-item">
                      <span class="meta-lbl">Jumlah Soal</span>
                      <strong class="meta-val">{pkg.total_questions} Butir Soal</strong>
                    </div>
                    <div class="meta-item">
                      <span class="meta-lbl">Sistem Ujian</span>
                      <strong class="meta-val text-cyan">CAT Timer + Autosave</strong>
                    </div>
                  </div>

                  <div class="pkg-actions">
                    <a href={`/simulasi/${pkg.slug}`} class="btn btn-primary btn-block" onclick="window.playCyberSound?.('confirm')">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                      </svg>
                      Mulai Kerjakan Simulasi CAT
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </section>

          <!-- Syllabus Section -->
          <section class="section-box" style="margin-top: 40px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
              <h2 class="section-title" style="margin: 0;">Cakupan Kisi-Kisi & Subtes Materi</h2>
              <span class="telemetry-pill" style="font-size: 0.72rem;">STANDAR SOAL HOTS</span>
            </div>
            <div class="subjects-list">
              {subjects.map((sub) => (
                <div class="subject-card cyber-card" style="background: rgba(14, 22, 44, 0.65); border: 1px solid rgba(255, 255, 255, 0.06);">
                  <div class="subject-header">
                    <div>
                      <span class="badge badge-cpns mono-font">{sub.code}</span>
                      <h3 class="subject-title">{sub.name}</h3>
                    </div>
                    <span class="q-count-badge mono-font">{sub.question_count} Butir Soal</span>
                  </div>
                  <p class="subject-desc">{sub.description}</p>
                </div>
              ))}
            </div>
          </section>
        </div>

        <!-- Sidebar: Scoring Rules & Transparency -->
        <aside class="detail-sidebar">
          <div class="sidebar-card cyber-card" style="background: rgba(10, 16, 32, 0.85); border: 1px solid rgba(0, 242, 254, 0.2); position: sticky; top: 90px;">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
              <span class="beacon"></span>
              <h3 class="sidebar-title" style="margin: 0;">Ketentuan Passing Grade</h3>
            </div>
            <div class="ref-source-box cyber-card" style="background: rgba(18, 27, 49, 0.6); border: 1px solid rgba(255, 255, 255, 0.08);">
              <span class="ref-label">Referensi Regulasi Resmi:</span>
              <p class="ref-text">{scoringRule?.reference_source || 'Regulasi Standar Seleksi Nasional'}</p>
            </div>

            <div class="passing-list">
              {Object.entries<any>(subtests).map(([key, st]) => (
                <div class="passing-item">
                  <div class="passing-header">
                    <strong>{st.name}</strong>
                    <span class="text-highlight mono-font">PG: {st.passingGrade}</span>
                  </div>
                  <p class="passing-sub">
                    {st.isScaleOption ? 'Penilaian skala bobot bertingkat 1 s/d 5' : `Benar: +${st.correctScore}, Salah: ${st.wrongScore}`}
                  </p>
                </div>
              ))}
            </div>

            <div class="disclaimer-mini">
              * SIMCAT merupakan media latihan mandiri independen berbasis simulasi CAT terstandarisasi.
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</Layout>

<style>
  .category-detail-wrapper {
    padding: 30px 0 80px;
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--text-dim);
    margin-bottom: 24px;
  }

  .breadcrumb-nav a {
    color: var(--cyber-cyan);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .breadcrumb-nav .slash {
    color: rgba(255, 255, 255, 0.2);
  }

  .breadcrumb-nav .active {
    color: #e2e8f0;
  }

  .detail-header {
    padding: 36px 32px;
    border-radius: 18px;
    margin-bottom: 40px;
    position: relative;
    overflow: hidden;
  }

  .detail-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--cyber-cyan), var(--cyber-purple), transparent);
  }

  .header-left {
    display: flex;
    align-items: flex-start;
    gap: 24px;
  }

  .detail-icon {
    font-size: 3.5rem;
    flex-shrink: 0;
  }

  .detail-title {
    font-size: 2.2rem;
    font-weight: 800;
    color: #ffffff;
    margin: 8px 0 12px;
    letter-spacing: -0.02em;
  }

  .detail-desc {
    color: #94a3b8;
    font-size: 1rem;
    line-height: 1.6;
    max-width: 820px;
    margin: 0;
  }

  .detail-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 32px;
  }

  .section-title {
    font-size: 1.45rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .packages-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pkg-card {
    padding: 26px 28px;
    border-radius: 16px;
  }

  .pkg-card:hover {
    border-color: rgba(0, 242, 254, 0.35) !important;
    transform: translateY(-3px);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.4), 0 0 20px rgba(0, 242, 254, 0.12);
  }

  .pkg-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 18px;
    gap: 16px;
  }

  .pkg-title {
    font-size: 1.25rem;
    color: #ffffff;
    margin-bottom: 6px;
    font-weight: 700;
  }

  .pkg-desc {
    font-size: 0.88rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0;
  }

  .pkg-meta-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 12px 18px;
    margin-bottom: 20px;
  }

  .meta-lbl {
    font-size: 0.72rem;
    text-transform: uppercase;
    color: var(--text-dim);
    display: block;
    margin-bottom: 4px;
  }

  .meta-val {
    color: #ffffff;
    font-size: 0.95rem;
  }

  .text-cyan {
    color: var(--cyber-cyan) !important;
  }

  .badge-pass {
    background: rgba(0, 245, 160, 0.15);
    color: var(--cyber-emerald);
    border: 1px solid rgba(0, 245, 160, 0.4);
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 0.75rem;
  }

  .badge-pppk {
    background: rgba(255, 183, 3, 0.15);
    color: var(--cyber-amber);
    border: 1px solid rgba(255, 183, 3, 0.4);
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 0.75rem;
  }

  .subjects-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .subject-card {
    padding: 20px 24px;
    border-radius: 12px;
    transition: all 0.25s ease;
  }

  .subject-card:hover {
    border-color: rgba(0, 242, 254, 0.3) !important;
    transform: translateX(4px);
  }

  .subject-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
  }

  .subject-title {
    font-size: 1.05rem;
    color: #ffffff;
    margin-top: 6px;
    font-weight: 700;
  }

  .q-count-badge {
    font-size: 0.75rem;
    color: var(--cyber-cyan);
    background: rgba(0, 242, 254, 0.1);
    border: 1px solid rgba(0, 242, 254, 0.3);
    padding: 4px 12px;
    border-radius: 20px;
    font-weight: 600;
  }

  .subject-desc {
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0;
  }

  .sidebar-card {
    padding: 26px 24px;
    border-radius: 16px;
  }

  .sidebar-title {
    font-size: 1.15rem;
    color: #ffffff;
    font-weight: 700;
  }

  .ref-source-box {
    border-radius: 8px;
    padding: 12px 14px;
    margin-bottom: 20px;
  }

  .ref-label {
    font-size: 0.72rem;
    color: var(--text-dim);
    text-transform: uppercase;
    display: block;
    font-family: var(--font-mono);
  }

  .ref-text {
    font-size: 0.85rem;
    color: var(--cyber-cyan);
    font-weight: 600;
    margin-top: 4px;
    line-height: 1.4;
  }

  .passing-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 20px;
  }

  .passing-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 12px;
  }

  .passing-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .text-highlight {
    color: var(--cyber-emerald);
    font-weight: 700;
  }

  .passing-sub {
    font-size: 0.78rem;
    color: #94a3b8;
    margin: 0;
  }

  .disclaimer-mini {
    font-size: 0.72rem;
    color: var(--text-dim);
    line-height: 1.4;
    font-style: italic;
  }

  @media (max-width: 900px) {
    .detail-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
