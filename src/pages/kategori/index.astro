---
import Layout from '../../layouts/Layout.astro';
import { queryAll } from '../../db';

const categories = queryAll(`
  SELECT 
    c.*,
    COUNT(DISTINCT p.id) as total_packages,
    COUNT(DISTINCT s.id) as total_subjects
  FROM exam_categories c
  LEFT JOIN exam_packages p ON c.id = p.category_id AND p.status = 'published'
  LEFT JOIN subjects s ON c.id = s.category_id
  GROUP BY c.id
  ORDER BY c.sort_order ASC
`);
---

<Layout title="Kategori Rumpun Seleksi Nasional - SIMCAT 2026">
  <div class="category-page-wrapper">
    <div class="container">
      <div class="page-header text-center">
        <div class="bkn-badge-pill">
          <span class="badge-dot"></span>
          KISI-KISI & SILABUS RESMI 2026
        </div>
        <h1 class="page-title">Pilih Rumpun Seleksi Nasional</h1>
        <p class="page-subtitle">
          SIMCAT menyediakan bank soal dan simulasi CAT terstandarisasi untuk 4 rumpun seleksi utama di Indonesia dengan sistem penilaian sesuai regulasi rujukan.
        </p>
      </div>

      <!-- Categories Grid -->
      <div class="categories-grid">
        {categories.map((cat) => {
          let catNeon = '#00f2fe';
          if (cat.id === 'pppk') catNeon = '#00f5a0';
          else if (cat.id === 'bumn') catNeon = '#ffb703';
          else if (cat.id === 'sekolah-kedinasan') catNeon = '#ff0055';

          return (
            <div class="cat-card cyber-card glass-panel" style={`--cat-neon: ${catNeon};`}>
              <div class="cat-card-header">
                <span class="cat-icon">{cat.icon}</span>
                <div class="cat-meta-wrap">
                  <span class="badge badge-cpns font-mono">{cat.total_packages} Paket</span>
                  <span class="badge badge-pppk font-mono">{cat.total_subjects} Subtes</span>
                </div>
              </div>

              <h2 class="cat-title">{cat.name}</h2>
              <p class="cat-desc">{cat.description}</p>

              <div class="cat-features cyber-card">
                {cat.id === 'cpns' && (
                  <ul>
                    <li><strong class="font-mono">TWK (30 Soal)</strong>: Passing Grade 65</li>
                    <li><strong class="font-mono">TIU (35 Soal)</strong>: Passing Grade 80</li>
                    <li><strong class="font-mono">TKP (45 Soal)</strong>: Passing Grade 166</li>
                  </ul>
                )}
                {cat.id === 'pppk' && (
                  <ul>
                    <li><strong class="font-mono">Kompetensi Teknis</strong>: Bobot 5 per butir</li>
                    <li><strong class="font-mono">Manajerial & Sosbud</strong>: Skala skor 1-4</li>
                    <li><strong class="font-mono">Wawancara Komputer</strong>: Ambang batas 24</li>
                  </ul>
                )}
                {cat.id === 'bumn' && (
                  <ul>
                    <li><strong class="font-mono">TKD BUMN</strong>: Nilai minimal 58</li>
                    <li><strong class="font-mono">Core Values AKHLAK</strong>: Nilai minimal 65</li>
                    <li><strong class="font-mono">Kurikulum FHCI 2026</strong></li>
                  </ul>
                )}
                {cat.id === 'sekolah-kedinasan' && (
                  <ul>
                    <li><strong class="font-mono">SKD CAT Kedinasan</strong>: Ambang batas BKN</li>
                    <li><strong class="font-mono">TPA Akademik</strong>: IPDN, STAN, STIS</li>
                    <li><strong class="font-mono">Sistem Penalti Soal (-1)</strong></li>
                  </ul>
                )}
              </div>

              <div class="cat-actions">
                <a href={`/kategori/${cat.id}`} class="btn btn-secondary" style="flex: 1;">
                  Silabus Detail
                </a>
                <a href={`/simulasi/${cat.id === 'cpns' ? 'cpns-skd' : cat.id}`} class="btn btn-primary" style="flex: 1;">
                  Mulai Tes →
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</Layout>

<style>
  .category-page-wrapper {
    padding: 60px 0 90px;
  }

  .text-center {
    text-align: center;
  }

  .page-header {
    max-width: 800px;
    margin: 0 auto 50px;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: #ffffff;
    margin: 14px 0 16px;
    letter-spacing: -0.01em;
  }

  .page-subtitle {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 28px;
  }

  .cat-card {
    display: flex;
    flex-direction: column;
    padding: 34px 28px;
    border-radius: var(--radius-md);
    background: rgba(10, 15, 29, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .cat-card:hover {
    transform: translateY(-6px);
    border-color: var(--cat-neon);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6), 0 0 25px rgba(0, 242, 254, 0.15);
  }

  .cat-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  .cat-icon {
    font-size: 2.4rem;
  }

  .cat-meta-wrap {
    display: flex;
    gap: 8px;
  }

  .cat-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 12px;
    transition: color 0.2s ease;
  }

  .cat-card:hover .cat-title {
    color: var(--cat-neon);
  }

  .cat-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 20px;
    flex: 1;
  }

  .cat-features {
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 16px 18px;
    margin-bottom: 26px;
  }

  .cat-features ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cat-features li {
    font-size: 0.84rem;
    color: #94a3b8;
  }

  .cat-features strong {
    color: #ffffff;
  }

  .cat-actions {
    display: flex;
    gap: 12px;
  }
</style>
