---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Portal Otoritas & Autentikasi - SIMCAT 2026">
  <div class="login-page-container">
    <div class="login-glow-bg"></div>

    <div class="container login-wrapper">
      <div class="login-card cyber-card glass-panel">
        <!-- Holographic Scanner Sweep Line -->
        <div class="scanner-sweep-line" aria-hidden="true"></div>

        <!-- Top Banner / Badge -->
        <div class="login-header text-center">
          <div class="login-logo-wrap">
            <div class="logo-cyber-aura"></div>
            <img src="/images/simcat-logo.png" alt="Logo SIMCAT" class="login-brand-img" />
          </div>
          <div class="bkn-badge-pill">
            <span class="badge-dot"></span>
            PORTAL OTORITAS BIOMETRIK SIMCAT 2026
          </div>
          <h1 class="login-title">Autentikasi Akun CAT</h1>
          <p class="login-subtitle">
            Masuk sebagai Peserta Ujian, Reviewer Soal, atau Administrator untuk mengakses ruang simulasi dan konsol manajemen.
          </p>
        </div>

        <!-- Alert Notification Box -->
        <div class="login-alert" id="login-alert-box" style="display: none;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span id="login-alert-text">Silakan verifikasi kredensial untuk melanjutkan ke sesi ujian.</span>
        </div>

        <!-- State Box if Already Logged In -->
        <div class="already-logged-box" id="already-logged-box" style="display: none;">
          <div class="user-active-card cyber-card">
            <div class="active-avatar font-mono" id="active-user-avatar">PS</div>
            <div class="active-info">
              <span class="active-greeting font-mono">[ STATUS: SESI AKTIF TERVERIFIKASI ]</span>
              <h3 class="active-name" id="active-user-name">-</h3>
              <span class="active-meta font-mono" id="active-user-meta">-</span>
            </div>
          </div>
          <div class="active-actions">
            <button class="btn btn-primary btn-block" id="btn-proceed-direct">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
              Lanjutkan ke Halaman Tujuan
            </button>
            <button class="btn btn-secondary btn-block" id="btn-switch-account">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
              </svg>
              Ganti Akun / Keluar
            </button>
          </div>
        </div>

        <!-- Login Form -->
        <form class="login-form" id="login-form">
          <div class="form-group">
            <label for="input-nomor-peserta" class="form-label">
              <span>Email / Nomor Peserta / NIK</span>
              <span class="required-star">*</span>
            </label>
            <div class="input-wrapper">
              <span class="input-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
              </span>
              <input 
                type="text" 
                id="input-nomor-peserta" 
                class="form-control font-mono" 
                placeholder="Contoh: peserta@simcat.id atau NIK KTP" 
                required 
                autocomplete="username"
              />
            </div>
          </div>

          <div class="form-group">
            <label for="input-pin" class="form-label">
              <span>PIN Sesi / Kata Sandi</span>
              <span class="required-star">*</span>
            </label>
            <div class="input-wrapper">
              <span class="input-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
              </span>
              <input 
                type="password" 
                id="input-pin" 
                class="form-control font-mono" 
                placeholder="PIN / Kata Sandi (Demo: simcat2026)" 
                required
                autocomplete="current-password"
              />
            </div>
          </div>

          <div class="form-checkbox-row">
            <label class="checkbox-container">
              <input type="checkbox" id="check-remember" checked />
              <span class="checkmark"></span>
              <span>Ingat sesi terenkripsi di perangkat ini</span>
            </label>
          </div>

          <button type="submit" class="btn btn-primary btn-block btn-lg" id="btn-submit-login">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
              <polyline points="10 17 15 12 10 7"></polyline>
              <line x1="15" y1="12" x2="3" y2="12"></line>
            </svg>
            Otorisasi Masuk Portal
          </button>
        </form>

        <!-- Quick Demo RBAC Section -->
        <div class="quick-demo-section" id="quick-demo-section">
          <div class="divider-text">
            <span>atau pilih akses demo instan</span>
          </div>

          <div class="rbac-demo-grid">
            <button type="button" class="rbac-btn cyber-card" onclick="loginAsDemo('peserta@simcat.id', 'peserta')">
              <span class="rb-icon">👤</span>
              <div class="rb-text">
                <strong>Peserta Ujian (Budi Santoso)</strong>
                <small>Akses Simulasi CAT & Dashboard Skor</small>
              </div>
            </button>

            <button type="button" class="rbac-btn cyber-card" onclick="loginAsDemo('superadmin@simcat.id', 'superadmin')">
              <span class="rb-icon">🛡️</span>
              <div class="rb-text">
                <strong>Super Admin Sistem</strong>
                <small>Kendali Penuh Seluruh Modul Backoffice</small>
              </div>
            </button>

            <button type="button" class="rbac-btn cyber-card" onclick="loginAsDemo('reviewer@simcat.id', 'reviewer')">
              <span class="rb-icon">✍️</span>
              <div class="rb-text">
                <strong>Reviewer Butir Soal</strong>
                <small>Portal Verifikasi & Approval Kunci/Bobot</small>
              </div>
            </button>

            <button type="button" class="rbac-btn cyber-card" onclick="loginAsDemo('editor@simcat.id', 'editor')">
              <span class="rb-icon">📝</span>
              <div class="rb-text">
                <strong>Editor Bank Soal</strong>
                <small>Input Butir Soal & Stimulus HOTS</small>
              </div>
            </button>
          </div>
        </div>

        <!-- Card Footer Notice -->
        <div class="login-footer-notice font-mono">
          <p>
            ℹ️ Sesi dilindungi protokol enkripsi AES-256 dan terhubung langsung ke Server-Authoritative Timer SIMCAT.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  const AUTH_KEY = 'cat_user_session';
  const urlParams = new URLSearchParams(window.location.search);
  const redirectUrl = urlParams.get('redirect') || '';

  // Check existing login session
  function checkCurrentSession() {
    try {
      const raw = localStorage.getItem(AUTH_KEY);
      if (raw) {
        const user = JSON.parse(raw);
        if (user && user.isLoggedIn) {
          const loginForm = document.getElementById('login-form');
          const quickDemo = document.getElementById('quick-demo-section');
          const alreadyLoggedBox = document.getElementById('already-logged-box');
          const activeUserName = document.getElementById('active-user-name');
          const activeUserMeta = document.getElementById('active-user-meta');
          const activeUserAvatar = document.getElementById('active-user-avatar');
          const alertBox = document.getElementById('login-alert-box');
          const alertText = document.getElementById('login-alert-text');

          if (loginForm) loginForm.style.display = 'none';
          if (quickDemo) quickDemo.style.display = 'none';
          if (alreadyLoggedBox) alreadyLoggedBox.style.display = 'block';

          if (activeUserName) activeUserName.textContent = user.name || 'Peserta SIMCAT';
          if (activeUserMeta) activeUserMeta.textContent = `Peran: ${user.roleName || user.role} • ${user.email || user.nomorPeserta}`;
          
          if (activeUserAvatar && user.name) {
            const initials = user.name.split(' ').map(w => w[0]).slice(0, 2).join('').toUpperCase();
            activeUserAvatar.textContent = initials;
          }

          if (alertBox && alertText) {
            alertBox.style.display = 'flex';
            alertBox.style.borderColor = 'rgba(0, 245, 160, 0.4)';
            alertBox.style.background = 'rgba(0, 245, 160, 0.1)';
            alertBox.style.color = '#00f5a0';
            alertText.textContent = `Sesi aktif teridentifikasi: ${user.name} (${user.roleName || user.role}).`;
          }
          return true;
        }
      }
    } catch (e) {}
    return false;
  }

  // Handle Switch Account / Logout
  document.getElementById('btn-switch-account')?.addEventListener('click', () => {
    localStorage.removeItem(AUTH_KEY);
    window.dispatchEvent(new Event('auth-state-changed'));
    window.location.reload();
  });

  // Handle Direct Proceed
  document.getElementById('btn-proceed-direct')?.addEventListener('click', () => {
    try {
      const user = JSON.parse(localStorage.getItem(AUTH_KEY) || '{}');
      if (redirectUrl) {
        window.location.href = redirectUrl;
      } else if (['superadmin', 'admin', 'reviewer', 'editor'].includes(user.role)) {
        window.location.href = '/admin';
      } else {
        window.location.href = '/dashboard';
      }
    } catch (e) {
      window.location.href = '/dashboard';
    }
  });

  // Handle Server Authentication
  async function executeLogin(identifier, password) {
    const submitBtn = document.getElementById('btn-submit-login');
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = `<span>Memverifikasi Kredensial Server...</span>`;
    }

    try {
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ identifier, password })
      });

      const data = await res.json();
      if (data.success && data.user) {
        if (typeof window.playCyberSound === 'function') {
          window.playCyberSound('chime');
        }
        localStorage.setItem(AUTH_KEY, JSON.stringify(data.user));
        window.dispatchEvent(new Event('auth-state-changed'));

        let dest = redirectUrl;
        if (!dest) {
          if (['superadmin', 'admin', 'reviewer', 'editor'].includes(data.user.role)) {
            dest = '/admin';
          } else {
            dest = '/dashboard';
          }
        }
        window.location.href = dest;
      } else {
        alert(data.error || 'Autentikasi gagal. Silakan periksa kembali data Anda.');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Otorisasi Masuk Portal';
        }
      }
    } catch (err) {
      alert('Terjadi kendala koneksi ke server autentikasi.');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Otorisasi Masuk Portal';
      }
    }
  }

  // Form Submit Handler
  document.getElementById('login-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const identifier = document.getElementById('input-nomor-peserta').value.trim();
    const pin = document.getElementById('input-pin').value.trim();
    executeLogin(identifier, pin);
  });

  // Demo Login Helper
  window.loginAsDemo = function (email, role) {
    if (typeof window.playCyberSound === 'function') {
      window.playCyberSound('click');
    }
    executeLogin(email, 'simcat2026');
  };

  // Init
  checkCurrentSession();
</script>

<style>
  .login-page-container {
    min-height: calc(100vh - 74px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 50px 16px;
    position: relative;
    overflow: hidden;
  }

  .login-glow-bg {
    position: absolute;
    top: 30%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 700px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 242, 254, 0.15) 0%, rgba(168, 85, 247, 0.08) 50%, transparent 70%);
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  .login-wrapper {
    position: relative;
    z-index: 1;
    max-width: 560px;
  }

  .login-card {
    padding: 42px 36px;
    border-radius: var(--radius-lg);
    background: rgba(8, 12, 24, 0.9);
    border: 1px solid rgba(0, 242, 254, 0.25);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7), 0 0 35px rgba(0, 242, 254, 0.15);
    position: relative;
    overflow: hidden;
  }

  /* Animated Scanner Sweep Line */
  .scanner-sweep-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, transparent, #00f2fe, #a855f7, transparent);
    box-shadow: 0 0 10px #00f2fe;
    animation: scanlineMove 6s linear infinite;
    pointer-events: none;
    z-index: 10;
  }

  .login-logo-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 22px;
    position: relative;
  }

  .logo-cyber-aura {
    position: absolute;
    width: 140px;
    height: 70px;
    background: radial-gradient(circle, rgba(0, 242, 254, 0.3) 0%, transparent 70%);
    filter: blur(15px);
    pointer-events: none;
  }

  .login-brand-img {
    max-height: 85px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 8px 24px rgba(0, 242, 254, 0.35));
    position: relative;
    z-index: 2;
  }

  .login-title {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 8px;
    color: #ffffff;
  }

  .login-subtitle {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.55;
    margin-bottom: 26px;
  }

  .login-alert {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 183, 3, 0.12);
    border: 1px solid rgba(255, 183, 3, 0.4);
    color: #ffb703;
    padding: 12px 18px;
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    margin-bottom: 24px;
    box-shadow: 0 0 15px rgba(255, 183, 3, 0.15);
  }

  .already-logged-box {
    margin-bottom: 20px;
  }

  .user-active-card {
    display: flex;
    align-items: center;
    gap: 16px;
    background: rgba(0, 245, 160, 0.06);
    border: 1px solid rgba(0, 245, 160, 0.3);
    border-radius: var(--radius-md);
    padding: 18px;
    margin-bottom: 18px;
  }

  .active-avatar {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    background: linear-gradient(135deg, #00f2fe 0%, #0072ff 100%);
    color: #ffffff;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    flex-shrink: 0;
    box-shadow: 0 0 15px rgba(0, 242, 254, 0.4);
  }

  .active-info {
    flex-grow: 1;
  }

  .active-greeting {
    font-size: 0.72rem;
    color: #00f5a0;
    display: block;
    font-weight: 700;
  }

  .active-name {
    font-size: 1.2rem;
    color: #ffffff;
    margin: 2px 0;
  }

  .active-meta {
    font-size: 0.8rem;
    color: #94a3b8;
  }

  .active-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-label {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    font-weight: 600;
    color: #cbd5e1;
  }

  .required-star {
    color: #ff0055;
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon {
    position: absolute;
    left: 14px;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: color 0.2s ease;
  }

  .form-control {
    width: 100%;
    padding: 13px 14px 13px 44px;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-sm);
    color: #ffffff;
    font-size: 0.95rem;
    transition: all 0.25s ease;
  }

  .form-control:focus {
    outline: none;
    border-color: #00f2fe;
    box-shadow: 0 0 0 3px rgba(0, 242, 254, 0.25), 0 0 15px rgba(0, 242, 254, 0.2);
    background: rgba(15, 23, 42, 0.9);
  }

  .input-wrapper:focus-within .input-icon {
    color: #00f2fe;
  }

  .form-checkbox-row {
    display: flex;
    align-items: center;
    margin: 4px 0 8px;
  }

  .checkbox-container {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.84rem;
    color: var(--text-muted);
    cursor: pointer;
  }

  .btn-block {
    width: 100%;
  }

  .btn-lg {
    height: 50px;
    font-size: 1.02rem;
  }

  .quick-demo-section {
    margin-top: 26px;
  }

  .divider-text {
    position: relative;
    text-align: center;
    margin: 20px 0;
  }

  .divider-text::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
    z-index: 0;
  }

  .divider-text span {
    position: relative;
    z-index: 1;
    background: #080c18;
    padding: 0 14px;
    font-size: 0.73rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-family: var(--font-mono);
  }

  .rbac-demo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .rbac-btn {
    padding: 13px;
    border-radius: 10px;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    text-align: left;
    transition: all 0.25s ease;
  }

  .rbac-btn:hover {
    background: rgba(15, 23, 42, 0.95);
    border-color: rgba(0, 242, 254, 0.5);
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5), 0 0 15px rgba(0, 242, 254, 0.2);
  }

  .rb-icon {
    font-size: 1.35rem;
    flex-shrink: 0;
  }

  .rb-text strong {
    display: block;
    color: #ffffff;
    font-size: 0.82rem;
    margin-bottom: 2px;
  }

  .rb-text small {
    display: block;
    color: #94a3b8;
    font-size: 0.7rem;
    line-height: 1.3;
  }

  .login-footer-notice {
    margin-top: 26px;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    font-size: 0.75rem;
    color: #64748b;
    line-height: 1.5;
    text-align: center;
  }

  @media (max-width: 640px) {
    .rbac-demo-grid {
      grid-template-columns: 1fr;
    }
    .login-card {
      padding: 30px 20px;
    }
  }
</style>
