---
import Layout from '../layouts/Layout.astro';
import { queryAll } from '../db';

const categories = queryAll(`SELECT id, name, description, icon FROM exam_categories WHERE is_active = 1 ORDER BY sort_order ASC`);

const packages = queryAll(`
  SELECT 
    p.id, p.slug, p.title, p.category_id, p.scoring_rule_id,
    p.duration_minutes, p.total_questions, p.is_free, p.price,
    p.description,
    c.name as category_name,
    r.name as scoring_rule_name, r.reference_source,
    (SELECT COUNT(*) FROM package_questions WHERE package_id = p.id) as mapped_questions,
    (SELECT COUNT(*) FROM exam_attempts WHERE package_id = p.id) as attempt_count
  FROM exam_packages p
  JOIN exam_categories c ON p.category_id = c.id
  JOIN scoring_rules r ON p.scoring_rule_id = r.id
  WHERE p.status = 'published'
  ORDER BY p.id ASC
`);
---

<Layout title="Katalog Paket Ujian CAT Nasional - SIMCAT 2026">
  <div class="katalog-page-wrapper">
    <div class="container">
      <div class="katalog-header text-center">
        <div class="bkn-badge-pill">
          <span class="badge-dot"></span>
          STANDAR CAT BKN & NASIONAL 2026
        </div>
        <h1 class="page-title">Katalog Paket Simulasi Ujian</h1>
        <p class="page-subtitle">
          Pilih modul tryout terstandarisasi untuk menguji kesiapan seleksi CPNS, PPPK, BUMN, dan Kedinasan dengan kalkulasi ambang batas otomatis.
        </p>
      </div>

      <!-- Category Filter Pills -->
      <div class="category-filter-row">
        <button class="cat-pill active font-mono" data-filter="all">Semua Paket ({packages.length})</button>
        {categories.map((c) => (
          <button class="cat-pill font-mono" data-filter={c.id}>
            {c.icon} {c.name}
          </button>
        ))}
      </div>

      <!-- Packages Grid -->
      <div class="packages-grid">
        {packages.map((pkg) => (
          <div class="pkg-card cyber-card glass-panel" data-category={pkg.category_id}>
            <div class="pkg-card-top">
              <span class="pkg-category-tag font-mono">[ {pkg.category_name} ]</span>
              <span class={`pkg-free-tag font-mono ${pkg.is_free ? 'tag-free' : 'tag-pro'}`}>
                {pkg.is_free ? 'GRATIS' : 'PREMIUM'}
              </span>
            </div>

            <h3 class="pkg-title">{pkg.title}</h3>
            <p class="pkg-desc">{pkg.description || 'Simulasi ujian CAT interaktif sesuai format BKN.'}</p>

            <div class="pkg-meta-grid">
              <div class="pmg-item">
                <span class="pmg-label font-mono">⏱️ Durasi:</span>
                <span class="pmg-val font-mono">{pkg.duration_minutes} Menit</span>
              </div>
              <div class="pmg-item">
                <span class="pmg-label font-mono">❓ Jumlah Soal:</span>
                <span class="pmg-val font-mono">{pkg.total_questions} Butir</span>
              </div>
              <div class="pmg-item">
                <span class="pmg-label font-mono">🎯 Ambang Batas:</span>
                <span class="pmg-val text-cyan font-mono">{pkg.scoring_rule_name}</span>
              </div>
              <div class="pmg-item">
                <span class="pmg-label font-mono">👥 Telah Diikuti:</span>
                <span class="pmg-val text-green font-mono">{pkg.attempt_count} Peserta</span>
              </div>
            </div>

            <div class="pkg-legal-note font-mono">
              Rujukan Resmi: {pkg.reference_source}
            </div>

            <div class="pkg-card-actions">
              <a href={`/pembahasan/${pkg.slug}`} class="btn btn-secondary">
                Lihat Kunci
              </a>
              <a href={`/simulasi/${pkg.slug}`} class="btn btn-primary">
                Mulai Ujian CAT
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>

<style>
  .katalog-page-wrapper {
    padding: 50px 0 90px;
  }

  .katalog-header {
    max-width: 720px;
    margin: 0 auto 40px;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 12px;
  }

  .page-subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .category-filter-row {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 38px;
    flex-wrap: wrap;
  }

  .cat-pill {
    padding: 9px 20px;
    border-radius: var(--radius-full);
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.09);
    color: #94a3b8;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .cat-pill:hover {
    color: #ffffff;
    background: rgba(30, 41, 59, 0.85);
    border-color: rgba(0, 242, 254, 0.35);
    transform: translateY(-2px);
  }

  .cat-pill.active {
    background: linear-gradient(135deg, #00f2fe 0%, #0072ff 100%);
    color: #ffffff;
    border-color: transparent;
    box-shadow: 0 0 20px rgba(0, 242, 254, 0.4);
    transform: translateY(-2px);
  }

  .packages-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  .pkg-card {
    padding: 30px;
    border-radius: var(--radius-md);
    background: rgba(10, 15, 29, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .pkg-card:hover {
    transform: translateY(-6px);
    border-color: rgba(0, 242, 254, 0.4);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6), 0 0 25px rgba(0, 242, 254, 0.2);
  }

  .pkg-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }

  .pkg-category-tag {
    font-size: 0.76rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 6px;
    background: rgba(0, 242, 254, 0.08);
    border: 1px solid rgba(0, 242, 254, 0.25);
    color: #38bdf8;
  }

  .pkg-free-tag {
    font-size: 0.72rem;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: var(--radius-full);
  }

  .tag-free {
    background: rgba(0, 245, 160, 0.15);
    color: #00f5a0;
    border: 1px solid rgba(0, 245, 160, 0.4);
    box-shadow: 0 0 10px rgba(0, 245, 160, 0.2);
  }

  .tag-pro {
    background: rgba(255, 183, 3, 0.15);
    color: #ffb703;
    border: 1px solid rgba(255, 183, 3, 0.4);
    box-shadow: 0 0 10px rgba(255, 183, 3, 0.2);
  }

  .pkg-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 8px;
    transition: color 0.2s ease;
  }

  .pkg-card:hover .pkg-title {
    color: #00f2fe;
  }

  .pkg-desc {
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.55;
    margin: 0 0 20px;
  }

  .pkg-meta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding: 16px;
    border-radius: var(--radius-sm);
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.06);
    margin-bottom: 16px;
    font-size: 0.82rem;
  }

  .pmg-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .pmg-label {
    color: #64748b;
    font-size: 0.72rem;
  }

  .pmg-val {
    color: #ffffff;
    font-weight: 700;
  }

  .text-cyan { color: #00f2fe !important; }
  .text-green { color: #00f5a0 !important; }

  .pkg-legal-note {
    font-size: 0.73rem;
    color: #64748b;
    margin-bottom: 22px;
  }

  .pkg-card-actions {
    display: flex;
    gap: 12px;
    justify-content: flex-end;
  }

  @media (max-width: 820px) {
    .packages-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  (function () {
    const pills = document.querySelectorAll('.cat-pill');
    const cards = document.querySelectorAll('.pkg-card');

    pills.forEach((p) => {
      p.addEventListener('click', () => {
        if (typeof window.playCyberSound === 'function') {
          window.playCyberSound('click');
        }
        pills.forEach((b) => b.classList.remove('active'));
        p.classList.add('active');

        const filter = p.getAttribute('data-filter');
        cards.forEach((c) => {
          if (filter === 'all' || c.getAttribute('data-category') === filter) {
            c.style.display = 'flex';
          } else {
            c.style.display = 'none';
          }
        });
      });
    });
  })();
</script>
