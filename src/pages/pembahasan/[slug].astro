---
import Layout from '../../layouts/Layout.astro';
import { allPackages, getExamPackageBySlug, type ExamPackage } from '../../data';
import { queryOne, queryAll } from '../../db';

const { slug } = Astro.params;
let pkg: any = getExamPackageBySlug(slug as string);

if (!pkg) {
  const dbPkg = queryOne(`
    SELECT p.*, c.name as category_name
    FROM exam_packages p
    JOIN exam_categories c ON p.category_id = c.id
    WHERE p.slug = ?
  `, [slug]);

  if (dbPkg) {
    const dbQuestions = queryAll(`
      SELECT q.id, q.question_text, q.stimulus_text, s.code as subtest_code, s.name as subtest_name
      FROM package_questions pq
      JOIN questions q ON pq.question_id = q.id
      JOIN subjects s ON q.subject_id = s.id
      WHERE pq.package_id = ?
      ORDER BY pq.sequence_order ASC
    `, [dbPkg.id]);

    const questionsWithOptions = dbQuestions.map((q) => {
      const options = queryAll(`SELECT option_key, option_text, is_correct, score_weight FROM question_options WHERE question_id = ? ORDER BY option_key ASC`, [q.id]);
      const exp = queryOne(`SELECT explanation_text, quick_trick, reference_source FROM question_explanations WHERE question_id = ?`, [q.id]);
      const correctOpt = options.find((o: any) => o.is_correct === 1) || options[0];

      return {
        id: q.id,
        subtestCode: q.subtest_code,
        subtestName: q.subtest_name,
        text: q.question_text,
        stimulus: q.stimulus_text,
        options: options.map((o: any) => ({ key: o.option_key, text: o.option_text, score: o.score_weight })),
        correctAnswer: correctOpt ? correctOpt.option_key : 'A',
        explanation: exp ? exp.explanation_text : 'Pembahasan terverifikasi sesuai regulasi resmi.',
        quickTrick: exp?.quick_trick || '',
        reference: exp?.reference_source || ''
      };
    });

    pkg = {
      slug: dbPkg.slug,
      title: dbPkg.title,
      category: dbPkg.category_name,
      badgeClass: 'badge-cpns',
      yearEdition: 'Edisi 2026',
      durationMinutes: dbPkg.duration_minutes,
      passingGrades: [
        { code: 'TWK', name: 'Tes Wawasan Kebangsaan', minScore: 65, maxScore: 150 },
        { code: 'TIU', name: 'Tes Inteligensi Umum', minScore: 80, maxScore: 175 },
        { code: 'TKP', name: 'Tes Karakteristik Pribadi', minScore: 166, maxScore: 225 }
      ],
      questions: questionsWithOptions
    };
  }
}

if (!pkg) {
  return Astro.redirect('/simulasi');
}
---

<Layout title={`Kunci Jawaban & Pembahasan: ${pkg.title} - SIMCAT 2026`}>
  <div class="study-page-wrapper">
    <div class="container">
      <!-- Breadcrumb & Header -->
      <div class="study-header">
        <a href="/" class="back-link font-mono">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          Kembali ke Beranda
        </a>
        <div class="header-content">
          <div class="header-tags">
            <span class={`badge ${pkg.badgeClass}`}>
              <span class="badge-dot"></span>
              {pkg.category}
            </span>
            <span class="edition-tag font-mono">[ {pkg.yearEdition} ]</span>
          </div>
          <h1 class="study-title">Kunci Jawaban & Pembahasan Lengkap</h1>
          <p class="study-subtitle font-mono">{pkg.title} • {pkg.questions.length} Butir Soal Terverifikasi</p>
        </div>

        <div class="study-cta-box cyber-card glass-panel">
          <div class="cta-info">
            <span class="cta-label">Siap Menguji Kemampuan di Ruang CAT?</span>
            <span class="cta-desc">Lakukan simulasi resmi dengan sistem waktu nyata dan kalkulasi ambang batas otomatis.</span>
          </div>
          <a href={`/simulasi/${pkg.slug}`} class="btn btn-primary" id="btn-start-from-study">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            Mulai Simulasi CAT
          </a>
        </div>
      </div>

      <!-- Filter Subtes -->
      <div class="filter-controls-bar">
        <div class="filter-pills" id="filter-pills">
          <button class="filter-pill active font-mono" data-filter="all">Semua Soal ({pkg.questions.length})</button>
          {pkg.passingGrades.map((pg) => (
            <button class="filter-pill font-mono" data-filter={pg.code}>
              {pg.name} ({pg.code})
            </button>
          ))}
        </div>
        <div class="search-input-wrapper cyber-card">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="search-question-input" class="font-mono" placeholder="Cari materi soal (mis: Pancasila, deret, silogisme)..." />
        </div>
      </div>

      <!-- Question Cards List -->
      <div class="questions-list" id="questions-list-container">
        {pkg.questions.map((q: any, idx: number) => (
          <article class="study-question-card cyber-card glass-panel" data-subtest={q.subtestCode || q.subtest} data-search={`${q.text || q.questionText} ${q.explanation} ${q.subtestName || q.subtestLabel}`.toLowerCase()}>
            <div class="sq-header">
              <div class="sq-number-box">
                <span class="sq-index font-mono">#{String(idx + 1).padStart(2, '0')}</span>
                <span class="sq-subtest font-mono">[ {q.subtestCode || q.subtest} • {q.subtestName || q.subtestLabel} ]</span>
              </div>
              <div class="sq-answer-badge">
                <span class="sq-ans-lbl font-mono">KUNCI JAWABAN:</span>
                <span class="sq-ans-key font-mono">{q.correctAnswer}</span>
              </div>
            </div>

            <div class="sq-text">
              {q.text || q.questionText}
            </div>

            <!-- Options -->
            <div class="sq-options">
              {q.options.map((opt: any) => {
                const isCorrect = opt.key === q.correctAnswer;
                return (
                  <div class={`sq-option-item ${isCorrect ? 'correct' : ''}`}>
                    <div class="sq-opt-key font-mono">{opt.key}</div>
                    <div class="sq-opt-text">{opt.text}</div>
                    <div class="sq-opt-score font-mono">
                      Bobot: <strong>{opt.score ?? (isCorrect ? 5 : 0)}</strong>
                    </div>
                  </div>
                );
              })}
            </div>

            <!-- Explanation Box -->
            <div class="sq-explanation-box cyber-card">
              <div class="exp-title font-mono">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                [ ANALISIS & PEMBAHASAN RESMI ]
              </div>
              <div class="exp-content">
                {q.explanation}
              </div>

              {(q.quickTrick || q.tipsTrick) && (
                <div class="sq-tips-box cyber-card">
                  <span class="tips-badge font-mono">💡 TRIK CEPAT & TIPS HOTS BKN:</span>
                  <p class="tips-text">{q.quickTrick || q.tipsTrick}</p>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</Layout>

<style>
  .study-page-wrapper {
    padding: 50px 0 90px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 700;
    color: #94a3b8;
    margin-bottom: 22px;
    transition: all 0.2s;
  }

  .back-link:hover {
    color: #00f2fe;
    transform: translateX(-4px);
  }

  .study-header {
    margin-bottom: 38px;
  }

  .header-tags {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .edition-tag {
    font-size: 0.78rem;
    color: var(--text-dim);
    background: rgba(255, 255, 255, 0.04);
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .study-title {
    font-size: 2.3rem;
    font-weight: 800;
    margin-bottom: 8px;
    color: #ffffff;
  }

  .study-subtitle {
    font-size: 1rem;
    color: #38bdf8;
    margin-bottom: 26px;
  }

  .study-cta-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 28px;
    background: rgba(8, 12, 24, 0.85);
    border: 1px solid rgba(0, 242, 254, 0.28);
    border-radius: var(--radius-lg);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6), 0 0 25px rgba(0, 242, 254, 0.15);
    flex-wrap: wrap;
    gap: 18px;
  }

  .cta-label {
    display: block;
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
  }

  .cta-desc {
    font-size: 0.9rem;
    color: #94a3b8;
  }

  /* Filter Controls */
  .filter-controls-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 34px;
    flex-wrap: wrap;
  }

  .filter-pills {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .filter-pill {
    padding: 9px 18px;
    border-radius: var(--radius-full);
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.09);
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-pill:hover {
    color: #ffffff;
    background: rgba(30, 41, 59, 0.85);
    border-color: rgba(0, 242, 254, 0.35);
  }

  .filter-pill.active {
    background: linear-gradient(135deg, #00f2fe 0%, #0072ff 100%);
    color: #ffffff;
    border-color: transparent;
    box-shadow: 0 0 20px rgba(0, 242, 254, 0.4);
  }

  .search-input-wrapper {
    position: relative;
    min-width: 320px;
  }

  .search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #64748b;
  }

  .search-input-wrapper input {
    width: 100%;
    padding: 11px 16px 11px 42px;
    border-radius: var(--radius-full);
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #ffffff;
    font-size: 0.88rem;
    outline: none;
    transition: all 0.25s ease;
  }

  .search-input-wrapper input:focus {
    border-color: #00f2fe;
    box-shadow: 0 0 20px rgba(0, 242, 254, 0.3);
  }

  /* Question Cards */
  .questions-list {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .study-question-card {
    padding: 30px;
    border-radius: var(--radius-md);
    background: rgba(10, 15, 29, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .sq-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    margin-bottom: 18px;
  }

  .sq-number-box {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .sq-index {
    font-size: 1.25rem;
    font-weight: 800;
    color: #00f2fe;
    text-shadow: 0 0 10px rgba(0, 242, 254, 0.35);
  }

  .sq-subtest {
    font-size: 0.82rem;
    color: #94a3b8;
    font-weight: 700;
  }

  .sq-answer-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(0, 245, 160, 0.12);
    border: 1px solid rgba(0, 245, 160, 0.4);
    padding: 4px 14px;
    border-radius: var(--radius-full);
    box-shadow: 0 0 12px rgba(0, 245, 160, 0.2);
  }

  .sq-ans-lbl {
    font-size: 0.72rem;
    color: #00f5a0;
    font-weight: 700;
  }

  .sq-ans-key {
    font-size: 1.15rem;
    font-weight: 800;
    color: #ffffff;
  }

  .sq-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #f8fafc;
    margin-bottom: 22px;
    white-space: pre-line;
  }

  .sq-options {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 22px;
  }

  .sq-option-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 12px 18px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }

  .sq-option-item.correct {
    background: rgba(0, 245, 160, 0.08);
    border-color: rgba(0, 245, 160, 0.4);
    box-shadow: 0 0 15px rgba(0, 245, 160, 0.15);
  }

  .sq-opt-key {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.88rem;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .sq-option-item.correct .sq-opt-key {
    background: #00f5a0;
    color: #062b1b;
    border-color: #00f5a0;
    box-shadow: 0 0 10px rgba(0, 245, 160, 0.4);
  }

  .sq-opt-text {
    flex: 1;
    font-size: 0.95rem;
    color: #e2e8f0;
  }

  .sq-opt-score {
    font-size: 0.8rem;
    color: #64748b;
  }

  .sq-option-item.correct .sq-opt-score strong {
    color: #00f5a0;
  }

  .sq-explanation-box {
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-sm);
    padding: 20px;
  }

  .exp-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.84rem;
    font-weight: 700;
    color: #00f2fe;
    margin-bottom: 10px;
    letter-spacing: 0.04em;
  }

  .exp-content {
    font-size: 0.95rem;
    line-height: 1.65;
    color: #cbd5e1;
    margin-bottom: 14px;
  }

  .sq-tips-box {
    background: rgba(255, 183, 3, 0.08);
    border-left: 3px solid #ffb703;
    padding: 12px 16px;
    border-radius: 0 8px 8px 0;
    box-shadow: 0 0 15px rgba(255, 183, 3, 0.1);
  }

  .tips-badge {
    display: block;
    font-size: 0.72rem;
    font-weight: 800;
    color: #ffb703;
    margin-bottom: 4px;
    letter-spacing: 0.05em;
  }

  .tips-text {
    font-size: 0.88rem;
    color: #fef3c7;
    line-height: 1.55;
  }
</style>

<script is:inline>
  (function () {
    const filterPills = document.querySelectorAll('.filter-pill');
    const searchInput = document.getElementById('search-question-input');
    const cards = document.querySelectorAll('.study-question-card');

    let currentFilter = 'all';
    let searchQuery = '';

    function applyFilterAndSearch() {
      cards.forEach((card) => {
        const subtest = card.getAttribute('data-subtest');
        const searchCorpus = card.getAttribute('data-search') || '';

        const matchFilter = currentFilter === 'all' || subtest === currentFilter;
        const matchSearch = searchQuery === '' || searchCorpus.includes(searchQuery.toLowerCase());

        if (matchFilter && matchSearch) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    }

    filterPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        if (typeof window.playCyberSound === 'function') {
          window.playCyberSound('click');
        }
        filterPills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');
        currentFilter = pill.getAttribute('data-filter') || 'all';
        applyFilterAndSearch();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target.value || '').trim();
        applyFilterAndSearch();
      });
    }
  })();
</script>
