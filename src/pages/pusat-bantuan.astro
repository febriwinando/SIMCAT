---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    cat: 'teknis',
    q: 'Apa yang terjadi jika koneksi internet terputus di tengah-tengah simulasi ujian?',
    a: 'Jangan panik! Seluruh jawaban yang telah Anda klik tersimpan secara realtime di database server SIMCAT. Ketika koneksi internet Anda kembali pulih, Anda dapat membuka kembali halaman simulasi atau me-refresh halaman, dan lembar jawaban Anda akan otomatis sinkron kembali sesuai nomor terakhir yang Anda kerjakan.'
  },
  {
    cat: 'teknis',
    q: 'Apakah timer ujian tetap berjalan jika saya menutup browser?',
    a: 'Ya. Mesin CAT SIMCAT menggunakan Server-Authoritative Timer yang berjalan di server pusat untuk menjamin integritas simulasi realistis seperti ujian CAT BKN yang sesungguhnya. Waktu akan terus berkurang hingga batas durasi tercapai.'
  },
  {
    cat: 'nilai',
    q: 'Bagaimana cara perhitungan nilai TKP, TWK, dan TIU pada simulasi CPNS SKD?',
    a: 'Sesuai regulasi KepmenPAN-RB No. 321/2024: Pada subtes TWK dan TIU, setiap jawaban benar bernilai +5 dan jawaban salah bernilai 0. Pada subtes TKP, seluruh pilihan A hingga E memiliki bobot nilai berjenjang 1, 2, 3, 4, dan 5 (tidak ada minus).'
  },
  {
    cat: 'nilai',
    q: 'Kapan saya dapat melihat kunci jawaban dan pembahasan lengkap?',
    a: 'Demi menjaga validitas pengujian, kunci jawaban dan pembahasan trik cepat baru dapat diakses setelah Anda menekan tombol "Selesai Ujian" dan status sesi Anda ter-finalisasi (graded). Anda dapat melihatnya di halaman Scorecard atau menu Pembahasan.'
  },
  {
    cat: 'akun',
    q: 'Apakah hasil tryout saya dapat dilihat kembali di lain hari?',
    a: 'Tentu saja. Seluruh sesi ujian yang telah Anda selesaikan tersimpan secara permanen pada tab "Riwayat Ujian" di Dashboard Akun Anda, lengkap dengan rincian skor per subtes, durasi waktu, dan rasio akurasi.'
  },
  {
    cat: 'paket',
    q: 'Apakah paket tryout gratis memiliki batas waktu kedaluwarsa?',
    a: 'Paket Dasar Gratis dapat diakses kapan saja tanpa batas masa aktif. Untuk paket Tryout Akbar Nasional atau keanggotaan VIP, Anda akan mendapatkan akses ke bank soal HOTS eksklusif dan live leaderboard perangkingan nasional.'
  }
];
---

<Layout title="Pusat Bantuan & Helpdesk - SIMCAT 2026">
  <div class="bantuan-page-wrapper">
    <div class="container">
      <div class="bantuan-header text-center">
        <div class="bkn-badge-pill">
          <span class="badge-dot pulse-dot-green"></span>
          STATUS LAYANAN: 100% OPERASIONAL
        </div>
        <h1 class="page-title">Pusat Solusi & FAQ Peserta</h1>
        <p class="page-subtitle">
          Temukan jawaban instan seputar tata cara pengerjaan ujian CAT, kebijakan penilaian resmi, dan pemecahan kendala teknis simulasi.
        </p>

        <!-- Live Instant Search Terminal -->
        <div class="search-terminal-wrap">
          <div class="search-input-box cyber-card">
            <span class="search-icon">🔍</span>
            <input 
              type="text" 
              id="faq-search-input" 
              class="search-input font-mono" 
              placeholder="Ketik kata kunci pertanyaan (misal: koneksi, timer, passing grade)..." 
            />
          </div>
        </div>
      </div>

      <!-- FAQ Container -->
      <div class="faq-container cyber-card glass-panel">
        <div class="faq-header-bar">
          <span class="font-mono text-cyan">[ BASIS PENGETAHUAN & DIAGNOSTIK ]</span>
          <span class="font-mono text-dim" id="faq-count-label">6 TOPIK TERSEDIA</span>
        </div>

        <div class="faq-list" id="faq-list">
          {faqs.map((faq, idx) => (
            <div class="faq-card cyber-card" id={`faq-${idx}`} data-keywords={`${faq.q} ${faq.a}`.toLowerCase()}>
              <button class="faq-question-btn" onclick={`toggleFaq(${idx})`}>
                <span class="fq-title">{faq.q}</span>
                <span class="fq-arrow font-mono" id={`arrow-${idx}`}>▼</span>
              </button>
              <div class="faq-answer-panel" id={`answer-${idx}`} style="display: none;">
                <p>{faq.a}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Support Contact Cards -->
      <div class="contact-support-grid">
        <div class="contact-box cyber-card glass-panel">
          <div class="cb-icon">💬</div>
          <h3>Helpdesk WhatsApp Layanan</h3>
          <p>Butuh konfirmasi kendala ujian atau aktivasi paket secara cepat? Tim teknis kami siap memandu Anda.</p>
          <a href="https://wa.me/6281234567890?text=Halo%20Admin%20SIMCAT%2C%20saya%20memerlukan%20bantuan" target="_blank" class="btn btn-primary" style="margin-top: 16px;">
            Hubungi Helpdesk WhatsApp ↗
          </a>
        </div>

        <div class="contact-box cyber-card glass-panel">
          <div class="cb-icon">📧</div>
          <h3>Konsultasi Tim Akademik</h3>
          <p>Pertanyaan seputar validasi butir soal, rujukan regulasi, atau sanggahan kunci jawaban ditangani oleh dewan reviewer.</p>
          <a href="mailto:support@simcat.id" class="btn btn-secondary" style="margin-top: 16px;">
            Kirim Surel ke support@simcat.id ↗
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .bantuan-page-wrapper {
    padding: 50px 0 90px;
  }

  .bantuan-header {
    max-width: 760px;
    margin: 0 auto 40px;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 12px;
  }

  .page-subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0 0 28px;
  }

  .search-terminal-wrap {
    max-width: 600px;
    margin: 0 auto;
  }

  .search-input-box {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 20px;
    border-radius: var(--radius-full);
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(0, 242, 254, 0.35);
    box-shadow: 0 0 20px rgba(0, 242, 254, 0.15);
    transition: all 0.25s ease;
  }

  .search-input-box:focus-within {
    border-color: #00f2fe;
    box-shadow: 0 0 25px rgba(0, 242, 254, 0.35);
    background: rgba(15, 23, 42, 0.95);
  }

  .search-icon {
    font-size: 1.1rem;
    color: #00f2fe;
  }

  .search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #ffffff;
    font-size: 0.9rem;
  }

  .search-input::placeholder {
    color: #64748b;
  }

  .faq-container {
    padding: 34px;
    border-radius: var(--radius-lg);
    background: rgba(10, 15, 29, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 45px;
  }

  .faq-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 22px;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .text-cyan { color: #00f2fe; }
  .text-dim { color: #64748b; }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .faq-card {
    border-radius: 12px;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.06);
    overflow: hidden;
    transition: all 0.25s ease;
  }

  .faq-card:hover {
    border-color: rgba(0, 242, 254, 0.3);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
  }

  .faq-question-btn {
    width: 100%;
    padding: 20px 22px;
    background: transparent;
    border: none;
    color: #ffffff;
    text-align: left;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.45;
    gap: 16px;
  }

  .fq-arrow {
    color: #00f2fe;
    font-size: 0.85rem;
    transition: transform 0.25s ease;
  }

  .faq-answer-panel {
    padding: 0 22px 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }

  .faq-answer-panel p {
    color: #cbd5e1;
    font-size: 0.94rem;
    line-height: 1.65;
    margin: 14px 0 0;
  }

  .contact-support-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .contact-box {
    padding: 32px;
    border-radius: var(--radius-md);
    background: rgba(10, 15, 29, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .contact-box:hover {
    transform: translateY(-5px);
    border-color: rgba(0, 242, 254, 0.35);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5), 0 0 20px rgba(0, 242, 254, 0.15);
  }

  .cb-icon {
    font-size: 2.2rem;
    margin-bottom: 14px;
  }

  .contact-box h3 {
    color: #ffffff;
    font-size: 1.25rem;
    margin: 0 0 8px;
  }

  .contact-box p {
    color: #94a3b8;
    font-size: 0.9rem;
    line-height: 1.55;
    margin: 0;
  }

  @media (max-width: 768px) {
    .contact-support-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  window.toggleFaq = function (idx) {
    if (typeof window.playCyberSound === 'function') {
      window.playCyberSound('click');
    }
    const panel = document.getElementById(`answer-${idx}`);
    const arrow = document.getElementById(`arrow-${idx}`);
    if (panel.style.display === 'none') {
      panel.style.display = 'block';
      arrow.textContent = '▲';
    } else {
      panel.style.display = 'none';
      arrow.textContent = '▼';
    }
  };

  // Instant FAQ Realtime Filter
  const searchInput = document.getElementById('faq-search-input');
  const faqCards = document.querySelectorAll('.faq-card');
  const countLabel = document.getElementById('faq-count-label');

  if (searchInput) {
    searchInput.addEventListener('input', function () {
      const q = this.value.trim().toLowerCase();
      let matchCount = 0;

      faqCards.forEach((card) => {
        const keywords = card.getAttribute('data-keywords') || '';
        if (!q || keywords.includes(q)) {
          card.style.display = 'block';
          matchCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (countLabel) {
        countLabel.textContent = `${matchCount} TOPIK TERSEDIA`;
      }
    });
  }
</script>
