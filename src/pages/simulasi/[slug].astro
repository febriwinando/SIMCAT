---
import Layout from '../../layouts/Layout.astro';
import { queryOne } from '../../db';
import '../../styles/exam.css';

const { slug } = Astro.params;

// Fetch package details from the database
const pkg = queryOne(`
  SELECT 
    p.*,
    sr.name as scoring_rule_name,
    sr.rules_json,
    sr.reference_source,
    c.name as category_name,
    c.icon as category_icon
  FROM exam_packages p
  JOIN scoring_rules sr ON p.scoring_rule_id = sr.id
  JOIN exam_categories c ON p.category_id = c.id
  WHERE p.slug = ?
`, [slug]);

if (!pkg) {
  return Astro.redirect('/kategori');
}

const scoringRule = JSON.parse(pkg.rules_json || '{}');
const subtestsList = scoringRule.subtests ? Object.values(scoringRule.subtests) : [];
---

<Layout title={`${pkg.title} - SIMCAT 2026`} isExam={true}>
  <div 
    class="exam-viewport" 
    id="exam-app" 
    data-slug={pkg.slug}
    data-title={pkg.title}
    data-category={pkg.category_name}
    data-duration={pkg.duration_minutes}
    data-total={pkg.total_questions}
  >
    <!-- Topbar CAT -->
    <header class="exam-topbar">
      <div class="exam-topbar-inner">
        <div class="exam-candidate-info">
          <div class="candidate-avatar" style="padding: 3px; display: flex; align-items: center; justify-content: center;">
            <img src="/images/simcat-icon.png" alt="SIMCAT" style="width: 28px; height: 28px; object-fit: contain;" />
          </div>
          <div class="candidate-details">
            <span class="candidate-name" id="display-candidate-name">Calon Peserta SIMCAT</span>
            <span class="candidate-pin">NO. UJIAN: 2026-SIMCAT-{pkg.category_id.toUpperCase()}-{pkg.slug.toUpperCase()}</span>
          </div>
        </div>

        <div class="timer-container" id="timer-box">
          <div class="timer-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <div class="timer-text-group">
            <span class="timer-label">Sisa Waktu</span>
            <span class="timer-digits" id="timer-display">--:--:--</span>
          </div>
        </div>

        <!-- Server Autosave Sync Indicator -->
        <div class="save-indicator" id="save-indicator">
          <span class="save-dot" id="save-dot"></span>
          <span id="save-status-text">Sinkron Server</span>
        </div>

        <div class="exam-header-controls">
          <div class="font-size-control">
            <button class="font-btn" id="btn-font-sm" title="Font Lebih Kecil">A-</button>
            <button class="font-btn" id="btn-font-md" title="Font Normal">A</button>
            <button class="font-btn" id="btn-font-lg" title="Font Lebih Besar">A+</button>
          </div>
          <button class="sound-toggle-btn" id="btn-sound-toggle" title="Toggle Efek Suara">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" id="sound-icon-on">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
            </svg>
          </button>
          <a href="/" class="btn-exit-exam" id="btn-exit-exam" title="Kembali ke Beranda">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
            <span>Keluar</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Offline Alert Banner -->
    <div class="exam-offline-banner" id="exam-offline-banner">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="1" y1="1" x2="23" y2="23"></line>
        <path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55"></path>
        <path d="M5 12.55a10.94 10.94 0 0 1 5.17-2.39"></path>
        <path d="M10.71 5.05A16 16 0 0 1 22.58 9"></path>
        <path d="M1.42 9a15.91 15.91 0 0 1 4.7-2.88"></path>
        <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
        <line x1="12" y1="20" x2="12.01" y2="20"></line>
      </svg>
      <span>Koneksi internet terputus! Jawaban Anda tetap aman di browser dan akan disinkronkan otomatis saat online kembali.</span>
    </div>

    <!-- Time Warning Toast Banner -->
    <div class="exam-toast-banner" id="time-toast" style="display: none;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <span id="time-toast-text">Peringatan Waktu</span>
    </div>

    <!-- Main Workspace -->
    <div class="exam-body font-md" id="exam-body-area">
      <!-- Question Panel (Left) -->
      <section class="question-panel glass-panel">
        <div class="question-meta">
          <div class="question-number-badge">
            <span class="q-num" id="q-number-text">Soal No. 1</span>
            <span class="badge badge-cpns" id="q-subtest-badge">Subtes</span>
          </div>
          <div class="progress-status-badge">
            <span id="q-progress-text">1 / {pkg.total_questions}</span>
          </div>
        </div>

        <div class="question-content">
          <!-- Stimulus Reading Passage (if available) -->
          <div class="stimulus-box" id="stimulus-container" style="display: none;"></div>

          <div class="question-text" id="q-text-container">
            Menghubungkan ke server SIMCAT...
          </div>

          <div class="options-list" id="options-container">
            <!-- Dynamic Options Injected via JS -->
          </div>

          <!-- Hotkey Keyboard Helper Bar -->
          <div class="hotkey-guide-bar">
            <div class="hotkey-items-group">
              <span class="hotkey-item"><span class="hotkey-kbd">A</span>-<span class="hotkey-kbd">E</span> / <span class="hotkey-kbd">1</span>-<span class="hotkey-kbd">5</span> Opsi</span>
              <span class="hotkey-item"><span class="hotkey-kbd">←</span> <span class="hotkey-kbd">→</span> Navigasi</span>
              <span class="hotkey-item"><span class="hotkey-kbd">R</span> Ragu</span>
              <span class="hotkey-item"><span class="hotkey-kbd">Del</span> Hapus</span>
            </div>
            <span style="font-size: 0.68rem; color: #94a3b8; font-weight: 600;">⌨️ Hotkeys Aktif</span>
          </div>
        </div>

        <!-- Action Bar -->
        <div class="exam-actions-bar">
          <button class="btn btn-secondary" id="btn-prev" disabled>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
            Sebelumnya
          </button>

          <button class="btn btn-ragu" id="btn-doubtful">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            <span id="btn-doubtful-text">Ragu-Ragu</span>
          </button>

          <button class="btn btn-clear-choice" id="btn-clear-choice" title="Hapus pilihan jawaban pada soal ini" disabled>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            </svg>
            <span>Hapus Pilihan</span>
          </button>

          <div class="action-nav-group">
            <button class="btn btn-primary" id="btn-next">
              Simpan & Lanjutkan
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
            <button class="btn btn-danger" id="btn-finish-trigger">
              Selesai Ujian
            </button>
          </div>
        </div>
      </section>

      <!-- Palette Panel (Right) -->
      <aside class="palette-panel glass-panel">
        <div class="palette-header">
          <h3 class="palette-title">Navigasi Nomor Soal</h3>
          <span class="palette-total" id="palette-total-badge">{pkg.total_questions} Soal</span>
        </div>

        <!-- Filter Subtest & Status -->
        <div class="palette-filter-section">
          <div class="palette-filter-label">
            <span>Lompat Subtes:</span>
            <span id="palette-filtered-count" style="color: #2563eb; font-weight: 700;">Semua</span>
          </div>
          <div class="palette-subtest-pills" id="subtest-pills-container">
            <button type="button" class="filter-pill active" data-subtest="all">Semua</button>
          </div>
          <div class="palette-filter-label" style="margin-top: 4px;">
            <span>Filter Status:</span>
          </div>
          <div class="palette-status-pills" id="status-pills-container">
            <button type="button" class="filter-pill active" data-status="all">Semua</button>
            <button type="button" class="filter-pill" data-status="answered">Dijawab</button>
            <button type="button" class="filter-pill" data-status="doubtful">Ragu (?)</button>
            <button type="button" class="filter-pill" data-status="skipped">Dilewati (!)</button>
            <button type="button" class="filter-pill" data-status="unvisited">Belum</button>
          </div>
        </div>

        <div class="palette-grid-wrapper">
          <div class="palette-grid" id="palette-grid">
            <!-- Dynamic number tiles injected via JS -->
          </div>
        </div>

        <div class="palette-legend">
          <div class="legend-item">
            <span class="legend-box answered">✓</span>
            <span>Dijawab (<strong id="count-answered">0</strong>)</span>
          </div>
          <div class="legend-item">
            <span class="legend-box doubtful">?</span>
            <span>Ragu-Ragu (<strong id="count-doubtful">0</strong>)</span>
          </div>
          <div class="legend-item">
            <span class="legend-box skipped">!</span>
            <span>Dilewati (<strong id="count-skipped">0</strong>)</span>
          </div>
          <div class="legend-item">
            <span class="legend-box unvisited"></span>
            <span>Belum (<strong id="count-unvisited">{pkg.total_questions}</strong>)</span>
          </div>
        </div>

        <div class="palette-footer-active-hint">
          <span class="active-indicator-swatch"></span>
          <span>Bingkai Biru = Sedang Dibuka</span>
        </div>
      </aside>
    </div>

    <!-- Modal Petunjuk Sebelum Ujian (Pre-Exam Instruction) -->
    <div class="modal-overlay" id="pre-exam-modal" style="display: flex;">
      <div class="modal-card" style="max-width: 620px;">
        <div class="modal-header">
          <div class="bkn-badge-pill" style="margin-bottom: 10px;">
            <span class="badge-dot"></span>
            PETUNJUK RESMI SIMCAT 2026
          </div>
          <h2 class="modal-title">{pkg.title}</h2>
          <p class="modal-subtitle">
            Harap baca petunjuk tata tertib dan sistem penilaian sebelum menekan tombol mulai.
          </p>
        </div>

        <div class="disclaimer-banner">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <div>
            <strong>Pemberitahuan Transparansi:</strong>
            SIMCAT adalah platform pembelajaran dan simulasi mandiri, bukan penyelenggara seleksi resmi pemerintah/BKN. Nilai merupakan indikator latihan kesiapan peserta.
          </div>
        </div>

        <div class="pre-exam-box">
          <div style="font-weight: 700; margin-bottom: 8px; color: #0f172a;">Ketentuan Pelaksanaan Ujian:</div>
          <ul class="instruction-list">
            <li>Durasi ujian: <strong>{pkg.duration_minutes} Menit</strong> (dihitung oleh server resmi).</li>
            <li>Jumlah butir soal: <strong>{pkg.total_questions} Butir Soal</strong>.</li>
            <li>Jawaban Anda otomatis disimpan (*autosave*) secara berkala ke database server.</li>
            <li>Gunakan tombol <strong>Ragu-Ragu</strong> bila Anda ingin meninjau kembali jawaban sebelum mengakhiri ujian.</li>
            <li>Jika timer mencapai 00:00:00, sistem secara otomatis mengunci (*auto-submit*) dan menghitung nilai.</li>
          </ul>

          {subtestsList.length > 0 && (
            <div style="margin-top: 14px; padding-top: 12px; border-top: 1px dashed #cbd5e1;">
              <div style="font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px;">Ambang Batas (Passing Grade) Referensi:</div>
              <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                {subtestsList.map((st: any) => (
                  <span class="badge badge-cpns" style="font-size: 0.78rem;">
                    {st.name}: Ambang Batas {st.passingGrade}
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>

        <label class="agreement-label">
          <input type="checkbox" id="check-agreement" style="width: 18px; height: 18px; cursor: pointer;" />
          <span>Saya telah membaca, memahami petunjuk, dan siap memulai simulasi.</span>
        </label>

        <div class="modal-footer">
          <a href="/kategori" class="btn btn-secondary" style="flex: 1;">Kembali</a>
          <button class="btn btn-primary" style="flex: 1;" id="btn-start-exam" disabled>
            Mulai Ujian Sekarang →
          </button>
        </div>
      </div>
    </div>

    <!-- Modal Konfirmasi Selesai Ujian -->
    <div class="modal-overlay" id="confirm-modal" style="display: none;">
      <div class="modal-card">
        <button type="button" class="modal-close-btn" id="btn-close-confirm-modal" aria-label="Tutup dan periksa kembali" title="Batal / Periksa Kembali">&times;</button>
        <div class="modal-header">
          <div id="confirm-modal-badge" class="bkn-badge-pill" style="display: none; margin: 0 auto 10px auto;">
            <span class="badge-dot"></span>
            SEMUA SOAL TERISI
          </div>
          <h3 class="modal-title" id="confirm-modal-title">Konfirmasi Selesai Ujian</h3>
          <p class="modal-subtitle" id="confirm-modal-subtitle">
            Apakah Anda yakin ingin mengakhiri simulasi ujian ini? Nilai akan segera dihitung secara otoritatif oleh server.
          </p>
        </div>

        <div class="modal-summary-stats">
          <div>
            <div class="summary-stat-val green" id="modal-answered-val">0</div>
            <div class="stat-sublabel">DIJAWAB</div>
          </div>
          <div>
            <div class="summary-stat-val yellow" id="modal-doubtful-val">0</div>
            <div class="stat-sublabel">RAGU-RAGU</div>
          </div>
          <div>
            <div class="summary-stat-val red" id="modal-skipped-val">0</div>
            <div class="stat-sublabel">DILEWATI</div>
          </div>
          <div>
            <div class="summary-stat-val gray" id="modal-unvisited-val">{pkg.total_questions}</div>
            <div class="stat-sublabel">BELUM DIBUKA</div>
          </div>
        </div>

        <div class="modal-footer">
          <button class="btn btn-secondary" style="flex: 1;" id="btn-cancel-finish">
            ← Batal / Periksa Kembali
          </button>
          <button class="btn btn-danger" style="flex: 1;" id="btn-confirm-finish">
            Ya, Selesaikan & Hitung Nilai
          </button>
        </div>
      </div>
    </div>

    <!-- Modal Hasil Nilai Lengkap (Scorecard) -->
    <div class="modal-overlay" id="result-modal" style="display: none;">
      <div class="modal-card" style="max-width: 680px;">
        <div class="modal-header">
          <div id="result-status-badge" style="margin-bottom: 12px;"></div>
          <h2 class="modal-title" id="result-title">Hasil Simulasi SIMCAT</h2>
          <p id="result-subtitle" class="modal-subtitle"></p>
        </div>

        <div class="result-score-highlight">
          <div class="rsh-col">
            <span class="rsh-label">Total Nilai Anda</span>
            <div id="result-total-score" class="rsh-score">0</div>
          </div>
          <div class="rsh-divider"></div>
          <div class="rsh-col">
            <span class="rsh-label">Status Kelulusan</span>
            <div id="result-pass-status" class="rsh-status">-</div>
          </div>
        </div>

        <!-- Subtest Breakdown Progress Bars -->
        <div id="result-subtests-container">
          <!-- Subtests breakdown injected via JS -->
        </div>

        <!-- Smart Recommendations -->
        <div id="result-recommendations-box" style="margin-bottom: 20px; text-align: left; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px;">
          <div style="font-weight: 700; color: #0f172a; margin-bottom: 6px; font-size: 0.9rem;">Rekomendasi Evaluasi Belajar:</div>
          <ul id="recommendations-list" style="padding-left: 18px; font-size: 0.84rem; color: #475569; line-height: 1.6;"></ul>
        </div>

        <div class="modal-footer" style="flex-wrap: wrap;">
          <a href={`/pembahasan/${pkg.slug}`} class="btn btn-primary" style="flex: 1;" id="btn-view-explanation">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
            </svg>
            Buka Pembahasan Lengkap
          </a>
          <button class="btn btn-secondary" style="flex: 1;" id="btn-retry-exam">Ulangi Simulasi</button>
          <a href="/riwayat" class="btn btn-secondary" style="width: 100%;">Lihat Riwayat & Grafik Skor</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { getUserSession } from '../../utils/auth';

  interface OptionItem {
    key: string;
    text: string;
    mediaUrl?: string | null;
  }

  interface ExamQuestion {
    id: number;
    sequenceOrder: number;
    subjectId: string;
    subtestCode: string;
    subtestName: string;
    stimulusText?: string | null;
    questionText: string;
    mediaUrl?: string | null;
    options: OptionItem[];
  }

  (function initExamEngine() {
    const appEl = document.getElementById('exam-app') as HTMLElement;
    if (!appEl) return;

    const packageSlug = appEl.dataset.slug || 'cpns-skd';
    const userSession = getUserSession();
    const userId = userSession ? userSession.id : 17;

    // Display Candidate Name
    const displayCandidateName = document.getElementById('display-candidate-name');
    if (displayCandidateName && userSession) {
      displayCandidateName.textContent = userSession.name;
    }

    // State Variables
    let attemptUuid = '';
    let questions: ExamQuestion[] = [];
    let currentIndex = 0;
    let answers: Record<number, string | null> = {};
    let doubtful: Record<number, boolean> = {};
    let visited: Record<number, boolean> = {};
    let sequenceCounter = 1;
    let timerInterval: any = null;
    let heartbeatInterval: any = null;
    let remainingSeconds = 0;
    let soundEnabled = true;
    let autoAdvanceTimer: any = null;
    let allAnsweredPromptShown = false;
    let isExamActive = false;

    // Filter states
    let activeSubtestFilter = 'all';
    let activeStatusFilter = 'all';

    // Elements
    const preExamModal = document.getElementById('pre-exam-modal');
    const checkAgreement = document.getElementById('check-agreement') as HTMLInputElement;
    const btnStartExam = document.getElementById('btn-start-exam') as HTMLButtonElement;
    const confirmModal = document.getElementById('confirm-modal');
    const confirmModalBadge = document.getElementById('confirm-modal-badge');
    const confirmModalTitle = document.getElementById('confirm-modal-title');
    const confirmModalSubtitle = document.getElementById('confirm-modal-subtitle');
    const btnCloseConfirmModal = document.getElementById('btn-close-confirm-modal');
    const resultModal = document.getElementById('result-modal');

    const qNumText = document.getElementById('q-number-text');
    const qSubtestBadge = document.getElementById('q-subtest-badge');
    const qProgressText = document.getElementById('q-progress-text');
    const stimulusContainer = document.getElementById('stimulus-container');
    const qTextContainer = document.getElementById('q-text-container');
    const optionsContainer = document.getElementById('options-container');

    const btnPrev = document.getElementById('btn-prev') as HTMLButtonElement;
    const btnNext = document.getElementById('btn-next') as HTMLButtonElement;
    const btnDoubtful = document.getElementById('btn-doubtful') as HTMLButtonElement;
    const btnClearChoice = document.getElementById('btn-clear-choice') as HTMLButtonElement;
    const btnFinishTrigger = document.getElementById('btn-finish-trigger');
    const btnCancelFinish = document.getElementById('btn-cancel-finish');
    const btnConfirmFinish = document.getElementById('btn-confirm-finish');
    const btnRetryExam = document.getElementById('btn-retry-exam');

    const timerDisplay = document.getElementById('timer-display');
    const paletteGrid = document.getElementById('palette-grid');
    const countAnswered = document.getElementById('count-answered');
    const countDoubtful = document.getElementById('count-doubtful');
    const countSkipped = document.getElementById('count-skipped');
    const countUnvisited = document.getElementById('count-unvisited');
    const saveDot = document.getElementById('save-dot');
    const saveStatusText = document.getElementById('save-status-text');

    const subtestPillsContainer = document.getElementById('subtest-pills-container');
    const statusPillsContainer = document.getElementById('status-pills-container');
    const paletteFilteredCount = document.getElementById('palette-filtered-count');
    const timeToast = document.getElementById('time-toast');
    const timeToastText = document.getElementById('time-toast-text');
    const offlineBanner = document.getElementById('exam-offline-banner');
    const btnSoundToggle = document.getElementById('btn-sound-toggle');
    const soundIconOn = document.getElementById('sound-icon-on');

    // 1. Audio Synthesizer (Web Audio API)
    let audioCtx: any = null;
    function getAudioContext() {
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
        if (AudioContextClass) audioCtx = new AudioContextClass();
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      return audioCtx;
    }

    function playTone(freq = 520, type: OscillatorType = 'sine', duration = 0.08) {
      if (!soundEnabled) return;
      try {
        const ctx = getAudioContext();
        if (!ctx) return;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, ctx.currentTime);
        gain.gain.setValueAtTime(0.06, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + duration);
      } catch (e) {}
    }

    function playAlertChime() {
      if (!soundEnabled) return;
      playTone(523.25, 'triangle', 0.12);
      setTimeout(() => playTone(659.25, 'triangle', 0.18), 120);
    }

    // Sound toggle state & storage
    const savedSound = localStorage.getItem('simcat_sound_enabled');
    if (savedSound !== null) {
      soundEnabled = savedSound === 'true';
    }
    updateSoundUI();

    function updateSoundUI() {
      if (!btnSoundToggle) return;
      if (soundEnabled) {
        btnSoundToggle.style.color = '#2563eb';
        btnSoundToggle.title = 'Efek Suara: Aktif';
      } else {
        btnSoundToggle.style.color = '#94a3b8';
        btnSoundToggle.title = 'Efek Suara: Hening';
      }
    }

    if (btnSoundToggle) {
      btnSoundToggle.addEventListener('click', () => {
        soundEnabled = !soundEnabled;
        localStorage.setItem('simcat_sound_enabled', String(soundEnabled));
        updateSoundUI();
        if (soundEnabled) playTone(587.33, 'sine', 0.1);
      });
    }

    // Time Warning Toast
    let toastTimeout: any = null;
    function showTimeToast(msg: string, isDanger = false) {
      if (!timeToast || !timeToastText) return;
      timeToastText.textContent = msg;
      timeToast.className = 'exam-toast-banner' + (isDanger ? ' danger' : '');
      timeToast.style.display = 'flex';
      playAlertChime();
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        timeToast.style.display = 'none';
      }, 7000);
    }

    // Online/Offline Listeners
    window.addEventListener('offline', () => {
      if (offlineBanner) offlineBanner.style.display = 'flex';
      setSaveStatus('error', 'Koneksi terputus');
    });

    window.addEventListener('online', () => {
      if (offlineBanner) offlineBanner.style.display = 'none';
      setSaveStatus('success', 'Online kembali');
    });

    // Accidental Tab Close Protection
    window.addEventListener('beforeunload', (e) => {
      if (isExamActive) {
        e.preventDefault();
        e.returnValue = '';
        return '';
      }
    });

    // Enable Start Button on Agreement
    if (checkAgreement && btnStartExam) {
      checkAgreement.addEventListener('change', () => {
        btnStartExam.disabled = !checkAgreement.checked;
      });

      btnStartExam.addEventListener('click', async () => {
        btnStartExam.disabled = true;
        btnStartExam.textContent = 'Memulai Sesi...';
        await launchExamSession();
      });
    }

    // Launch Session from Server API
    async function launchExamSession() {
      try {
        setSaveStatus('saving', 'Menyiapkan sesi...');
        const resp = await fetch('/api/exam/start', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ packageSlug, userId })
        });
        const res = await resp.json();

        if (!res.success) {
          alert('Gagal memulai simulasi: ' + (res.error || 'Server error'));
          if (btnStartExam) {
            btnStartExam.disabled = false;
            btnStartExam.textContent = 'Coba Lagi';
          }
          return;
        }

        const data = res.data;
        attemptUuid = data.attemptUuid;
        questions = data.questions;
        remainingSeconds = data.remainingSeconds;
        isExamActive = true;

        // Restore existing answers if resumed
        if (data.existingAnswers) {
          for (const [qIdStr, ans] of Object.entries<any>(data.existingAnswers)) {
            const qId = Number(qIdStr);
            if (ans.selectedKey) answers[qId] = ans.selectedKey;
            if (ans.isDoubtful) doubtful[qId] = true;
            visited[qId] = true;
          }
        }

        if (preExamModal) preExamModal.style.display = 'none';

        initPalette();
        initSubtestFilterPills();
        renderQuestion(0);
        startTimer();
        startHeartbeat();
        setSaveStatus('success', 'Tersimpan di server');
      } catch (err: any) {
        console.error('Launch exam error:', err);
        alert('Terjadi kesalahan jaringan saat memulai ujian.');
      }
    }

    function setSaveStatus(state: 'success' | 'saving' | 'error', text: string) {
      if (!saveDot || !saveStatusText) return;
      saveDot.className = 'save-dot ' + (state === 'saving' ? 'saving' : state === 'error' ? 'error' : '');
      saveStatusText.textContent = text;
    }

    // Server-Locked Timer
    function startTimer() {
      if (timerInterval) clearInterval(timerInterval);

      function updateClock() {
        if (remainingSeconds <= 0) {
          clearInterval(timerInterval);
          if (timerDisplay) timerDisplay.textContent = '00:00:00';
          autoSubmitOnExpire();
          return;
        }

        // 5-minute and 1-minute alert triggers
        if (remainingSeconds === 300) {
          showTimeToast('⚠️ Waktu tersisa 5 Menit! Mohon periksa kembali jawaban ragu-ragu Anda.', false);
        } else if (remainingSeconds === 60) {
          showTimeToast('🚨 Waktu tersisa 1 Menit! Sistem akan otomatis mengunci saat timer habis.', true);
        }

        const h = Math.floor(remainingSeconds / 3600);
        const m = Math.floor((remainingSeconds % 3600) / 60);
        const s = remainingSeconds % 60;

        if (timerDisplay) {
          timerDisplay.textContent = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
          if (remainingSeconds <= 300) {
            timerDisplay.classList.add('warning');
          }
        }
        remainingSeconds--;
      }

      updateClock();
      timerInterval = setInterval(updateClock, 1000);
    }

    // Periodic Heartbeat
    function startHeartbeat() {
      if (heartbeatInterval) clearInterval(heartbeatInterval);
      heartbeatInterval = setInterval(async () => {
        if (!attemptUuid) return;
        try {
          const resp = await fetch('/api/exam/heartbeat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ attemptUuid })
          });
          const json = await resp.json();
          if (json.success) {
            if (json.isExpired) {
              autoSubmitOnExpire();
            } else if (Math.abs(remainingSeconds - json.remainingSeconds) > 3) {
              remainingSeconds = json.remainingSeconds;
            }
          }
        } catch (e) {}
      }, 30000);
    }

    function autoSubmitOnExpire() {
      isExamActive = false;
      alert('Waktu ujian telah berakhir! Sistem otomatis mengunci dan menghitung nilai Anda.');
      finishExam(true);
    }

    // Render Question
    function renderQuestion(index: number) {
      if (!questions || index < 0 || index >= questions.length) return;
      currentIndex = index;
      const q = questions[currentIndex];
      visited[q.id] = true;

      if (qNumText) qNumText.textContent = `Soal No. ${currentIndex + 1}`;
      if (qSubtestBadge) qSubtestBadge.textContent = q.subtestName || q.subtestCode;
      if (qProgressText) qProgressText.textContent = `${currentIndex + 1} / ${questions.length}`;

      // Stimulus
      if (stimulusContainer) {
        if (q.stimulusText) {
          stimulusContainer.style.display = 'block';
          stimulusContainer.innerHTML = `<div class="stimulus-title">Bacaan / Stimulus Soal:</div><p>${q.stimulusText}</p>`;
        } else {
          stimulusContainer.style.display = 'none';
        }
      }

      // Question Text
      if (qTextContainer) {
        qTextContainer.textContent = q.questionText;
      }

      // Options
      if (optionsContainer) {
        optionsContainer.innerHTML = '';
        const currentAns = answers[q.id];

        q.options.forEach((opt) => {
          const btn = document.createElement('button');
          btn.className = `option-item ${currentAns === opt.key ? 'selected' : ''}`;
          btn.innerHTML = `
            <span class="option-key">${opt.key}</span>
            <span class="option-text">${opt.text}</span>
          `;
          btn.addEventListener('click', () => {
            selectOption(q.id, opt.key);
          });
          optionsContainer.appendChild(btn);
        });
      }

      // Clear Choice button state
      if (btnClearChoice) {
        btnClearChoice.disabled = !answers[q.id];
      }

      // Doubtful state
      if (btnDoubtful) {
        if (doubtful[q.id]) {
          btnDoubtful.classList.add('active');
        } else {
          btnDoubtful.classList.remove('active');
        }
      }

      // Prev button disabled on first
      if (btnPrev) btnPrev.disabled = currentIndex === 0;

      updatePaletteUI();
    }

    // Option Selection & Server Autosave
    async function selectOption(questionId: number, key: string) {
      answers[questionId] = key;
      playTone(600, 'sine', 0.05);
      renderQuestion(currentIndex);
      updateCounts();

      // Send to server in background
      sequenceCounter++;
      setSaveStatus('saving', 'Menyimpan...');

      fetch('/api/exam/save-answer', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          attemptUuid,
          questionId,
          selectedOptionKey: key,
          isDoubtful: Boolean(doubtful[questionId]),
          sequence: sequenceCounter
        })
      })
      .then(res => res.json())
      .then(res => {
        if (res.success) {
          setSaveStatus('success', 'Tersimpan di server');
        } else if (res.isExpired) {
          autoSubmitOnExpire();
        } else {
          setSaveStatus('error', 'Gagal simpan');
        }
      })
      .catch(() => {
        setSaveStatus('error', 'Koneksi terganggu');
      });

      // Clear any pending transition
      if (autoAdvanceTimer) clearTimeout(autoAdvanceTimer);

      // Check if ALL questions are now filled
      const totalQ = questions.length;
      const filledCount = questions.filter(q => answers[q.id] != null && answers[q.id] !== '').length;
      const isAllFilled = totalQ > 0 && filledCount === totalQ;

      if (isAllFilled && !allAnsweredPromptShown) {
        allAnsweredPromptShown = true;
        autoAdvanceTimer = setTimeout(() => {
          openFinishModal(true);
        }, 280);
      } else if (currentIndex < questions.length - 1) {
        // Auto-advance directly to the next question
        autoAdvanceTimer = setTimeout(() => {
          renderQuestion(currentIndex + 1);
        }, 220);
      }
    }

    // Clear Option (Hapus Pilihan)
    async function clearOption(questionId: number) {
      if (!answers[questionId]) return;
      answers[questionId] = null;
      playTone(400, 'sine', 0.08);
      renderQuestion(currentIndex);
      updateCounts();

      sequenceCounter++;
      setSaveStatus('saving', 'Menghapus pilihan...');

      fetch('/api/exam/save-answer', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          attemptUuid,
          questionId,
          selectedOptionKey: null,
          isDoubtful: Boolean(doubtful[questionId]),
          sequence: sequenceCounter
        })
      })
      .then(res => res.json())
      .then(res => {
        if (res.success) {
          setSaveStatus('success', 'Pilihan dihapus');
        } else if (res.isExpired) {
          autoSubmitOnExpire();
        } else {
          setSaveStatus('error', 'Gagal simpan');
        }
      })
      .catch(() => {
        setSaveStatus('error', 'Koneksi terganggu');
      });
    }

    if (btnClearChoice) {
      btnClearChoice.addEventListener('click', () => {
        const q = questions[currentIndex];
        if (q && answers[q.id]) {
          clearOption(q.id);
        }
      });
    }

    // Toggle Doubtful
    if (btnDoubtful) {
      btnDoubtful.addEventListener('click', async () => {
        const q = questions[currentIndex];
        if (!q) return;
        doubtful[q.id] = !doubtful[q.id];
        playTone(doubtful[q.id] ? 480 : 380, 'sine', 0.06);
        renderQuestion(currentIndex);
        updateCounts();

        // Save doubtful state to server
        sequenceCounter++;
        try {
          await fetch('/api/exam/save-answer', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              attemptUuid,
              questionId: q.id,
              selectedOptionKey: answers[q.id] || null,
              isDoubtful: doubtful[q.id],
              sequence: sequenceCounter
            })
          });
        } catch (e) {}
      });
    }

    // Navigation Buttons
    if (btnPrev) {
      btnPrev.addEventListener('click', () => {
        if (currentIndex > 0) renderQuestion(currentIndex - 1);
      });
    }

    if (btnNext) {
      btnNext.addEventListener('click', () => {
        if (currentIndex < questions.length - 1) {
          renderQuestion(currentIndex + 1);
        } else {
          openFinishModal();
        }
      });
    }

    // Palette Generator
    function initPalette() {
      if (!paletteGrid) return;
      paletteGrid.innerHTML = '';

      questions.forEach((q, idx) => {
        const tile = document.createElement('button');
        tile.className = 'palette-tile';
        tile.id = `palette-tile-${q.id}`;
        tile.textContent = String(idx + 1);
        tile.setAttribute('data-subtest', q.subtestCode || q.subtestName || '');
        tile.setAttribute('data-index', String(idx));
        tile.addEventListener('click', () => {
          renderQuestion(idx);
        });
        paletteGrid.appendChild(tile);
      });
      updatePaletteUI();
      updateCounts();
    }

    // Dynamic Subtest Quick Filter Pills
    function initSubtestFilterPills() {
      if (!subtestPillsContainer) return;
      const subtestSet = new Set<string>();
      questions.forEach(q => {
        const code = q.subtestCode || q.subtestName;
        if (code) subtestSet.add(code);
      });

      // Keep 'Semua' pill
      subtestPillsContainer.innerHTML = '<button type="button" class="filter-pill active" data-subtest="all">Semua</button>';

      subtestSet.forEach(stCode => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'filter-pill';
        btn.setAttribute('data-subtest', stCode);
        btn.textContent = stCode;
        subtestPillsContainer.appendChild(btn);
      });

      // Subtest pill clicks
      subtestPillsContainer.querySelectorAll('.filter-pill').forEach(btn => {
        btn.addEventListener('click', () => {
          subtestPillsContainer.querySelectorAll('.filter-pill').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          activeSubtestFilter = btn.getAttribute('data-subtest') || 'all';
          applyPaletteFilters();

          // Jump to first question of this subtest
          if (activeSubtestFilter !== 'all') {
            const firstIdx = questions.findIndex(q => (q.subtestCode === activeSubtestFilter || q.subtestName === activeSubtestFilter));
            if (firstIdx !== -1) {
              renderQuestion(firstIdx);
            }
          }
        });
      });

      // Status pill clicks
      if (statusPillsContainer) {
        statusPillsContainer.querySelectorAll('.filter-pill').forEach(btn => {
          btn.addEventListener('click', () => {
            statusPillsContainer.querySelectorAll('.filter-pill').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            activeStatusFilter = btn.getAttribute('data-status') || 'all';
            applyPaletteFilters();
          });
        });
      }
    }

    function applyPaletteFilters() {
      let visibleCount = 0;
      questions.forEach((q) => {
        const tile = document.getElementById(`palette-tile-${q.id}`);
        if (!tile) return;

        // Subtest match
        const matchesSubtest = activeSubtestFilter === 'all' ||
          q.subtestCode === activeSubtestFilter ||
          q.subtestName === activeSubtestFilter;

        // Status match
        let matchesStatus = true;
        if (activeStatusFilter === 'answered') {
          matchesStatus = !!answers[q.id] && !doubtful[q.id];
        } else if (activeStatusFilter === 'doubtful') {
          matchesStatus = !!doubtful[q.id];
        } else if (activeStatusFilter === 'skipped') {
          matchesStatus = !!visited[q.id] && !answers[q.id] && !doubtful[q.id];
        } else if (activeStatusFilter === 'unvisited') {
          matchesStatus = !visited[q.id];
        }

        if (matchesSubtest && matchesStatus) {
          tile.classList.remove('filtered-out');
          visibleCount++;
        } else {
          tile.classList.add('filtered-out');
        }
      });

      if (paletteFilteredCount) {
        if (activeSubtestFilter === 'all' && activeStatusFilter === 'all') {
          paletteFilteredCount.textContent = `${questions.length} Soal`;
        } else {
          paletteFilteredCount.textContent = `${visibleCount} dari ${questions.length} Soal`;
        }
      }
    }

    function updatePaletteUI() {
      questions.forEach((q, idx) => {
        const tile = document.getElementById(`palette-tile-${q.id}`);
        if (!tile) return;

        let cls = 'palette-tile';
        if (idx === currentIndex) cls += ' active';

        if (doubtful[q.id]) {
          cls += ' doubtful';
        } else if (answers[q.id]) {
          cls += ' answered';
        } else if (visited[q.id]) {
          cls += ' skipped';
        } else {
          cls += ' unvisited';
        }

        if (tile.classList.contains('filtered-out')) {
          cls += ' filtered-out';
        }

        tile.className = cls;
      });
      applyPaletteFilters();
    }

    function updateCounts() {
      let ansCount = 0;
      let doubtCount = 0;
      let skipCount = 0;
      let unvisitCount = 0;

      questions.forEach((q) => {
        if (doubtful[q.id]) {
          doubtCount++;
        } else if (answers[q.id]) {
          ansCount++;
        } else if (visited[q.id]) {
          skipCount++;
        } else {
          unvisitCount++;
        }
      });

      if (countAnswered) countAnswered.textContent = String(ansCount);
      if (countDoubtful) countDoubtful.textContent = String(doubtCount);
      if (countSkipped) countSkipped.textContent = String(skipCount);
      if (countUnvisited) countUnvisited.textContent = String(unvisitCount);

      // Modal summary stats
      const mAns = document.getElementById('modal-answered-val');
      const mDoubt = document.getElementById('modal-doubtful-val');
      const mSkip = document.getElementById('modal-skipped-val');
      const mUnvisit = document.getElementById('modal-unvisited-val');
      if (mAns) mAns.textContent = String(ansCount);
      if (mDoubt) mDoubt.textContent = String(doubtCount);
      if (mSkip) mSkip.textContent = String(skipCount);
      if (mUnvisit) mUnvisit.textContent = String(unvisitCount);
    }

    // Keyboard Shortcuts (Standard CAT BKN Hotkeys)
    window.addEventListener('keydown', (e) => {
      // Do nothing if typing inside an input or if modal is active
      const activeTag = (document.activeElement?.tagName || '').toLowerCase();
      if (activeTag === 'input' || activeTag === 'textarea') return;

      if (
        (preExamModal && preExamModal.style.display !== 'none') ||
        (confirmModal && confirmModal.style.display === 'flex') ||
        (resultModal && resultModal.style.display === 'flex')
      ) {
        if (e.key === 'Escape' && confirmModal && confirmModal.style.display === 'flex') {
          closeFinishModal();
        }
        return;
      }

      const q = questions[currentIndex];
      if (!q) return;

      const keyUpper = e.key.toUpperCase();

      // 1. Select Option: A, B, C, D, E or 1, 2, 3, 4, 5
      const keyMap: Record<string, string> = {
        'A': 'A', '1': 'A',
        'B': 'B', '2': 'B',
        'C': 'C', '3': 'C',
        'D': 'D', '4': 'D',
        'E': 'E', '5': 'E'
      };

      if (keyMap[keyUpper]) {
        const targetOptKey = keyMap[keyUpper];
        const exists = q.options.some(opt => opt.key.toUpperCase() === targetOptKey);
        if (exists) {
          e.preventDefault();
          selectOption(q.id, targetOptKey);
          return;
        }
      }

      // 2. Navigation: ArrowRight / N, ArrowLeft / P
      if (e.key === 'ArrowRight' || e.key === 'n' || e.key === 'N') {
        e.preventDefault();
        if (currentIndex < questions.length - 1) {
          renderQuestion(currentIndex + 1);
        }
        return;
      }

      if (e.key === 'ArrowLeft' || e.key === 'p' || e.key === 'P') {
        e.preventDefault();
        if (currentIndex > 0) {
          renderQuestion(currentIndex - 1);
        }
        return;
      }

      // 3. Doubtful: R
      if (e.key === 'r' || e.key === 'R') {
        e.preventDefault();
        if (btnDoubtful) btnDoubtful.click();
        return;
      }

      // 4. Clear Choice: Delete, Backspace, or X
      if (e.key === 'Delete' || e.key === 'Backspace' || e.key === 'x' || e.key === 'X') {
        if (answers[q.id]) {
          e.preventDefault();
          clearOption(q.id);
          return;
        }
      }
    });

    // Finish Confirmation Modal
    function openFinishModal(isAllAnsweredNotice = false) {
      updateCounts();

      const totalQ = questions.length;
      const filledCount = questions.filter(q => answers[q.id] != null && answers[q.id] !== '').length;
      const isAllFilled = totalQ > 0 && filledCount === totalQ;

      if (isAllAnsweredNotice || isAllFilled) {
        if (confirmModalBadge) {
          confirmModalBadge.style.display = 'inline-flex';
          confirmModalBadge.innerHTML = '<span class="badge-dot"></span> SEMUA SOAL TERISI';
        }
        if (confirmModalTitle) {
          confirmModalTitle.textContent = '🎉 Semua Soal Telah Terisi!';
        }
        if (confirmModalSubtitle) {
          confirmModalSubtitle.textContent = `Hebat! Anda telah mengisi seluruh ${totalQ} butir soal. Anda dapat mengakhiri ujian sekarang atau menekan tombol Batal untuk memeriksa kembali seluruh jawaban.`;
        }
        if (btnCancelFinish) {
          btnCancelFinish.textContent = '← Batal / Periksa Kembali';
        }
      } else {
        if (confirmModalBadge) {
          confirmModalBadge.style.display = 'none';
        }
        if (confirmModalTitle) {
          confirmModalTitle.textContent = 'Konfirmasi Selesai Ujian';
        }
        if (confirmModalSubtitle) {
          confirmModalSubtitle.textContent = 'Apakah Anda yakin ingin mengakhiri simulasi ujian ini? Nilai akan segera dihitung secara otoritatif oleh server.';
        }
        if (btnCancelFinish) {
          btnCancelFinish.textContent = '← Batal (Kembali Mengerjakan)';
        }
      }

      if (confirmModal) confirmModal.style.display = 'flex';
    }

    function closeFinishModal() {
      if (confirmModal) confirmModal.style.display = 'none';
    }

    if (btnFinishTrigger) {
      btnFinishTrigger.addEventListener('click', () => openFinishModal(false));
    }

    if (btnCancelFinish) {
      btnCancelFinish.addEventListener('click', closeFinishModal);
    }

    if (btnCloseConfirmModal) {
      btnCloseConfirmModal.addEventListener('click', closeFinishModal);
    }

    // Close when clicking outside modal box
    if (confirmModal) {
      confirmModal.addEventListener('click', (e) => {
        if (e.target === confirmModal) {
          closeFinishModal();
        }
      });
    }

    if (btnConfirmFinish) {
      btnConfirmFinish.addEventListener('click', () => {
        closeFinishModal();
        finishExam(false);
      });
    }

    // Server-Side Grading Execution
    async function finishExam(isAutoSubmit = false) {
      isExamActive = false;
      if (timerInterval) clearInterval(timerInterval);
      if (heartbeatInterval) clearInterval(heartbeatInterval);

      setSaveStatus('saving', 'Menghitung nilai di server...');

      try {
        const resp = await fetch('/api/exam/finish', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ attemptUuid, userId, isAutoSubmit })
        });
        const res = await resp.json();

        if (!res.success) {
          alert('Gagal menghitung nilai ujian: ' + (res.error || 'Server error'));
          return;
        }

        const graded = res.data;
        displayScorecard(graded);
      } catch (err: any) {
        alert('Terjadi kesalahan saat memproses hasil ujian.');
      }
    }

    // Display Scorecard
    function displayScorecard(graded: any) {
      if (!resultModal) return;

      const rScore = document.getElementById('result-total-score');
      const rStatus = document.getElementById('result-pass-status');
      const rBadge = document.getElementById('result-status-badge');
      const rSubContainer = document.getElementById('result-subtests-container');
      const recList = document.getElementById('recommendations-list');
      const viewExpBtn = document.getElementById('btn-view-explanation') as HTMLAnchorElement;

      if (rScore) rScore.textContent = String(graded.totalScore);

      if (rStatus && rBadge) {
        if (graded.isPassed) {
          rStatus.textContent = 'MEMENUHI PASSING GRADE';
          rStatus.className = 'rsh-status text-pass';
          rBadge.innerHTML = '<span class="badge badge-cpns" style="background: #10b981; color: white; padding: 6px 14px; font-weight: 700;">✓ LULUS AMBANG BATAS</span>';
        } else {
          rStatus.textContent = 'BELUM MEMENUHI';
          rStatus.className = 'rsh-status text-fail';
          rBadge.innerHTML = '<span class="badge badge-cpns" style="background: #ef4444; color: white; padding: 6px 14px; font-weight: 700;">✗ BELUM MEMENUHI AMBANG BATAS</span>';
        }
      }

      // Subtests progress bars
      if (rSubContainer && graded.subtestScores) {
        rSubContainer.innerHTML = '';
        for (const [key, sub] of Object.entries<any>(graded.subtestScores)) {
          const pct = sub.maxScore > 0 ? Math.min(100, Math.round((sub.score / sub.maxScore) * 100)) : 0;
          const card = document.createElement('div');
          card.className = `subtest-report-card ${sub.isPassed ? 'passed' : 'failed'}`;
          card.innerHTML = `
            <div class="subtest-report-header">
              <span class="subtest-report-title">${sub.name} (Passing Grade: ${sub.passingGrade})</span>
              <span class="subtest-report-score ${sub.isPassed ? 'text-pass' : 'text-fail'}">
                Skor: ${sub.score} / ${sub.maxScore} (${sub.isPassed ? 'MEMENUHI' : 'BELUM'})
              </span>
            </div>
            <div class="subtest-progress-track">
              <div class="subtest-progress-fill ${sub.isPassed ? 'fill-pass' : 'fill-fail'}" style="width: ${pct}%;"></div>
            </div>
          `;
          rSubContainer.appendChild(card);
        }
      }

      // Recommendations
      if (recList && graded.recommendations) {
        recList.innerHTML = '';
        graded.recommendations.forEach((rec: string) => {
          const li = document.createElement('li');
          li.textContent = rec;
          recList.appendChild(li);
        });
      }

      // Explanation link
      if (viewExpBtn) {
        viewExpBtn.href = `/pembahasan/${packageSlug}?attempt=${attemptUuid}`;
      }

      resultModal.style.display = 'flex';
    }

    if (btnRetryExam) {
      btnRetryExam.addEventListener('click', () => {
        isExamActive = false;
        window.location.reload();
      });
    }

    // Font Sizing with Persistence
    const btnFontSm = document.getElementById('btn-font-sm');
    const btnFontMd = document.getElementById('btn-font-md');
    const btnFontLg = document.getElementById('btn-font-lg');
    const bodyArea = document.getElementById('exam-body-area');

    function applyFontSize(size: 'font-sm' | 'font-md' | 'font-lg') {
      if (bodyArea) bodyArea.className = 'exam-body ' + size;
      localStorage.setItem('simcat_exam_font_size', size);
      btnFontSm?.classList.toggle('active', size === 'font-sm');
      btnFontMd?.classList.toggle('active', size === 'font-md');
      btnFontLg?.classList.toggle('active', size === 'font-lg');
    }

    const savedSize = (localStorage.getItem('simcat_exam_font_size') as any) || 'font-md';
    applyFontSize(savedSize);

    btnFontSm?.addEventListener('click', () => applyFontSize('font-sm'));
    btnFontMd?.addEventListener('click', () => applyFontSize('font-md'));
    btnFontLg?.addEventListener('click', () => applyFontSize('font-lg'));
  })();
</script>

