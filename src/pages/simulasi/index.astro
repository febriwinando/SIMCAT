---
import Layout from '../../layouts/Layout.astro';
import { queryAll } from '../../db';

const packages = queryAll(`
  SELECT 
    p.*,
    c.name as category_name,
    c.icon as category_icon,
    sr.name as scoring_rule_name
  FROM exam_packages p
  JOIN exam_categories c ON p.category_id = c.id
  JOIN scoring_rules sr ON p.scoring_rule_id = sr.id
  WHERE p.status = 'published'
  ORDER BY p.id ASC
`);

const categories = queryAll(`SELECT id, name, icon FROM exam_categories WHERE is_active = 1 ORDER BY sort_order ASC`);
---

<Layout title="Katalog Simulasi Ujian CAT - SIMCAT 2026">
  <div class="simulasi-page-wrapper">
    <div class="container">
      <div class="page-header text-center">
        <div class="bkn-badge-pill">
          <span class="badge-dot pulse-dot-green"></span>
          PORTAL SIMULASI UJIAN BERBASIS KOMPUTER
        </div>
        <h1 class="page-title">Katalog Tryout & Simulasi CAT</h1>
        <p class="page-subtitle">
          Pilih paket simulasi sesuai target seleksi Anda. Seluruh paket terintegrasi server-authoritative timer, penilaian ambang batas resmi, dan pembahasan tuntas.
        </p>
      </div>

      <!-- Filter Bar -->
      <div class="filter-bar cyber-card glass-panel">
        <div class="category-filters">
          <button class="filter-btn active font-mono" data-filter="all">Semua Kategori</button>
          {categories.map((c) => (
            <button class="filter-btn font-mono" data-filter={c.id}>
              {c.icon} {c.name.split(' ')[0]}
            </button>
          ))}
        </div>
      </div>

      <!-- Packages Grid -->
      <div class="packages-grid" id="packages-grid">
        {packages.map((pkg) => {
          let catNeon = '#00f2fe';
          if (pkg.category_id === 'pppk') catNeon = '#00f5a0';
          else if (pkg.category_id === 'bumn') catNeon = '#ffb703';
          else if (pkg.category_id === 'sekolah-kedinasan') catNeon = '#ff0055';

          return (
            <div class="pkg-card cyber-card glass-panel" data-cat={pkg.category_id} style={`--pkg-neon: ${catNeon};`}>
              <div class="pkg-header">
                <span class="pkg-icon">{pkg.category_icon}</span>
                <div class="pkg-badges">
                  <span class="badge badge-cpns font-mono">{pkg.category_name}</span>
                  <span class="badge badge-pppk font-mono">{pkg.is_free ? 'GRATIS' : 'PREMIUM'}</span>
                </div>
              </div>

              <h3 class="pkg-title">{pkg.title}</h3>
              <p class="pkg-desc">{pkg.description}</p>

              <div class="pkg-stats">
                <div class="stat-col">
                  <span class="stat-label font-mono">WAKTU</span>
                  <span class="stat-value font-mono">{pkg.duration_minutes} Mnt</span>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-col">
                  <span class="stat-label font-mono">JUMLAH SOAL</span>
                  <span class="stat-value font-mono">{pkg.total_questions} Butir</span>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-col">
                  <span class="stat-label font-mono">SKOR MAX</span>
                  <span class="stat-value font-mono">550</span>
                </div>
              </div>

              <div class="pkg-footer">
                <a href={`/simulasi/${pkg.slug}`} class="btn btn-primary btn-block">
                  Mulai Simulasi CAT →
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.pkg-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (typeof window.playCyberSound === 'function') {
        window.playCyberSound('click');
      }
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.getAttribute('data-filter');

      cards.forEach((card) => {
        if (filter === 'all' || card.getAttribute('data-cat') === filter) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .simulasi-page-wrapper {
    padding: 60px 0 90px;
  }

  .text-center {
    text-align: center;
  }

  .page-header {
    max-width: 800px;
    margin: 0 auto 40px;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: #ffffff;
    margin: 14px 0 16px;
    letter-spacing: -0.01em;
  }

  .page-subtitle {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .filter-bar {
    padding: 16px 24px;
    border-radius: var(--radius-full);
    margin-bottom: 40px;
    display: flex;
    justify-content: center;
    background: rgba(10, 15, 29, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .category-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .filter-btn {
    padding: 9px 20px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-muted);
    border-radius: var(--radius-full);
    font-size: 0.84rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .filter-btn:hover {
    background: rgba(30, 41, 59, 0.8);
    color: #ffffff;
    border-color: rgba(0, 242, 254, 0.35);
    transform: translateY(-2px);
  }

  .filter-btn.active {
    background: linear-gradient(135deg, #00f2fe 0%, #0072ff 100%);
    border-color: transparent;
    color: #ffffff;
    box-shadow: 0 0 20px rgba(0, 242, 254, 0.4);
    transform: translateY(-2px);
  }

  .packages-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 28px;
  }

  .pkg-card {
    display: flex;
    flex-direction: column;
    padding: 32px 28px;
    border-radius: var(--radius-md);
    background: rgba(10, 15, 29, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .pkg-card:hover {
    transform: translateY(-6px);
    border-color: var(--pkg-neon);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6), 0 0 25px rgba(0, 242, 254, 0.15);
  }

  .pkg-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
  }

  .pkg-icon {
    font-size: 2.4rem;
  }

  .pkg-badges {
    display: flex;
    gap: 8px;
  }

  .pkg-title {
    font-size: 1.3rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 10px;
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .pkg-card:hover .pkg-title {
    color: var(--pkg-neon);
  }

  .pkg-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 22px;
    flex: 1;
  }

  .pkg-stats {
    display: flex;
    justify-content: space-around;
    align-items: center;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 14px;
    margin-bottom: 24px;
  }

  .stat-col {
    text-align: center;
  }

  .stat-label {
    font-size: 0.65rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 2px;
  }

  .stat-value {
    font-weight: 800;
    font-size: 1.05rem;
    color: #ffffff;
  }

  .stat-divider {
    width: 1px;
    height: 26px;
    background: rgba(255, 255, 255, 0.08);
  }

  .btn-block {
    width: 100%;
    text-align: center;
    justify-content: center;
  }
</style>
